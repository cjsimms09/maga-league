<%- include('partials/header', { title: 'Voting Booth' }) %>

<h1 class="page-title">The Voting Booth</h1>
<p class="page-sub">Democracy in action. <b><%= threshold %> YES votes</b> of <%= electorate %> owners passes a rule change.</p>

<% if (proposed) { %><div class="flash-note" style="max-width:640px;margin:0 auto 1rem">Your measure is on the ballot. Now go campaign for it.</div><% } %>

<div class="card" style="margin-bottom:1.4rem">
  <h2>📜 Propose a Rule Change <span class="sub">any owner can put a measure on the ballot</span></h2>
  <div class="body">
    <form method="post" action="/votes/propose">
      <div class="inline-form">
        <div style="flex:2 1 260px">
          <label class="field">The measure (a yes/no question)</label>
          <input type="text" name="question" required maxlength="200" placeholder="e.g. Ban trading with your own brother?">
        </div>
        <div style="flex:2 1 260px">
          <label class="field">Make your case (optional)</label>
          <input type="text" name="description" maxlength="1000" placeholder="Why the league needs this">
        </div>
        <div class="fit"><button class="btn" type="submit">Put It on the Ballot</button></div>
      </div>
    </form>
  </div>
</div>

<h2 style="color:var(--navy); text-transform:uppercase; letter-spacing:.1em; font-size:1rem">🗳 On the Ballot</h2>
<% if (!open.length) { %>
  <div class="card"><div class="body"><p class="muted" style="margin:0">Nothing on the ballot. The republic rests.</p></div></div>
<% } %>
<% for (const v of open) { %>
<div class="card vote-card" id="vote-<%= v.id %>">
  <h2><%= v.question %> <span class="badge open">Open</span></h2>
  <div class="body">
    <p class="pass-note" style="margin:0 0 .4rem">Proposed by <b><%= v.proposer_name %></b></p>
    <% if (v.description) { %><p style="margin-top:0"><%= v.description %></p><% } %>
    <div class="tally-bar" title="<%= v.yes %> yes / <%= v.no %> no">
      <% const tot = Math.max(v.cast, 1); %>
      <div class="yes" style="width:<%= (v.yes / tot) * 100 %>%"><%= v.yes ? 'YES ' + v.yes : '' %></div>
      <div class="no" style="width:<%= (v.no / tot) * 100 %>%"><%= v.no ? 'NO ' + v.no : '' %></div>
    </div>
    <p class="pass-note"><%= v.cast %> of <%= electorate %> votes in — needs <%= threshold %> YES to pass<%= v.passed ? ' — ✅ currently passing' : '' %></p>
    <%# THE ROLL CALL (Cory, 2026-08-16: "see how everyone voted for everyone").
        Open ballots were always server-known and never secret by design — the
        tally bar printed the counts; this prints the names behind them, plus
        the holdouts, which is what actually gets a measure over the line. %>
    <div class="roll-call" style="font-size:.78rem; margin:.2rem 0 .5rem; line-height:1.5">
      <div><b style="color:var(--green)">YES (<%= v.yes %>):</b>
        <%= v.ballots.filter(b => b.choice === 'yes').map(b => b.name).sort().join(', ') || '—' %></div>
      <div><b style="color:var(--red, #b91c1c)">NO (<%= v.no %>):</b>
        <%= v.ballots.filter(b => b.choice === 'no').map(b => b.name).sort().join(', ') || '—' %></div>
      <% if (v.not_voted && v.not_voted.length) { %>
        <div class="muted">Yet to vote (<%= v.not_voted.length %>): <%= v.not_voted.join(', ') %></div>
      <% } %>
    </div>
    <div class="vote-actions">
      <form class="asis" method="post" action="/votes/<%= v.id %>/ballot">
        <input type="hidden" name="choice" value="yes">
        <button class="btn <%= v.myChoice === 'yes' ? '' : 'ghost' %>" style="<%= v.myChoice === 'yes' ? 'background:var(--green);box-shadow:none' : 'color:var(--green);border-color:var(--green)' %>" type="submit">✓ Vote Yes</button>
      </form>
      <form class="asis" method="post" action="/votes/<%= v.id %>/ballot">
        <input type="hidden" name="choice" value="no">
        <button class="btn <%= v.myChoice === 'no' ? '' : 'ghost' %>" type="submit">✗ Vote No</button>
      </form>
      <% if (v.myChoice) { %>
        <span class="muted">You voted <b><%= v.myChoice.toUpperCase() %></b> — change it above, or</span>
        <form class="asis" method="post" action="/votes/<%= v.id %>/rescind">
          <button class="btn small ghost" type="submit" title="Withdraw your ballot — back to not-voted">↩ Withdraw my vote</button>
        </form>
      <% } %>
    </div>
    <details class="ledger-history" <%= v.comments.length ? '' : '' %>>
      <summary>💬 <%= v.comments.length %> comment<%= v.comments.length === 1 ? '' : 's' %> — talk your talk</summary>
      <div style="padding:.7rem 1rem">
        <% for (const c of v.comments) { %>
          <p style="margin:.35rem 0"><b style="color:var(--gold-bright)"><%= c.name %></b>
            <span class="muted" style="font-size:.7rem"><%= (c.created_at || '').slice(0, 10) %></span><br><%= c.text %></p>
        <% } %>
        <% if (!v.comments.length) { %><p class="muted" style="margin:.3rem 0">No takes yet. Cowards.</p><% } %>
        <form method="post" action="/votes/<%= v.id %>/comment" class="inline-form" style="margin-top:.5rem">
          <div><input type="text" name="text" maxlength="500" required placeholder="State your case, patriot"></div>
          <div class="fit"><button class="btn small navy" type="submit">Post</button></div>
        </form>
      </div>
    </details>
  </div>
</div>
<% } %>

<% if (closed.length) { %>
<h2 style="color:var(--navy); text-transform:uppercase; letter-spacing:.1em; font-size:1rem; margin-top:2rem">📜 Past Measures</h2>
<% for (const v of closed) { %>
<div class="card vote-card" id="vote-<%= v.id %>">
  <h2><%= v.question %> <span class="badge <%= v.passed ? 'open' : 'closed' %>"><%= v.passed ? 'PASSED' : 'FAILED' %></span></h2>
  <div class="body">
    <p class="pass-note" style="margin:0 0 .4rem">Proposed by <b><%= v.proposer_name %></b></p>
    <% if (v.description) { %><p style="margin-top:0"><%= v.description %></p><% } %>
    <div class="tally-bar" title="<%= v.yes %> yes / <%= v.no %> no">
      <% const tot = Math.max(v.cast, 1); %>
      <div class="yes" style="width:<%= (v.yes / tot) * 100 %>%"><%= v.yes ? 'YES ' + v.yes : '' %></div>
      <div class="no" style="width:<%= (v.no / tot) * 100 %>%"><%= v.no ? 'NO ' + v.no : '' %></div>
    </div>
    <p class="pass-note">Final: <%= v.yes %> yes, <%= v.no %> no — <%= v.passed ? `passed with ${threshold}+ yes votes` : `did not reach ${threshold} yes votes` %></p>
    <%# The roll call stays on the record after the vote closes — that is the
        point of a record. Abstainers are named as such, not "yet to vote":
        this measure is done and they sat it out. %>
    <div class="roll-call" style="font-size:.78rem; margin:.2rem 0 .5rem; line-height:1.5">
      <div><b style="color:var(--green)">YES (<%= v.yes %>):</b>
        <%= v.ballots.filter(b => b.choice === 'yes').map(b => b.name).sort().join(', ') || '—' %></div>
      <div><b style="color:var(--red, #b91c1c)">NO (<%= v.no %>):</b>
        <%= v.ballots.filter(b => b.choice === 'no').map(b => b.name).sort().join(', ') || '—' %></div>
      <% if (v.not_voted && v.not_voted.length) { %>
        <div class="muted">Abstained (<%= v.not_voted.length %>): <%= v.not_voted.join(', ') %></div>
      <% } %>
    </div>
    <details class="ledger-history" <%= v.comments.length ? '' : '' %>>
      <summary>💬 <%= v.comments.length %> comment<%= v.comments.length === 1 ? '' : 's' %> — talk your talk</summary>
      <div style="padding:.7rem 1rem">
        <% for (const c of v.comments) { %>
          <p style="margin:.35rem 0"><b style="color:var(--gold-bright)"><%= c.name %></b>
            <span class="muted" style="font-size:.7rem"><%= (c.created_at || '').slice(0, 10) %></span><br><%= c.text %></p>
        <% } %>
        <% if (!v.comments.length) { %><p class="muted" style="margin:.3rem 0">No takes yet. Cowards.</p><% } %>
        <form method="post" action="/votes/<%= v.id %>/comment" class="inline-form" style="margin-top:.5rem">
          <div><input type="text" name="text" maxlength="500" required placeholder="State your case, patriot"></div>
          <div class="fit"><button class="btn small navy" type="submit">Post</button></div>
        </form>
      </div>
    </details>
  </div>
</div>
<% } %>
<% } %>

<div id="punishments" style="margin-top:2.2rem">
  <h2 style="color:var(--navy); text-transform:uppercase; letter-spacing:.1em; font-size:1rem; text-align:center">☠️ Last-Place Punishment Wall</h2>
  <p class="page-sub">Pitch a punishment for whoever finishes last. One vote each — change it as often as you like, until it locks at the start of the season.</p>

  <% if (punishmentsLocked) { %>
    <div class="turn-banner" style="max-width:680px; margin:0 auto 1rem">
      🔒 <b>LOCKED.</b> The people have spoken<% const winner = punishments.find(pn => pn.leading); %><% if (winner) { %>:
      <b>"<%= winner.text %>"</b> awaits whoever finishes last.<% } %>
    </div>
  <% } else { %>
  <div class="card" style="max-width:680px; margin:0 auto 1rem">
    <h2>Pitch a Punishment</h2>
    <div class="body">
      <form method="post" action="/punishments" class="inline-form">
        <div><input type="text" name="text" maxlength="300" required placeholder="e.g. Last place takes the SAT and posts the score"></div>
        <div class="fit"><button class="btn" type="submit">Add to the Wall</button></div>
      </form>
    </div>
  </div>
  <% } %>

  <div class="card" style="max-width:680px; margin:0 auto">
    <h2>The Ballot <span class="sub"><%= punishments.length %> idea<%= punishments.length === 1 ? '' : 's' %></span>
      <% if (owner.is_commissioner) { %>
        <form class="asis" method="post" action="/admin/punishments-lock">
          <button class="btn small <%= punishmentsLocked ? 'gold' : 'navy' %>"><%= punishmentsLocked ? '🔓 Unlock' : '🔒 Lock for the season' %></button>
        </form>
      <% } %>
    </h2>
    <div class="body tight">
      <% if (!punishments.length) { %>
        <p class="muted" style="padding:1rem; margin:0">No ideas yet. Surely someone deserves to suffer.</p>
      <% } %>
      <table class="roll">
        <% for (const pn of punishments) { %>
          <tr class="<%= pn.leading && punishments.length > 1 ? '' : '' %>">
            <td>
              <%= pn.leading && pn.votes > 0 ? '👑 ' : '' %><b><%= pn.text %></b>
              <div class="muted" style="font-size:.72rem">by <%= pn.proposer_name %></div>
              <% if (pn.voter_names && pn.voter_names.length) { %>
                <div class="muted" style="font-size:.72rem">backed by: <%= pn.voter_names.join(', ') %></div>
              <% } %>
            </td>
            <td class="num" style="white-space:nowrap"><b><%= pn.votes %></b> vote<%= pn.votes === 1 ? '' : 's' %></td>
            <td class="num" style="white-space:nowrap">
              <% if (!punishmentsLocked) { %>
                <form class="asis" method="post" action="/punishments/<%= pn.id %>/vote">
                  <button class="btn small <%= pn.myPick ? 'gold' : 'navy' %>"><%= pn.myPick ? '✓ Your pick' : 'Vote' %></button>
                </form>
                <% if (pn.myPick) { %>
                  <form class="asis" method="post" action="/punishments/rescind">
                    <button class="btn small ghost" type="submit" title="Withdraw your punishment vote">↩</button>
                  </form>
                <% } %>
              <% } else if (pn.myPick) { %><span class="badge gold">your pick</span><% } %>
              <% if (owner.is_commissioner) { %>
                <form class="asis" method="post" action="/admin/punishments/<%= pn.id %>/delete" onsubmit="return confirm('Delete this idea?')"><button class="btn small ghost">✕</button></form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
