<%- include('partials/header', { title: (viewOwner.name === owner.name ? 'My Team' : viewOwner.name + "'s Team") }) %>
<%
  const mine = viewOwner.id === owner.id;
  const fmtLock = d => {
    if (!d) return '';
    // Always New York — the NFL kicks off on Eastern time and half this league
    // is not in it, so "8:15pm" with no zone is a trap.
    return new Date(d).toLocaleString('en-US', { timeZone: 'America/New_York',
      weekday: 'short', hour: 'numeric', minute: '2-digit' }) + ' ET';
  };
%>

<h1 class="page-title"><%= mine ? '🏈 My Team' : `🔎 ${viewOwner.name}'s Team` %><%- include('partials/_owner_badges', { name: viewOwner.name }) %></h1>

<%# Two tabs, because these answer different questions. "This week" is who
    you're playing and what's riding on it; "Roster" is who you own. The week
    tab renders whatever Sleeper's state — it used to live inside the roster's
    guard, so the moment Sleeper was unreachable or the season hadn't started
    the whole matchup section silently vanished. A feature that disappears
    exactly when you go looking for it is worse than one that isn't built. %>
<%# Both links carry their section explicitly. The Roster link used to omit it
    and rely on the default, so clicking it just re-rendered This Week — the tab
    looked broken because it was. %>
<nav class="section-tabs">
  <a href="/team?owner=<%= viewOwner.id %>&section=roster" class="<%= section === 'roster' ? 'active' : '' %>">
    <b>🏈 Roster</b><span>who you own, and how they're doing</span>
  </a>
  <a href="/team?owner=<%= viewOwner.id %>&section=week" class="<%= section === 'week' ? 'active' : '' %>">
    <b>⚔️ This Week</b><span>your matchup and what's on it</span>
  </a>
</nav>

<form method="get" action="/team" class="inline-form" style="justify-content:center; margin-bottom:1.2rem">
  <input type="hidden" name="section" value="<%= section %>">
  <div class="fit">
    <label class="field">Viewing</label>
    <select name="owner" onchange="this.form.submit()">
      <% for (const o of owners) { %>
        <option value="<%= o.id %>" <%= o.id === viewOwner.id ? 'selected' : '' %>><%= o.name %><%= o.id === owner.id ? ' (you)' : '' %></option>
      <% } %>
    </select>
  </div>
</form>

<% if (section === 'week') { %>
<%
  const fmtLock = d => {
    if (!d) return '';
    // Always New York — the NFL kicks off on Eastern time and half this league
    // is not in it, so "8:15pm" with no zone is a trap.
    return new Date(d).toLocaleString('en-US', { timeZone: 'America/New_York',
      weekday: 'short', hour: 'numeric', minute: '2-digit' }) + ' ET';
  };
%>

<% if (late) { %>
  <div class="alert-banner alert-warning" style="margin-bottom:1rem">
    <span class="tag">⏰</span><span>Too late — that game has already started, so the bet
    could not be accepted. Nobody's money moved.</span>
  </div>
<% } %>

<%# ── Bets your opponent has put in front of you ──────────────────────────── %>
<% if (matchupPending && matchupPending.length) { %>
  <div class="card" style="margin-bottom:1.2rem; border-color:rgba(245,196,69,.6)">
    <h2>🤝 Waiting on You <span class="sub">accept before kickoff or it's void</span></h2>
    <div class="body">
      <% for (const b of matchupPending) { %>
        <div class="sb-row pending">
          <div class="sb-main">
            <div class="sb-terms"><%= b.terms %></div>
            <div class="sb-meta"><b><%= money(b.stake) %></b> each ·
              <% if (betWindow.open) { %>closes <%= fmtLock(betWindow.locks_at) %>
              <% } else { %><span class="sb-wait">closed — <%= betWindow.reason %></span><% } %>
            </div>
          </div>
          <div class="sb-actions">
            <% if (betWindow.open) { %>
              <form class="asis" method="post" action="/sidebets/<%= b.id %>/accept">
                <input type="hidden" name="back" value="team">
                <button class="btn small gold" type="submit">Accept</button>
              </form>
            <% } %>
            <form class="asis" method="post" action="/sidebets/<%= b.id %>/decline">
              <button class="btn small ghost" type="submit">Decline</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
<% } %>

<%# ── What other people have riding on you ────────────────────────────────── %>
<% if (aboutMe && aboutMe.length) { %>
  <div class="card about-me" style="margin-bottom:1.2rem">
    <h2>👀 People Have Money On You <span class="sub">bets you're not in — now you know</span></h2>
    <div class="body">
      <% for (const r of aboutMe) { %>
        <div class="am-row">
          <div class="am-terms"><%= r.bet.terms %></div>
          <div class="am-sides">
            <% if (r.backing.length) { %><span class="am-for">👍 <b><%= r.backing.join(', ') %></b> on you</span><% } %>
            <% if (r.against.length) { %><span class="am-vs">👎 <b><%= r.against.join(', ') %></b> against you</span><% } %>
            <span class="muted"><%= money(r.stake) %> each</span>
          </div>
        </div>
      <% } %>
    </div>
  </div>
<% } %>

<%# ── This week's game ──────────────────────────────────────────────────────
    Top of the page because it is the thing you came to look at, and because a
    matchup is where a side bet actually gets made — in the group chat on
    Thursday, not on a finance page. So the bet lives here, prefilled. %>
<% if (matchup && matchup.opp && matchup.opp.owner && viewOwner.id === owner.id) { %>
<div class="card matchup-card" style="margin-bottom:1.3rem">
  <h2>⚔️ Week <%= matchup.week %> <span class="sub">your game this week</span></h2>
  <div class="body">
    <div class="mu">
      <div class="mu-side <%= matchup.me.points > matchup.opp.points ? 'up' : '' %>">
        <span class="mu-team"><%= matchup.me.team %></span>
        <span class="mu-pts"><%= matchup.me.points.toFixed(2) %></span>
        <span class="mu-who">you</span>
      </div>
      <div class="mu-vs">vs</div>
      <div class="mu-side <%= matchup.opp.points > matchup.me.points ? 'up' : '' %>">
        <span class="mu-team"><%= matchup.opp.team %></span>
        <span class="mu-pts"><%= matchup.opp.points.toFixed(2) %></span>
        <span class="mu-who"><%= matchup.opp.owner.name %><%- include('partials/_owner_badges', { name: matchup.opp.owner.name }) %></span>
      </div>
    </div>

    <% if (!betWindow.open) { %>
      <p class="mu-closed">🔒 <%= betWindow.reason %> Bets on week <%= matchup.week %> are closed.</p>
    <% } else { %>
    <details class="mu-bet">
      <summary>🤝 Bet <%= matchup.opp.owner.name %> on it</summary>
      <div class="mu-bet-body">
        <form method="post" action="/sidebets" class="inline-form">
          <input type="hidden" name="format" value="prop">
          <input type="hidden" name="kind" value="matchup">
          <input type="hidden" name="party" value="<%= matchup.opp.owner.id %>">
          <input type="hidden" name="resolves" value="end of week <%= matchup.week %>">
          <%# The condition the builder would have produced, prefilled. Same
              field names, same parser — a shortcut into the same machinery,
              not a second way of making a bet. %>
          <input type="hidden" name="cond_test" value="outscores">
          <input type="hidden" name="cond_subject" value="<%= owner.id %>">
          <input type="hidden" name="cond_target_owner" value="<%= matchup.opp.owner.id %>">
          <input type="hidden" name="cond_when" value="week">
          <input type="hidden" name="cond_week" value="<%= matchup.week %>">
          <input type="hidden" name="logic" value="all">
          <div class="fit">
            <label class="field">Wager each
              <input type="number" name="stake" step="1" min="1" placeholder="20" required style="width:6.5rem">
            </label>
          </div>
          <div class="fit"><button class="btn gold" type="submit">Send it to <%= matchup.opp.owner.name %></button></div>
        </form>
        <p class="muted" style="margin:.5rem 0 0; font-size:.78rem">
          Straight up: <b>your team outscores <%= matchup.opp.owner.name %> in week <%= matchup.week %></b>,
          settled when the week ends. They have to accept, and
          <b>acceptance closes <%= fmtLock(betWindow.locks_at) %></b> — once football
          starts nobody can take it. The site grades it and tells you both who won.
        </p>
      </div>
    </details>
    <% } %>
  </div>
</div>
<% } %>


<%# Nothing from Sleeper? Say why, and still let them make the bet. A missing
    scoreboard is no reason to be unable to bet your opponent. %>
<% if (mine && (!matchup || !matchup.opp || !matchup.opp.owner)) { %>
  <div class="card matchup-card" style="margin-bottom:1.3rem">
    <h2>⚔️ Week <%= weekNo %> <span class="sub">no scoreboard yet</span></h2>
    <div class="body">
      <p class="muted" style="margin:0 0 .8rem">
        <% if (!configured) { %>Sleeper isn't connected yet (Commish → Sleeper), so there's no matchup to show.
        <% } else if (!matchup) { %>Sleeper hasn't got a matchup for you yet — either the season hasn't started or your team isn't mapped (Commish → Sleeper → Team Mapping).
        <% } else { %>You don't have an opponent this week.<% } %>
        You can still put a bet up.
      </p>
      <details class="mu-bet">
        <summary>🤝 Bet somebody on week <%= weekNo %></summary>
        <div class="mu-bet-body">
          <form method="post" action="/sidebets" class="entry-form">
            <input type="hidden" name="format" value="prop">
            <input type="hidden" name="kind" value="matchup">
            <input type="hidden" name="cond_test" value="outscores">
            <input type="hidden" name="cond_subject" value="<%= owner.id %>">
            <input type="hidden" name="cond_when" value="week">
            <input type="hidden" name="cond_week" value="<%= weekNo %>">
            <input type="hidden" name="logic" value="all">
            <input type="hidden" name="resolves" value="end of week <%= weekNo %>">
            <div class="ef-row">
              <label class="field" style="flex:1 1 160px">Who are you betting
                <select name="party" id="mu-opp" required onchange="document.getElementById('mu-target').value=this.value">
                  <option value="">Pick someone…</option>
                  <% for (const o of owners) { if (o.id === owner.id) continue; %>
                    <option value="<%= o.id %>"><%= o.name %></option>
                  <% } %>
                </select>
              </label>
              <label class="field" style="flex:1 1 120px">Wager each
                <input type="number" name="stake" step="1" min="1" placeholder="20" required>
              </label>
            </div>
            <input type="hidden" name="cond_target_owner" id="mu-target" value="">
            <div class="ef-row" style="justify-content:flex-end">
              <div class="fit"><button class="btn gold" type="submit">Send it</button></div>
            </div>
            <p class="muted" style="margin:.2rem 0 0; font-size:.78rem">
              Your team outscores theirs in week <%= weekNo %>, settled when the week ends.
              <b>Has to be accepted before kickoff</b> — <%= fmtLock(betWindow.locks_at) %>.
            </p>
          </form>
        </div>
      </details>
    </div>
  </div>
<% } %>

<% } else { %>

<p class="page-sub">Live roster from Sleeper with recent production. Scout your rivals. Judge their benches.</p>

<% if (!configured) { %>
  <div class="card"><div class="body"><p class="muted" style="margin:0">Sleeper isn't connected yet (Commish → Sleeper).</p></div></div>
<% } else if (!roster) { %>
  <div class="card"><div class="body"><p class="muted" style="margin:0">
    Couldn't load this roster — either <%= viewOwner.name %> isn't mapped to a Sleeper team yet (Commish → Sleeper → Team Mapping)
    or Sleeper is unreachable right now.
  </p></div></div>
<% } else { %>

<div class="hero" style="margin-bottom:1.3rem">
  <div class="hero-item">
    <span class="hero-label">Team</span>
    <span class="hero-value" style="font-size:1.05rem"><%= roster.team %></span>
    <span class="hero-sub"><%= viewOwner.name %></span>
  </div>
  <div class="hero-item">
    <span class="hero-label">Record</span>
    <span class="hero-value"><%= roster.record || '—' %></span>
    <span class="hero-sub">this season</span>
  </div>
  <div class="hero-item">
    <span class="hero-label">Roster Size</span>
    <span class="hero-value"><%= roster.rows.length %></span>
    <span class="hero-sub"><%= roster.rows.filter(r => r.starter).length %> starters</span>
  </div>
</div>

<div class="card">
  <h2>Roster <span class="sub">points are half-PPR · Wk <%= roster.lastWeek %> = most recent completed week</span></h2>
  <div class="body tight scroll-x">
    <table class="roll">
      <tr><th></th><th>Player</th><th>Pos</th><th>Team</th><th class="num">Wk <%= roster.lastWeek %></th><th class="num">Season</th><th>Status</th></tr>
      <% for (const r of roster.rows) { const kc = r.team === 'KC'; %>
        <tr class="<%= r.starter ? '' : 'muted-row' %><%= kc ? ' kc-row' : '' %>">
          <td><%= r.starter ? '🟢' : '' %></td>
          <td><b><%= r.name %></b><% if (r.rank && r.rank <= 50) { %> <span class="badge gold" title="Sleeper overall rank">#<%= r.rank %></span><% } %><% if (kc) { %> <img class="kc-logo" src="/icons/kc.svg" alt="KC" title="Kansas City Chiefs"><% } %></td>
          <td><%= r.pos %></td>
          <td class="muted"><%= r.team %></td>
          <td class="num"><%= r.wkPts == null ? '—' : r.wkPts.toFixed(1) %></td>
          <td class="num"><b><%= r.seasonPts == null ? '—' : r.seasonPts.toFixed(1) %></b></td>
          <td><% if (r.inj) { %><span class="badge owes"><%= r.inj %></span><% } else { %><span class="muted">healthy</span><% } %></td>
        </tr>
      <% } %>
      <%# An empty roster has more than one cause, and this used to assert the
          friendliest one. Sitting under a 4–2 record it read "Empty roster —
          draft hasn't happened yet", which is two mutually exclusive claims on
          one screen: you cannot be 4–2 in a season that hasn't drafted. A roster
          is also empty when the owner isn't mapped to a Sleeper team or Sleeper
          is unreachable — and those are the cases where a wrong explanation
          costs you, because it sends you to wait instead of to the fix. Say
          which one it is, from what the page already knows. %>
      <% if (!roster.rows.length) { %>
        <% const played = /\d+\s*-\s*\d+/.test(String(roster.record || '')) && !/^0\s*-\s*0/.test(String(roster.record || '')); %>
        <tr><td class="muted" style="padding:1rem" colspan="7">
          <% if (played) { %>
            <b>No roster came back from Sleeper</b>, even though there's a <%= roster.record %> record this season —
            so this is a connection or mapping problem, not an empty team. Check Sleeper team mapping with the commissioner.
          <% } else { %>
            Empty roster — the draft hasn't happened yet. The Wk/Season columns come alive once games are played.
          <% } %>
        </td></tr>
      <% } %>
    </table>
  </div>
</div>

<p class="muted" style="text-align:center; margin-top:1rem">
  🟢 = in the starting lineup on Sleeper. Set your actual lineup over there — this page is for scouting and shame.
</p>
<% } %>

<% } %>
<%- include('partials/footer') %>
