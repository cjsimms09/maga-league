<%- include('../partials/header', { title: year + ' Vault' }) %>
<%
  const when = d => { try { return new Date(d).toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); } catch (e) { return ''; } };
%>

<div class="chron">
  <h1 class="chron-title">The <span class="gold"><%= year %></span> Vault</h1>
  <p class="chron-sub">Everything the league said and the site said back — on the record, forever.</p>

  <% if (!dispatches.length && !weeks.length) { %>
    <div class="card"><div class="body">
      <p class="muted" style="margin:0">Nothing in the vault for <%= year %> yet<%= (currentYear && year === currentYear) ? ' — the trash talk and dispatches from this season land here as they happen' : '' %>.</p>
    </div></div>
  <% } %>

  <%# ── THE DISPATCHES — the awards, power polls and vault callbacks the site issued ── %>
  <% if (dispatches.length) { %>
    <div class="card" style="margin-bottom:1.2rem">
      <h2>📣 The Dispatches <span class="sub"><%= dispatches.length %> from <%= year %></span></h2>
      <div class="body">
        <ul class="vault-dispatches">
          <% for (const d of dispatches) { %>
            <li class="vault-dispatch">
              <span class="vault-d-icon" aria-hidden="true"><%= d.icon || '📌' %></span>
              <div class="vault-d-text">
                <div class="vault-d-title"><%= d.title || d.kind || 'Dispatch' %></div>
                <div class="vault-d-body"><%= d.body %></div>
              </div>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  <% } %>

  <%# ── THE TRASH TALK — every thread, every week, attributed and permanent ── %>
  <% if (weeks.length) { %>
    <div class="card">
      <h2>🗣️ Trash Talk <span class="sub"><%= total %> post<%= total === 1 ? '' : 's' %>, welded to the game they were said about</span></h2>
      <div class="body">
        <% for (const wk of weeks) { %>
          <div class="vault-week">
            <div class="vault-week-head">Week <%= wk.week %></div>
            <ul class="tt-thread">
              <% for (const p of wk.posts) { %>
                <li class="tt-post">
                  <div class="tt-meta"><b class="tt-who"><%= nameOf(p.owner_id) %></b>
                    <span class="tt-when muted"><%= when(p.created_at) %></span></div>
                  <div class="tt-body"><%= p.body %></div>
                </li>
              <% } %>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <p style="text-align:center; margin-top:1rem">
    <a class="btn navy" href="/history">← The Chronicle</a>
    <% if (currentYear) { %><a class="btn navy" href="/history/vault/<%= currentYear %>">This season's vault</a><% } %>
  </p>
</div>
<%- include('../partials/footer') %>
