<%- include('../partials/header', { title: 'The Money Board' }) %>
<%
  const MB = A.moneyBoard;
  const german = A.german;
  const flag = name => [...german].some(g => String(name).includes(g)) ? '🇩🇪' : '🇺🇸';
  const dollars = n => '$' + Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 2 });
%>

<div class="chron chron-wide">
  <a class="back-link" href="/history">← The Chronicle</a>
  <p class="chron-eyebrow">The Table That Settles Every Argument</p>
  <h1 class="chron-title">The <span class="gold">Money Board</span></h1>
  <p class="chron-sub">All-time career earnings, ranked. This is the scoreboard the league actually plays for.</p>
  <%- include('_subnav', { active: 'money' }) %>

  <div class="card">
    <h2>💰 Career Earnings <span class="sub">2016 → present, ten deep</span></h2>
    <div class="body chron-scroll">
      <% if (!MB.rows.length) { %>
        <%# FAIL LOUD, never silent-empty. An empty earnings table reads as
            "nobody has won anything," which is worse than an error because
            nothing alarms. If the money engine returned no rows, the source
            data did not load — say so, visibly. %>
        <div class="asterisk-note" style="border-color:var(--red)">
          <h4>⚠️ The money data failed to load</h4>
          <p style="margin:0">The career-earnings source (the master sheet) did not
          load, so this board is empty — that is a data/deploy failure, not a real
          "nobody earned anything." Reported rather than shown as blanks.</p>
        </div>
      <% } else { %>
      <table class="ledger">
        <thead><tr>
          <th class="name">#</th><th class="name">Owner</th><th>Career $</th><th>W-L-T</th>
          <% for (const y of MB.years) { %><th><%= String(y).slice(2) %></th><% } %>
          <% const LIVE_YEAR = 2026; const showLive = !MB.years.includes(LIVE_YEAR); %>
          <% if (showLive) { %><th title="2026 — in progress" style="color:var(--green)">'26<span style="display:block;font-size:.5rem;color:var(--muted);font-weight:500">in progress</span></th><% } %>
        </tr></thead>
        <tbody>
          <% MB.rows.forEach((r, i) => { %>
            <tr class="<%= i === 0 ? 'champ' : '' %>">
              <td class="name rk"><%= i + 1 %></td>
              <td class="name"><%= r.name %> <span class="flag"><%= flag(r.name) %></span></td>
              <td class="money"><%= dollars(r.career) %></td>
              <td style="color:var(--muted)"><%= r.wins %>-<%= r.loss %><%= r.tie ? '-' + r.tie : '' %></td>
              <% for (const y of MB.years) { const v = (r.by_year || {})[y] || (r.by_year || {})[String(y)] || 0; %>
                <td class="<%= v ? '' : '' %>" style="<%= v ? '' : 'color:var(--muted)' %>">
                  <%= v ? dollars(v) : '·' %><% if (r.name === 'Marian' && Number(y) === 2022) { %><a class="aster" href="/history#asterisk">*</a><% } %>
                </td>
              <% } %>
              <%# 2026 — in progress: reads live from the same by_year money the
                  weekly pipeline writes. Banked dollars show as money; nothing yet
                  shows "in progress", never a $0 that reads as earned-nothing. %>
              <% if (showLive) { const v26 = (r.by_year || {})[LIVE_YEAR] || (r.by_year || {})[String(LIVE_YEAR)] || 0; %>
                <td style="<%= v26 ? '' : 'color:var(--muted);font-style:italic' %>">
                  <%= v26 ? dollars(v26) : 'in progress' %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p style="color:var(--muted); font-size:.82rem; margin:.8rem 0 0;">
        Career totals derive from each year's winnings, never the spreadsheet's own
        stale total column. Marian's 2022 line carries the asterisk — the disputed,
        shared title.</p>
      <% } %>
      <div class="asterisk-note" style="border-color:var(--red); margin-top:.9rem;">
        <h4>⚠️ A known attribution gap (owner turnover)</h4>
        <p style="margin:0"><%= A.lore.turnover.moneyCaveat %> Until the true split
        is confirmed, these totals show what the master sheet records — flagged, not
        silently trusted. The departed owners (<%= A.lore.turnover.departed.join(', ') %>)
        carry no figures in the data at all.</p>
      </div>
    </div>
  </div>

  <p class="provenance">
    Source: the master sheet (<%= A.provenance.master_sha256.slice(0, 12) %>…), the league's founding document.
  </p>
</div>

<%- include('../partials/footer') %>
