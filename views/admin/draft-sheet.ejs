<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Draft Sheet <%= seasonYear %> — MFGA</title>
<style>
  /* Self-contained, print-first. Black on white, no site chrome, no JS needed —
     this page must render and print even if everything else is broken. */
  * { box-sizing: border-box; }
  body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    color: #000; background: #fff; margin: 0; padding: 14px; font-size: 12px; line-height: 1.3; }
  h1 { font-size: 17px; margin: 0 0 2px; }
  h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; margin: 14px 0 5px;
    border-bottom: 1.5px solid #000; padding-bottom: 2px; }
  .rule { border: 2px solid #000; border-radius: 6px; padding: 8px 10px; margin: 8px 0 4px;
    font-size: 14px; font-weight: 700; }
  .meta { font-size: 10.5px; color: #333; margin: 2px 0 6px; }
  .meta b { color: #000; }
  .stale { color: #a00; font-weight: 700; }
  .noprint { margin: 6px 0; }
  .btn { font: inherit; padding: 5px 12px; border: 1.5px solid #000; background: #fff; border-radius: 5px; cursor: pointer; }

  /* Best-available-by-position — compact side-by-side columns. */
  .pos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px 12px; }
  .pos-col h3 { font-size: 11px; margin: 0 0 2px; background: #000; color: #fff; padding: 1px 4px; }
  .pos-col ol { margin: 0; padding-left: 18px; }
  .pos-col li { margin: 0; padding: 0; }
  .pos-col .t { color: #555; }

  /* The main ranked board flows into columns to pack ~180 onto a page or two. */
  .board { column-count: 3; column-gap: 16px; }
  @media (max-width: 640px) { .board { column-count: 2; } .pos-grid { grid-template-columns: repeat(2, 1fr); } }
  .row { display: flex; gap: 5px; align-items: baseline; padding: 1px 0;
    border-bottom: 1px solid #ddd; break-inside: avoid; }
  .row .rk { width: 22px; text-align: right; color: #666; flex: 0 0 auto; }
  .row .pos { width: 26px; font-weight: 700; flex: 0 0 auto; }
  .row .nm { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row .adp { width: 30px; text-align: right; color: #444; flex: 0 0 auto; font-variant-numeric: tabular-nums; }
  .row.kept { color: #999; text-decoration: line-through; }
  .row .tier-brk { font-weight: 700; }
  .tierline { break-inside: avoid; border-top: 2px solid #000; margin-top: 2px; font-size: 9.5px; color: #000; font-weight:700; padding-top:1px; }

  /* Manual pick entry — blank grid to track the draft by hand if the app dies. */
  .picks { column-count: 4; column-gap: 14px; }
  @media (max-width: 640px) { .picks { column-count: 2; } }
  .pick { display: flex; gap: 5px; padding: 3px 0; border-bottom: 1px solid #000; break-inside: avoid; }
  .pick .pn { width: 26px; color: #666; flex: 0 0 auto; }
  .pick .ln { flex: 1 1 auto; }

  @media print {
    body { padding: 0; font-size: 10.5px; }
    .noprint { display: none !important; }
    h2 { margin-top: 10px; }
    .board { column-count: 4; }
    .picks { column-count: 5; }
    a { color: #000; text-decoration: none; }
  }
</style>
</head>
<body>
  <h1>🏈 MFGA Draft Sheet — <%= seasonYear %></h1>
  <div class="rule">RULE: <%= rule %></div>
  <div class="meta">
    <%= teams %>-team · <%= rounds %> rounds ·
    <% if (builtAt) { const d = new Date(builtAt); const hrs = Math.round((Date.now() - d.getTime()) / 3.6e6); %>
      board built <b><%= d.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %> ET</b>
      (<%= hrs %>h ago)<% if (hrs > 6) { %> <span class="stale">— rebuild before you draft off it</span><% } %>
    <% } else { %><span class="stale">board age unknown — verify it's current</span><% } %>
    · <b>Print the night before.</b> If the wifi dies at the table, paper still works.
  </div>
  <div class="noprint"><button class="btn" onclick="window.print()">🖨 Print / Save PDF</button>
    <a href="/admin/warroom" style="margin-left:10px">← War room</a></div>

  <h2>Best available by position — the "within startable need" cut</h2>
  <div class="pos-grid">
    <% for (const pos of ['QB','RB','WR','TE','K','DEF']) { const list = byPos[pos] || []; %>
      <div class="pos-col">
        <h3><%= pos %></h3>
        <ol>
          <% for (const p of list) { %><li><%= p.name %><% if (p.bye) { %> <span class="t">·<%= p.bye %></span><% } %></li><% } %>
          <% if (!list.length) { %><li class="t">—</li><% } %>
        </ol>
      </div>
    <% } %>
  </div>

  <h2>The board — top <%= rows.length %> by ADP (cross off as they go)</h2>
  <div class="board">
    <% const _seenTiers = new Set(); %>
    <% for (const r of rows) { %>
      <% if (r.tier != null && !_seenTiers.has(r.tier)) { _seenTiers.add(r.tier); %><div class="tierline">— Tier <%= r.tier %> starts —</div><% } %>
      <div class="row<%= r.kept ? ' kept' : '' %>">
        <span class="rk"><%= r.rank %></span>
        <span class="pos"><%= r.pos %></span>
        <span class="nm"><%= r.name %><% if (r.bye) { %> <span class="adp" style="width:auto;color:#888">b<%= r.bye %></span><% } %><% if (r.kept) { %> (kept)<% } %></span>
        <span class="adp"><%= r.adp != null ? r.adp : '' %></span>
      </div>
    <% } %>
  </div>

  <h2>Manual pick log — if the tool is down, track it here</h2>
  <div class="picks">
    <% for (let i = 1; i <= teams * rounds; i++) { %>
      <div class="pick"><span class="pn"><%= i %>.</span><span class="ln">&nbsp;</span></div>
    <% } %>
  </div>
</body>
</html>
