<%- include('../partials/header', { title: 'Commissioner Console' }) %>

<h1 class="page-title">⭐ Commissioner Console</h1>
<p class="page-sub">Executive powers. Use them wisely, <%= owner.name %>.</p>

<div class="tabs">
  <% const tabs = [['alerts','📣 Alerts'],['ledger','💰 The Ledger'],['weekly','🏈 Weekly Winner'],['awards','🏆 Season Awards'],['standings','📊 Standings'],['draft','🎯 Draft'],['votes','🗳 Votes'],['owners','👥 Owners'],['season','⚙️ Season Setup'],['sleeper','😴 Sleeper']]; %>
  <% for (const [key, label] of tabs) { %>
    <a href="/admin?tab=<%= key %>&year=<%= season.year %>" class="<%= tab === key ? 'active' : '' %>"><%= label %></a>
  <% } %>
</div>

<% if (flash) { %><div class="flash-note"><%= flash %></div><% } %>

<%# ── DID THE SCHEDULED THINGS ACTUALLY HAPPEN ────────────────────────────────
    Three jobs now send mail on the league's behalf, and until this panel existed
    the only place their outcome appeared was a GitHub Actions annotation. The
    line that earns this its space is not "the last one worked" — it is the
    arithmetic: the league is on week 9, the last recap went out for week 6,
    three weeks were missed. A panel that reports the most recent SUCCESS is how
    a job that stopped three weeks ago still looks healthy.

    It renders nothing when everything is fine and nothing is off-season, on the
    same principle as the contact-directory strip above: a green light nobody
    needs is a green light nobody reads. %>
<% if (typeof health !== 'undefined' && health.length) {
     const bad = health.filter(h => !h.ok); %>
  <% if (bad.length) { %>
    <div class="alert-banner" style="margin:0 0 1rem; border-color:#d4242f">
      <span class="tag">⛔</span>
      <span><b><%= bad.length %> thing<%= bad.length === 1 ? '' : 's' %> the automation is not doing.</b>
        <%= bad.map(h => h.label + ': ' + h.detail).join(' · ') %></span>
    </div>
  <% } %>
  <details class="contact-status" style="background:var(--panel-soft); border:1px solid var(--line); border-left:3px solid <%= bad.length ? '#d4242f' : 'var(--gold)' %>; border-radius:8px; padding:.6rem .9rem; margin:0 0 1rem;">
    <summary style="cursor:pointer; color:var(--ink)">
      <b>Automation</b> — <%= bad.length ? bad.length + ' needing attention' : 'all clear' %>. Tap for what ran and when.
    </summary>
    <table class="roll" style="margin:.6rem 0 0">
      <% for (const h of health) { %>
        <tr>
          <td style="width:1.6rem"><%= h.ok ? '✅' : '⛔' %></td>
          <td><b><%= h.href ? '' : '' %><%= h.label %></b></td>
          <td><%= h.detail %>
            <% if (h.note) { %><br><span class="muted" style="font-size:.78rem"><%= h.note %></span><% } %></td>
          <td style="text-align:right"><% if (h.href) { %><a href="<%= h.href %>">open →</a><% } %></td>
        </tr>
      <% } %>
    </table>
  </details>
<% } %>

<%# Contact-directory status — aggregate, and only when actionable. Nothing shows
    when everyone's complete; each owner is nagged for their own data at home. %>
<% if (typeof contactStatus !== 'undefined' && contactStatus.length) { %>
<details class="contact-status" style="background:var(--panel-soft); border:1px solid var(--line); border-left:3px solid var(--gold); border-radius:8px; padding:.6rem .9rem; margin:0 0 1rem;">
  <summary style="cursor:pointer; color:var(--ink)"><b><%= contactStatus.length %></b> owner<%= contactStatus.length === 1 ? '' : 's' %> still missing contact info — tap for names to hound in the chat.</summary>
  <ul style="margin:.5rem 0 0; padding-left:1.2rem; color:#cdd3e2;">
    <% for (const o of contactStatus) { %><li><b><%= o.name %></b> — missing <%= o.missing.join(', ') %></li><% } %>
  </ul>
</details>
<% } %>

<% const seasonScoped = ['weekly','awards','standings','draft','season'].includes(tab); %>
<% if (seasonScoped) { %>
  <form method="get" action="/admin" class="inline-form" style="margin-bottom:1rem">
    <input type="hidden" name="tab" value="<%= tab %>">
    <div class="fit">
      <label class="field">Managing season</label>
      <select name="year" onchange="this.form.submit()">
        <% for (const s of seasons) { %><option value="<%= s.year %>" <%= s.year === season.year ? 'selected' : '' %>><%= s.year %> (<%= s.status %>)</option><% } %>
      </select>
    </div>
  </form>
<% } %>

<%# ============================ ALERTS ============================ %>
<% if (tab === 'alerts') { %>
<div class="grid cols-2">
  <div class="card">
    <h2>Post an Alert <span class="sub">shows on every page for every owner</span></h2>
    <div class="body">
      <form method="post" action="/admin/alerts">
        <label class="field">Message</label>
        <textarea name="message" rows="3" required placeholder="e.g. Draft night is Aug 28th at Cory's. Bring cash."></textarea>
        <label class="field">Level</label>
        <select name="level">
          <option value="info">📣 League News (blue)</option>
          <option value="warning">⚠️ Notice (yellow)</option>
          <option value="urgent">🚨 Urgent (red)</option>
        </select>
        <div style="margin-top:.8rem"><button class="btn" type="submit">Post Alert</button></div>
      </form>
      <p class="muted" style="margin-top:.8rem">Note: last place also gets roasted automatically on the dashboard once Sleeper is connected. No action required. It's the law.</p>
    </div>
  </div>
  <div class="card">
    <h2>Current Alerts</h2>
    <div class="body tight">
      <table class="roll">
        <% for (const a of alertRows) { %>
          <tr>
            <td><span class="badge <%= a.active ? 'open' : 'closed' %>"><%= a.active ? 'live' : 'off' %></span></td>
            <td><%= a.message %> <span class="muted">(<%= a.level %>)</span></td>
            <td class="num" style="white-space:nowrap">
              <form class="asis" method="post" action="/admin/alerts/<%= a.id %>/toggle"><button class="btn small navy"><%= a.active ? 'Hide' : 'Show' %></button></form>
              <form class="asis" method="post" action="/admin/alerts/<%= a.id %>/delete"><button class="btn small ghost">Delete</button></form>
            </td>
          </tr>
        <% } %>
        <% if (!alertRows.length) { %><tr><td class="muted" style="padding:1rem">No alerts yet.</td></tr><% } %>
      </table>
    </div>
  </div>
</div>
<% } %>

<%# ============================ LEDGER ============================ %>
<% if (tab === 'ledger') { %>
<div class="grid cols-2">
  <div class="card">
    <h2>Make an Entry <span class="sub">your private books — members never see this page</span></h2>
    <div class="body">
      <form method="post" action="/admin/ledger">
        <div class="inline-form">
          <div>
            <label class="field">Who</label>
            <select name="owner_id" required>
              <option value="">— owner —</option>
              <% for (const o of ownerRows.filter(o => o.active)) { %><option value="<%= o.id %>"><%= o.name %></option><% } %>
            </select>
          </div>
          <div>
            <label class="field">What happened</label>
            <select name="kind">
              <option value="payment_received">💵 They paid me (+)</option>
              <option value="payment_sent">💸 I paid them (−)</option>
              <option value="credit">📈 Credit them (+) — winnings, refund</option>
              <option value="charge">📉 Charge them (−) — fee, side bet lost</option>
              <option value="carry_credit">↪️ Carried over (+) — last season's balance, in their favour</option>
              <option value="carry_debit">↩️ Carried over (−) — last season's balance, against them</option>
            </select>
          </div>
          <div>
            <label class="field">Amount ($)</label>
            <input type="number" step="0.01" min="0.01" name="amount" required placeholder="150">
          </div>
        </div>
        <label class="field">What for</label>
        <input type="text" name="desc" required placeholder="e.g. Partial buy-in, Week 4 payout, Punt-return side bet">
        <label class="field">Note (optional — how it moved)</label>
        <input type="text" name="note" maxlength="120" placeholder="Venmo, cash at draft, Zelle…">
        <div class="inline-form" style="margin-top:.6rem">
          <div class="fit">
            <label class="field">Season</label>
            <select name="year"><% for (const sn of seasons) { %><option value="<%= sn.year %>" <%= sn.year === season.year ? 'selected' : '' %>><%= sn.year %></option><% } %></select>
          </div>
          <div class="fit"><button class="btn" type="submit">Add to the Books</button></div>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <h2>Balances <span class="sub">quick view</span></h2>
    <div class="body tight">
      <table class="roll">
        <tr><th>Owner</th><th class="num">Net Tab</th><th></th></tr>
        <% for (const b of Object.values(balancesMap).sort((x, y) => x.balance - y.balance)) { %>
          <tr>
            <td><b><%= b.owner.name %></b></td>
            <td class="num <%= b.balance > 0 ? 'pos' : b.balance < 0 ? 'neg' : '' %>">
              <%= b.balance === 0 ? '✓ even' : (b.balance > 0 ? 'you owe ' : 'owes you ') + money(Math.abs(b.balance)) %>
            </td>
            <td class="num">
              <% if (b.balance !== 0) { %>
              <form class="asis" method="post" action="/admin/ledger/settle-all/<%= b.owner.id %>"
                    onsubmit="return confirm('Archive everything with <%= b.owner.name %> as settled?')">
                <button class="btn small navy">🤝 Square Up</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </table>
    </div>
  </div>

  <div class="card col-span-2">
    <h2>
      The Register <span class="sub">every transaction ever — the source of truth</span>
      <span style="display:flex; gap:.4rem; align-items:center">
        <a class="btn small gold" href="/admin/ledger.csv">⬇ CSV</a>
      </span>
    </h2>
    <div class="body">
      <form method="get" action="/admin" class="inline-form" style="margin-bottom:.6rem">
        <input type="hidden" name="tab" value="ledger">
        <div class="fit">
          <label class="field">Filter by owner</label>
          <select name="owner" onchange="this.form.submit()">
            <option value="">Everyone</option>
            <% for (const o of ownerRows.filter(o => o.active)) { %><option value="<%= o.id %>" <%= ledgerFilter === o.id ? 'selected' : '' %>><%= o.name %></option><% } %>
          </select>
        </div>
      </form>
      <div class="scroll-x">
      <table class="roll">
        <tr><th>Date</th><th>Owner</th><th>Entry</th><th class="num">Amount</th><th>Season</th><th>Status</th><th></th></tr>
        <% const reg = [...ledger].filter(e => !ledgerFilter || e.owner_id === ledgerFilter).sort((a, b) => (a.created_at < b.created_at ? 1 : -1)); %>
        <% for (const e of reg) { %>
          <tr class="<%= e.settled ? 'muted-row' : '' %>">
            <td style="white-space:nowrap"><%= (e.created_at || '').slice(0, 10) %></td>
            <td><b><%= nameOf(e.owner_id) %></b></td>
            <td>
              <%= e.desc %> <span class="muted">(<%= TYPE_LABELS[e.type] || e.type %>)</span>
              <% if (e.audit && e.audit.length) { %>
                <details style="display:inline"><summary class="muted" style="display:inline; cursor:pointer; font-size:.7rem"> history</summary>
                  <div class="muted" style="font-size:.7rem; padding:.2rem 0 0">
                    <% for (const a of e.audit) { %><div><%= (a.at || '').slice(0, 16).replace('T', ' ') %> — <%= a.what %></div><% } %>
                  </div>
                </details>
              <% } %>
            </td>
            <td class="num <%= e.amount > 0 ? 'pos' : 'neg' %>"><%= money(e.amount) %></td>
            <td><%= e.year %></td>
            <td>
              <% if (e.settled) { %><span class="badge closed">settled<%= e.settle_note ? ' · ' + e.settle_note : '' %></span>
              <% } else { %><span class="badge open">open</span><% } %>
            </td>
            <td class="num" style="white-space:nowrap">
              <form class="asis" method="post" action="/admin/ledger/<%= e.id %>/settle">
                <button class="btn small <%= e.settled ? 'ghost' : 'gold' %>"><%= e.settled ? '↩ Undo' : '✓ Settle' %></button>
              </form>
              <form class="asis" method="post" action="/admin/ledger/<%= e.id %>/delete" onsubmit="return confirm('Delete this entry from the books entirely?')"><button class="btn small ghost">✕</button></form>
            </td>
          </tr>
        <% } %>
        <% if (!reg.length) { %><tr><td class="muted" style="padding:1rem" colspan="7">No entries<%= ledgerFilter ? ' for this owner' : '' %>.</td></tr><% } %>
      </table>
      </div>
    </div>
  </div>
</div>
<% } %>

<%# ============================ WEEKLY ============================ %>
<% if (tab === 'weekly') { %>
<% if (suggestion) { %>
<div class="card" style="margin-bottom:1.2rem; border-color:var(--gold)">
  <h2>😴 Sleeper Says <span class="sub">week <%= suggestWeek %> high score</span></h2>
  <div class="body">
    <p style="margin-top:0">
      Top score in week <%= suggestWeek %>: <b><%= suggestion.team %></b> with <b><%= suggestion.points %></b> points
      <% if (suggestion.owner) { %> — that's <b><%= suggestion.owner.name %></b>.<% } else { %> — <span class="muted">not mapped to an owner yet (Sleeper tab).</span><% } %>
    </p>
    <div class="inline-form">
      <% if (suggestion.owner) { %>
      <form class="asis" method="post" action="/admin/weekly">
        <input type="hidden" name="year" value="<%= season.year %>">
        <input type="hidden" name="week" value="<%= suggestWeek %>">
        <input type="hidden" name="owner_id" value="<%= suggestion.owner.id %>">
        <input type="hidden" name="amount" value="<%= season.weekly_payout %>">
        <button class="btn gold" type="submit">⚡ Record <%= suggestion.owner.name %> as Week <%= suggestWeek %> Winner (<%= money(season.weekly_payout) %>)</button>
      </form>
      <% } %>
      <form class="asis inline-form" method="get" action="/admin">
        <input type="hidden" name="tab" value="weekly"><input type="hidden" name="year" value="<%= season.year %>">
        <div class="fit"><label class="field">Check another week</label>
        <select name="sweek" onchange="this.form.submit()">
          <% for (let w = 1; w <= 18; w++) { %><option value="<%= w %>" <%= w === suggestWeek ? 'selected' : '' %>>Week <%= w %></option><% } %>
        </select></div>
      </form>
    </div>
  </div>
</div>
<% } %>
<div class="grid cols-2">
  <div class="card">
    <h2>Record a Weekly High Point <span class="sub">lands on their tab until you settle it</span></h2>
    <div class="body">
      <form method="post" action="/admin/weekly">
        <input type="hidden" name="year" value="<%= season.year %>">
        <div class="inline-form">
          <div>
            <label class="field">Week</label>
            <select name="week">
              <% const takenWeeks = new Set(weekly.map(w => w.week)); let firstOpen = 1; while (takenWeeks.has(firstOpen)) firstOpen++; %>
              <% for (let w = 1; w <= Math.max(season.weeks, 15); w++) { %>
                <option value="<%= w %>" <%= w === firstOpen ? 'selected' : '' %>>Week <%= w %><%= takenWeeks.has(w) ? ' (recorded — will overwrite)' : '' %></option>
              <% } %>
            </select>
          </div>
          <div>
            <label class="field">Winner</label>
            <select name="owner_id" required>
              <option value="">— pick the owner —</option>
              <% for (const o of ownerRows.filter(o => o.active)) { %><option value="<%= o.id %>"><%= o.name %></option><% } %>
            </select>
          </div>
          <div>
            <label class="field">Amount</label>
            <input type="number" step="0.01" name="amount" value="<%= season.weekly_payout %>">
          </div>
          <div class="fit">
            <label class="field" style="white-space:nowrap"><input type="checkbox" name="paid" value="1" style="width:auto"> Already paid out</label>
            <button class="btn" type="submit">Save Winner</button>
          </div>
        </div>
      </form>
    </div>
  </div>
  <div class="card">
    <h2><%= season.year %> Weekly Winners</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Week</th><th>Winner</th><th class="num">Amount</th><th>Paid</th><th></th></tr>
        <% for (const w of weekly) { %>
          <tr>
            <td>Week <%= w.week %></td>
            <td><b><%= w.name %></b></td>
            <td class="num"><%= money(w.amount) %></td>
            <td>
              <form class="asis" method="post" action="/admin/ledger/<%= w.id %>/settle">
                <input type="hidden" name="back" value="weekly"><input type="hidden" name="year" value="<%= season.year %>">
                <button class="btn small <%= w.settled ? 'navy' : 'gold' %>"><%= w.settled ? '✅ Paid' : 'Mark Paid' %></button>
              </form>
            </td>
            <td class="num">
              <form class="asis" method="post" action="/admin/ledger/<%= w.id %>/delete">
                <input type="hidden" name="back" value="weekly"><input type="hidden" name="year" value="<%= season.year %>">
                <button class="btn small ghost">✕</button>
              </form>
            </td>
          </tr>
        <% } %>
        <% if (!weekly.length) { %><tr><td class="muted" style="padding:1rem" colspan="5">No winners recorded yet.</td></tr><% } %>
      </table>
    </div>
  </div>
</div>
<% } %>

<%# ============================ AWARDS ============================ %>
<% if (tab === 'awards') { %>
<div class="grid cols-2">
  <div class="card">
    <h2>Assign a Season Award <span class="sub">amount auto-fills; lands on their tab</span></h2>
    <div class="body">
      <form method="post" action="/admin/propose-awards" style="margin-bottom:.9rem">
        <input type="hidden" name="year" value="<%= season.year %>">
        <button class="btn gold" type="submit">⚡ Draft all six from Sleeper standings</button>
        <span class="muted"> — fills in anything not already recorded; you fix the playoff spots.</span>
      </form>
      <form method="post" action="/admin/awards">
        <input type="hidden" name="year" value="<%= season.year %>">
        <label class="field">Award</label>
        <select name="category">
          <% const amounts = {}; [...payouts.reg, ...payouts.playoff].forEach(r => amounts[r.category] = r.amount); %>
          <% for (const c of CATEGORIES) { %>
            <option value="<%= c %>"><%= CATEGORY_LABELS[c] %> — <%= money(amounts[c] || 0) %></option>
          <% } %>
        </select>
        <label class="field">Winner</label>
        <select name="owner_id" required>
          <option value="">— pick the owner —</option>
          <% for (const o of ownerRows.filter(o => o.active)) { %><option value="<%= o.id %>"><%= o.name %></option><% } %>
        </select>
        <label class="field">Amount (leave blank to use the payout table)</label>
        <input type="number" step="0.01" name="amount" placeholder="auto">
        <label class="field" style="margin-top:.7rem"><input type="checkbox" name="paid" value="1" style="width:auto"> Already paid out</label>
        <div style="margin-top:.8rem"><button class="btn" type="submit">Save Award</button></div>
      </form>
    </div>
  </div>
  <div class="card">
    <h2><%= season.year %> Awards</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Award</th><th>Winner</th><th class="num">Amount</th><th>Paid</th><th></th></tr>
        <% for (const a of awards) { %>
          <tr>
            <td><%= CATEGORY_LABELS[a.category] || a.category %></td>
            <td><b><%= a.name %></b></td>
            <td class="num"><%= money(a.amount) %></td>
            <td>
              <form class="asis" method="post" action="/admin/ledger/<%= a.id %>/settle">
                <input type="hidden" name="back" value="awards"><input type="hidden" name="year" value="<%= season.year %>">
                <button class="btn small <%= a.settled ? 'navy' : 'gold' %>"><%= a.settled ? '✅ Paid' : 'Mark Paid' %></button>
              </form>
            </td>
            <td class="num">
              <form class="asis" method="post" action="/admin/ledger/<%= a.id %>/delete">
                <input type="hidden" name="back" value="awards"><input type="hidden" name="year" value="<%= season.year %>">
                <button class="btn small ghost">✕</button>
              </form>
            </td>
          </tr>
        <% } %>
        <% if (!awards.length) { %><tr><td class="muted" style="padding:1rem" colspan="5">No awards assigned yet.</td></tr><% } %>
      </table>
    </div>
  </div>
</div>
<% } %>

<%# ============================ STANDINGS ============================ %>
<% if (tab === 'standings') { %>
<div class="card">
  <h2><%= season.year %> Final Regular-Season Standings <span class="sub">these set next year's draft pick order — and who gets the 🚽</span></h2>
  <div class="body">
    <form method="post" action="/admin/standings">
      <input type="hidden" name="year" value="<%= season.year %>">
      <div class="grid cols-2">
        <% const activeCount = ownerRows.filter(x => x.active).length; %>
        <% const currentRanks = {}; (season.standings || []).forEach((oid, i) => currentRanks[oid] = i + 1); %>
        <% for (const o of ownerRows.filter(o => o.active)) { %>
          <div class="inline-form">
            <div class="fit" style="min-width:110px"><b><%= o.name %></b></div>
            <div class="fit">
              <select name="rank_<%= o.id %>">
                <option value="">—</option>
                <% for (let r = 1; r <= activeCount; r++) { %>
                  <option value="<%= r %>" <%= currentRanks[o.id] === r ? 'selected' : '' %>><%= r %><%= ['st','nd','rd'][r - 1] || 'th' %></option>
                <% } %>
              </select>
            </div>
          </div>
        <% } %>
      </div>
      <div style="margin-top:1rem"><button class="btn" type="submit">Save Standings</button></div>
    </form>
  </div>
</div>
<% } %>

<%# ============================ DRAFT ============================ %>
<% if (tab === 'draft') { %>
<div class="grid cols-2">
  <div class="card">
    <h2><%= season.year %> Draft Controls</h2>
    <div class="body">
      <p>
        Status:
        <% if (!draft.picks.length) { %><span class="badge closed">not started</span>
        <% } else if (draft.complete) { %><span class="badge navy">order complete</span>
        <% } else { %><span class="badge <%= season.draft_open ? 'open' : 'closed' %>"><%= season.draft_open ? 'OPEN — ' + (draft.current ? 'waiting on ' + draft.current.name : '') : 'paused' %></span><% } %>
        &nbsp;•&nbsp; Keepers: <span class="badge <%= season.keepers_locked ? 'closed' : 'open' %>"><%= season.keepers_locked ? 'locked' : 'unlocked' %></span>
      </p>
      <div class="vote-actions">
        <form class="asis" method="post" action="/admin/draft/open">
          <input type="hidden" name="year" value="<%= season.year %>">
          <button class="btn" type="submit"><%= draft.picks.length ? 'Open Spot Selection' : 'Generate Order & Open' %></button>
        </form>
        <form class="asis" method="post" action="/admin/draft/close">
          <input type="hidden" name="year" value="<%= season.year %>">
          <button class="btn navy" type="submit">Pause Room</button>
        </form>
        <form class="asis" method="post" action="/admin/keepers-lock">
          <input type="hidden" name="year" value="<%= season.year %>">
          <button class="btn gold" type="submit"><%= season.keepers_locked ? 'Unlock Keepers' : 'Lock Keepers' %></button>
        </form>
        <%# Typed confirmation, checked SERVER-side (a browser confirm() is not a
            guard — a stray POST walks past it). The route also snapshots the
            claims before deleting, so a mistake is recoverable. %>
        <form class="asis" method="post" action="/admin/draft/reset" onsubmit="return confirm('Wipe the entire <%= season.year %> draft order and all claimed spots?')">
          <input type="hidden" name="year" value="<%= season.year %>">
          <input type="text" name="confirm" placeholder="type RESET" autocomplete="off" style="width:7.5rem" aria-label="Type RESET to confirm">
          <button class="btn ghost" type="submit">Reset Draft</button>
        </form>
      </div>
      <p class="muted" style="margin-top:.9rem">
        "Generate Order & Open" builds the pick order automatically from the <b><%= season.year - 1 %></b> final standings, reversed
        (last place picks first). Owners then claim spots on their turn from Draft Spot Selection.
      </p>
      <% if (prevStandings.length) { %>
        <p class="muted"><%= season.year - 1 %> standings on file: <%= prevStandings.map(s => s.rank + '. ' + s.name).join(' · ') %></p>
      <% } else { %>
        <p class="muted">⚠️ No <%= season.year - 1 %> standings recorded — enter them in the Standings tab first.</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Picks & Overrides</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Pick</th><th>Owner</th><th>Spot Chosen</th><th>Override</th></tr>
        <% for (const p of draft.picks) { %>
          <tr>
            <td><%= p.pos %></td>
            <td><b><%= p.name %></b></td>
            <td><%= p.slot != null ? '#' + p.slot : (draft.current && draft.current.pos === p.pos ? '🎯 choosing now' : '—') %></td>
            <td>
              <form class="inline-form asis" method="post" action="/admin/draft/override">
                <input type="hidden" name="year" value="<%= season.year %>">
                <input type="hidden" name="pos" value="<%= p.pos %>">
                <input type="number" name="slot" min="1" max="<%= draft.picks.length %>" value="<%= p.slot != null ? p.slot : '' %>" placeholder="spot" style="width:70px">
                <button class="btn small navy">Set</button>
              </form>
            </td>
          </tr>
        <% } %>
        <% if (!draft.picks.length) { %><tr><td class="muted" style="padding:1rem" colspan="4">No draft order yet.</td></tr><% } %>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Declared Keepers</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Owner</th><th>Player</th><th class="num">Costs Round</th></tr>
        <% for (const k of keepers) { %>
          <tr><td><b><%= k.name %></b></td><td><%= k.player_name %></td><td class="num"><%= k.round %></td></tr>
        <% } %>
        <% if (!keepers.length) { %><tr><td class="muted" style="padding:1rem" colspan="3">None declared.</td></tr><% } %>
      </table>
    </div>
  </div>
</div>
<% } %>

<%# ============================ VOTES ============================ %>
<% if (tab === 'votes') { %>
<div class="card">
  <h2>All Measures <span class="sub">anyone can propose from the Voting Booth — you close, reopen, or delete</span></h2>
  <div class="body tight scroll-x">
    <table class="roll">
      <tr><th>Question</th><th>Proposed By</th><th class="num">Yes</th><th class="num">No</th><th>Ballots</th><th>Status</th><th></th></tr>
      <% for (const v of votes) { %>
        <tr>
          <td><b><%= v.question %></b></td>
          <td><%= v.proposer_name %></td>
          <td class="num"><%= v.yes %></td>
          <td class="num"><%= v.no %></td>
          <td class="muted" style="max-width:220px"><%= v.ballots.map(b => `${b.name}: ${b.choice}`).join(', ') || '—' %></td>
          <td><span class="badge <%= v.status === 'open' ? 'open' : (v.passed ? 'gold' : 'closed') %>"><%= v.status === 'open' ? 'open' : (v.passed ? 'passed' : 'failed') %></span></td>
          <td class="num" style="white-space:nowrap">
            <% if (v.status === 'open') { %>
              <form class="asis" method="post" action="/admin/votes/<%= v.id %>/close"><button class="btn small navy">Close</button></form>
            <% } else { %>
              <form class="asis" method="post" action="/admin/votes/<%= v.id %>/reopen"><button class="btn small gold">Reopen</button></form>
            <% } %>
            <form class="asis" method="post" action="/admin/votes/<%= v.id %>/delete" onsubmit="return confirm('Delete this vote and its ballots?')"><button class="btn small ghost">✕</button></form>
          </td>
        </tr>
      <% } %>
      <% if (!votes.length) { %><tr><td class="muted" style="padding:1rem" colspan="7">No measures yet.</td></tr><% } %>
    </table>
  </div>
</div>

<%# Enact a passed measure INTO the season config — the pot, weekly-high, payout
    table, finances, money board and the amendment ledger all follow from it. %>
<% const enactable = votes.filter(v => v.passed && !v.enacted_at); %>
<div class="card" style="margin-top:1rem">
  <h2>Enact a passed measure <span class="sub">writes the result into the season config — everything downstream follows</span></h2>
  <div class="body">
    <% if (!enactable.length) { %>
      <p class="muted" style="margin:0">Nothing to enact. A measure shows here once it has passed (<%= threshold %> yes) and hasn't been enacted yet.
        <% const done = votes.filter(v => v.enacted_at); if (done.length) { %><br><br>Already enacted: <%= done.map(v => `“${v.question}” — ${v.enacted_change || ''}`).join(' · ') %><% } %></p>
    <% } else { %>
      <% for (const v of enactable) { %>
        <form method="post" action="/admin/votes/<%= v.id %>/enact" class="enact-form" style="border:1px solid var(--line);border-radius:12px;padding:.8rem;margin-bottom:.7rem">
          <div style="font-weight:700;margin-bottom:.5rem">✅ <%= v.question %></div>
          <div class="fit" style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:end">
            <label class="field">Change
              <select name="effect_type">
                <option value="buy_in">Buy-in ($)</option>
                <option value="weekly_payout">Weekly-high payout ($)</option>
                <option value="payouts">Payout structure (%)</option>
                <option value="config">Other config key</option>
              </select>
            </label>
            <label class="field">Value <input type="text" name="value" placeholder="500" style="width:6rem"></label>
            <label class="field">Season <input type="number" name="effect_season" placeholder="next" style="width:5.5rem"></label>
          </div>
          <div class="fit" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.4rem">
            <label class="field">reg % (csv) <input type="text" name="reg" placeholder="0.10,0.05" style="width:9rem"></label>
            <label class="field">playoff % (csv) <input type="text" name="playoff" placeholder="0.27,0.22,0.20,0.16" style="width:12rem"></label>
            <label class="field">config key <input type="text" name="config_key" placeholder="keeper_count" style="width:8rem"></label>
            <label class="field">config value <input type="text" name="config_value" style="width:6rem"></label>
          </div>
          <div style="margin-top:.5rem"><button class="btn gold" type="submit">Enact → season config</button>
            <span class="muted" style="font-size:.75rem">Fill only the fields your change needs. Season blank = the upcoming one.</span></div>
        </form>
      <% } %>
    <% } %>
  </div>
</div>
<% } %>

<%# ============================ OWNERS ============================ %>
<% if (tab === 'owners') { %>
<div class="grid cols-2">
  <div class="card">
    <h2>Add an Owner</h2>
    <div class="body">
      <form method="post" action="/admin/owners">
        <label class="field">Name</label>
        <input type="text" name="name" required>
        <label class="field">Username (for login)</label>
        <input type="text" name="username" required>
        <div style="margin-top:.8rem"><button class="btn" type="submit">Add Owner</button></div>
      </form>
      <p class="muted" style="margin-top:.8rem">A temporary password is generated for them — it shows at the top of this page after you add them. They'll be forced to change it on first login.</p>
      <hr style="border:none; border-top:1px solid var(--line); margin:1rem 0">
      <h3 style="margin:0 0 .3rem; font-size:.8rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted)">Career Records</h3>
      <% const synced = ownerRows.some(o => o.record_baseline); %>
      <p class="muted" style="margin:.2rem 0 .6rem">
        <% if (synced) { %>
          ⚡ Records are auto-updating. Everything before the league moved to Sleeper is frozen exactly as you had it; Sleeper seasons are added live.
        <% } else { %>
          Records are manual right now. Syncing freezes your pre-Sleeper years untouched and lets Sleeper keep the rest current forever.
        <% } %>
      </p>
      <div class="vote-actions">
        <form class="asis" method="post" action="/admin/sync-records"><button class="btn small gold"><%= synced ? '↻ Re-sync' : '⚡ Sync with Sleeper' %></button></form>
        <% if (synced) { %><form class="asis" method="post" action="/admin/unsync-records"><button class="btn small ghost">Back to manual</button></form><% } %>
      </div>
    </div>
  </div>
  <div class="card">
    <h2>Roster of Owners</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Owner</th><th>Username</th><th>Career W-L-T</th><th></th></tr>
        <% for (const o of ownerRows) { %>
          <tr>
            <td><b><%= o.name %></b> <%= o.is_commissioner ? '⭐' : '' %> <%= o.active ? '' : '(inactive)' %></td>
            <td class="muted"><%= o.username %></td>
            <td>
              <form class="inline-form asis" method="post" action="/admin/owners/<%= o.id %>/record">
                <input type="number" name="wins" value="<%= o.wins %>" style="width:58px" title="Wins">
                <input type="number" name="losses" value="<%= o.losses %>" style="width:58px" title="Losses">
                <input type="number" name="ties" value="<%= o.ties %>" style="width:52px" title="Ties">
                <button class="btn small navy">Save</button>
              </form>
            </td>
            <td class="num" style="white-space:nowrap">
              <form class="asis" method="post" action="/admin/owners/<%= o.id %>/reset-password" onsubmit="return confirm('Reset <%= o.name %>\'s password?')"><button class="btn small gold">Reset PW</button></form>
              <% if (o.id !== owner.id) { %>
                <form class="asis" method="post" action="/admin/owners/<%= o.id %>/toggle-active"><button class="btn small ghost"><%= o.active ? 'Deactivate' : 'Reactivate' %></button></form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </table>
    </div>
  </div>
</div>
<% } %>

<%# ============================ SEASON ============================ %>
<% if (tab === 'season') { %>
<div class="card">
  <h2>Season Setup <span class="sub">edit <%= season.year %> or create a new season</span></h2>
  <div class="body">
    <% const p = season.payouts; %>
    <form method="post" action="/admin/season">
      <div class="grid cols-3">
        <div><label class="field">Year</label><input type="number" name="year" value="<%= season.year %>" required></div>
        <div><label class="field">Buy-in ($) — changes with league votes</label><input type="number" step="0.01" name="buy_in" value="<%= season.buy_in %>"></div>
        <div><label class="field">Total pot ($)</label><input type="number" step="0.01" name="total_pot" value="<%= season.total_pot %>"></div>
        <div><label class="field">Regular-season weeks</label><input type="number" name="weeks" value="<%= season.weeks %>"></div>
        <div><label class="field">Weekly high-point payout ($)</label><input type="number" step="0.01" name="weekly_payout" value="<%= season.weekly_payout %>"></div>
        <div>
          <label class="field">Status</label>
          <select name="status">
            <% for (const st of ['upcoming','active','complete']) { %><option value="<%= st %>" <%= season.status === st ? 'selected' : '' %>><%= st %></option><% } %>
          </select>
        </div>
      </div>
      <%# Payout STRUCTURE — any number of places, not a fixed 2+4. Enter the
          percentages in finishing order, comma-separated. The number of entries
          IS the number of paid places, so a vote that adds or drops a prize is a
          one-field edit here. Stored as fractions; the pot, finances, money board
          and amendment ledger all derive from this. %>
      <% const pctList = a => (Array.isArray(a) ? a : []).map(x => +(x * 100).toFixed(1)).join(', '); %>
      <% const sumPct = a => (Array.isArray(a) ? a : []).reduce((t, x) => t + x, 0) * 100; %>
      <% const total = sumPct(p.reg) + sumPct(p.playoff); %>
      <p class="muted" style="margin:.9rem 0 .3rem">
        Payout percentages, in finishing order, comma-separated (of the pot remaining after weekly payouts — the two groups should add to 100).
        <span style="font-weight:700; color:<%= Math.abs(total - 100) < 0.05 ? 'var(--blue)' : 'var(--red)' %>">Currently <%= +total.toFixed(1) %>%<%= Math.abs(total - 100) < 0.05 ? ' ✓' : ' — does not add to 100' %>.</span>
      </p>
      <div class="grid cols-2">
        <div><label class="field">Regular-season prizes (%, e.g. <code>10, 5</code>)</label><input type="text" name="reg_pcts" value="<%= pctList(p.reg) %>" placeholder="10, 5"></div>
        <div><label class="field">Playoff prizes (%, e.g. <code>50, 30, 15, 5</code>)</label><input type="text" name="playoff_pcts" value="<%= pctList(p.playoff) %>" placeholder="50, 30, 15, 5"></div>
      </div>
      <div style="margin-top:1rem"><button class="btn" type="submit">Save Season</button></div>
      <p class="muted" style="margin-top:.6rem">
        Creating a new year automatically charges the buy-in to every owner's tab. Changing the buy-in later updates
        anyone who hasn't paid yet. Setting a season to <b>active</b> completes the previous one.
      </p>
    </form>
    <hr style="border:none; border-top:1px solid var(--line); margin:1.2rem 0">
    <form method="post" action="/admin/settings" class="inline-form" style="margin-bottom:1rem">
      <div class="fit">
        <label class="field">YES votes needed to pass a rule change</label>
        <input type="number" name="vote_threshold" min="1" max="20" value="<%= config.vote_threshold || 6 %>" style="width:90px">
      </div>
      <div class="fit"><button class="btn navy" type="submit">Save</button></div>
    </form>
    <%# DRAFT DAY — the front-page banner, countdown, and pinned alert all derive
        from these three fields. Change one, they all move together. %>
    <form method="post" action="/admin/draft-day" class="inline-form" style="margin-bottom:1rem">
      <div class="fit">
        <label class="field">Draft date</label>
        <input type="date" name="draft_date" value="<%= (config && config.draft_date) || '2026-08-22' %>">
      </div>
      <div class="fit">
        <label class="field">Time</label>
        <input type="text" name="draft_time" value="<%= (config && config.draft_time) || '6:00 PM' %>" placeholder="6:00 PM" style="width:110px">
      </div>
      <div class="fit">
        <label class="field">Place</label>
        <input type="text" name="draft_location" value="<%= (config && config.draft_location) || "Cory's House" %>" placeholder="Cory's House">
      </div>
      <div class="fit"><button class="btn gold" type="submit">Save Draft Day</button></div>
    </form>
    <p class="muted" style="margin:-.4rem 0 1rem; font-size:.78rem">The home-page draft banner, its countdown, and the pinned league alert all read from these — one edit moves all three.</p>
    <a class="btn navy" href="/admin/export">⬇️ Export League Data (backup)</a>
    <span class="muted"> — download a JSON snapshot of everything once in a while. The books must survive.</span>
  </div>
</div>
<% } %>

<%# ============================ SLEEPER ============================ %>
<% if (tab === 'sleeper') { %>
<%# A straight answer to "why isn't it working", rather than making the
    commissioner infer it from an empty table. %>
<% const st = sleeperStatus || {}; %>
<div class="card" style="margin-bottom:1.2rem; border-color:<%= st.live && !st.unmapped ? 'rgba(74,222,128,.5)' : 'rgba(255,70,85,.5)' %>">
  <h2><%= st.live && !st.unmapped ? '✅' : '⚠️' %> Sleeper Status</h2>
  <div class="body tight">
    <table class="roll">
      <tr><td>League ID</td>
          <td><%= st.hasId ? st.leagueId : '— not set —' %></td>
          <td><%= st.hasId ? '✅' : '❌ set it below' %></td></tr>
      <tr><td>Reaching Sleeper</td>
          <td><%= st.live ? 'yes, right now' : 'no' %></td>
          <td><%= st.live ? '✅' : '❌ wrong league ID, or Sleeper is down' %></td></tr>
      <tr><td>Teams mapped</td>
          <td><%= st.mapped || 0 %><%= st.teams ? ' of ' + st.teams : '' %></td>
          <td><%= st.live && !st.unmapped ? '✅' : (st.live ? '❌ map them below' : '—') %></td></tr>
      <% if (st.unmappedTeams && st.unmappedTeams.length) { %>
      <tr><td>Still unmapped</td>
          <td colspan="2" class="neg"><%= st.unmappedTeams.join(' · ') %></td></tr>
      <% } %>
      <tr><td>Last successful fetch</td>
          <td colspan="2"><%= st.lastOk ? new Date(st.lastOk).toLocaleString('en-US', { timeZone: 'America/New_York' }) + ' ET' : 'never' %></td></tr>
      <% if (st.lastFail) { %>
      <tr><td>Last failure</td>
          <td colspan="2" class="neg"><%= new Date(st.lastFail).toLocaleString('en-US', { timeZone: 'America/New_York' }) %> ET</td></tr>
      <% } %>
    </table>
    <p class="muted" style="padding:.6rem .2rem 0; margin:0; font-size:.8rem">
      Until all three are ✅: the roster tab, live standings, the weekly-winner
      button, the 💰 markers on teams with money riding, and grading any bet that
      turns on a score will all stay empty. Nothing else on the site is affected.
    </p>
  </div>
</div>

<div class="grid cols-2">
  <div class="card">
    <h2>Connect Sleeper <span class="sub">free public API — read-only, no password needed</span></h2>
    <div class="body">
      <form method="post" action="/admin/sleeper">
        <label class="field">Sleeper League ID</label>
        <input type="text" name="league_id" value="<%= config.sleeper_league_id || '' %>" placeholder="the long number from sleeper.com/leagues/<ID>/...">
        <div style="margin-top:.8rem"><button class="btn" type="submit">Save</button></div>
      </form>
      <p class="muted" style="margin-top:.8rem">
        Once connected, the dashboard shows live standings and this week's scoreboard, the Weekly Winner tab
        gets a one-click "record the high scorer" button, the Record Book computes itself from the league's full
        Sleeper history, the 🧠 War Room lights up on draft day, and last place gets roasted automatically.
      </p>
      <form method="post" action="/admin/sleeper/refresh-records" style="margin-top:.6rem">
        <button class="btn navy" type="submit">♻️ Rebuild Record Book Now</button>
      </form>
      <%# ARCHIVE THE BOARD. The war room captures picks as they land, but only
          while that tab is open — close the laptop on the last pick and the
          final batch may never post. This is the independent second path, and
          it is safe to press any number of times (the archive is content-hash
          deduped, so an unchanged board is skipped). %>
      <form method="post" action="/admin/api/archive/draft" style="margin-top:.6rem">
        <button class="btn navy" type="submit">🗒️ Archive the completed draft board</button>
        <span class="muted" style="font-size:.76rem; margin-left:.5rem">
          Pulls the finished draft from Sleeper into the permanent archive, independently of the war room.
          Safe to press twice — an unchanged board is deduped. Shows up under
          <a href="/history/board/<%= (season && season.year) || '' %>">the season's draft board</a>.
        </span>
      </form>
    </div>
  </div>
  <div class="card">
    <h2>Team Mapping <span class="sub">tie each Sleeper team to its owner</span></h2>
    <div class="body">
      <% if (!config.sleeper_league_id) { %>
        <p class="muted">Connect a league first.</p>
      <% } else if (!sleeperInfo) { %>
        <p class="muted">Couldn't reach Sleeper right now (or the league ID is wrong). Try again in a minute.</p>
      <% } else { %>
        <p style="margin-top:0"><b><%= sleeperInfo.league.name %></b> — <%= sleeperInfo.league.season %> season, week <%= sleeperInfo.week %></p>
        <form method="post" action="/admin/sleeper/map">
          <table class="roll">
            <tr><th>Sleeper Team</th><th>Owner</th></tr>
            <% for (const r of sleeperInfo.rosters) { %>
              <tr>
                <td><b><%= r.team %></b></td>
                <td>
                  <select name="map_<%= r.roster_id %>">
                    <option value="">— not mapped —</option>
                    <% for (const o of ownerRows.filter(o => o.active)) { %>
                      <option value="<%= o.id %>" <%= Number(r.mapped) === o.id ? 'selected' : '' %>><%= o.name %></option>
                    <% } %>
                  </select>
                </td>
              </tr>
            <% } %>
          </table>
          <div style="margin-top:.8rem"><button class="btn" type="submit">Save Mapping</button></div>
        </form>
      <% } %>
    </div>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
