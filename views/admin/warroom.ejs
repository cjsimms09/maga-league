<%- include('../partials/header', { title: 'War Room' }) %>

<h1 class="page-title">🧠 The War Room</h1>
<p class="page-sub">Commissioner eyes only. VONA-driven draft optimization — keeper-adjusted, tier-aware, live.</p>

<div id="loading"><div class="card"><div class="body"><p class="muted" style="margin:0">Loading the board…</p></div></div></div>

<div id="stale-gate" style="display:none"></div>

<div id="warroom" style="display:none">

  <%# ── ONE STATUS STRIP ──────────────────────────────────────────────────
      Six stacked banners used to push the decision surface below the fold on a
      phone. The tool must START at the top of the screen. Everything that was
      a banner is now one line — state · seat · board freshness · health dot —
      with the detail one tap away.

      The health dot is the contract: it goes RED and force-opens the detail on
      anything that invalidates a recommendation (keeper mismatch, unusable ADP,
      an unverified slot). Collapsing noise is only safe if the thing that must
      not be missed can still shout. %>
  <div id="system-strip" class="system-strip" style="display:none"></div>
  <%# The war room hides the site chrome (masthead + bottom tab bar) so a fixed
      element can never cover the recommendation or the Take button. This is the
      one always-visible way back out — shares the Details row, so it costs no
      vertical space above the decision surface. %>
  <div class="wr-toprow">
  <details class="system-details" id="system-details">
    <summary>Details &amp; checklist</summary>
    <div class="sd-body">
      <div id="check-count-inline" class="sd-count"></div>
      <div id="check-items"></div>
      <%# Commissioner-only accounting reconciliation: roster itemized by source
          (keepers vs marked picks vs phantom) and the pick coordinates cross-checked,
          so a disagreement is a named line here instead of three silent numbers. %>
      <div id="accounting-note" style="display:none"></div>
      <div id="provenance" style="display:none"></div>
      <div id="drift-note" style="display:none"></div>
      <div id="slot-note" style="display:none"></div>
      <div id="import-note" style="display:none"></div>
      <div id="override-count" style="display:none"></div>
      <div id="mock-note" style="display:none"></div>
      <div id="rehearsal-keeper-note" style="display:none"></div>
      <div id="reconcile-note" style="display:none"></div>
      <%# SETUP + CONNECT live here now. "On the clock" already renders in the
          pinned status bar, and slot/sync/nav are pre-draft controls touched
          once — so they sit one tap away rather than occupying the fold that
          the decision surface needs. %>
  <div class="hero" style="margin-bottom:1rem">
    <div class="hero-item">
      <span class="hero-label">On the Clock</span>
      <span class="hero-value" id="hdr-pick">—</span>
      <span class="hero-sub" id="hdr-next"></span>
    </div>
    <div class="hero-item">
      <span class="hero-label">League</span>
      <span class="hero-value" style="font-size:.95rem" id="hdr-league">—</span>
      <span class="hero-sub" id="hdr-built"></span>
    </div>
    <div class="hero-item">
      <span class="hero-label">My Draft Slot</span>
      <div class="inline-form" style="justify-content:center; margin-top:.25rem">
        <div class="fit"><input type="number" id="slot-input" min="1" max="20" style="width:64px"></div>
        <div class="fit"><button class="btn small gold" id="slot-apply">Set</button></div>
      </div>
      <span class="hero-sub" id="slot-picks">—</span>
    </div>
    <div class="hero-item" style="flex:2 1 260px">
      <span class="hero-label">Live Sync</span>
      <div class="inline-form" style="justify-content:center; margin-top:.3rem">
        <div style="flex:1 1 150px"><input type="text" id="draft-id" placeholder="Sleeper draft ID (blank = manual)"></div>
        <div class="fit"><button class="btn small gold" id="start-sync">Connect</button></div>
      <div class="fit"><a class="btn small navy" href="/admin/draft-config">⚙️ League Setup</a></div>
      <div class="fit"><a class="btn small navy" href="/admin/keepers">🔒 Keepers</a></div>
      <div class="fit"><a class="btn small ghost" href="/admin/warroom/rehearsal" title="How to test all this against a Sleeper mock">🎬 Rehearse</a></div>
      <div class="fit"><a class="btn small ghost" href="/admin/status" title="Build progress, decisions, and the draft countdown at a glance">📊 Status</a></div>
      <div class="fit"><a class="btn small gold" href="/admin/slot-picker" title="Private: which draft slot to claim, live as claims land">🎯 Slot Picker</a></div>
        <%# §D.1 — END DRAFT moved off the primary flow, away from CONNECT, and requires a typed confirm. %>
        <div class="fit" style="margin-left:auto"><button class="btn small ghost" id="hard-reset" title="Unlink sync and return to idle. Works even when sync is wedged; your picks, targets and weights are untouched.">⏻ Hard reset</button></div>
        <div class="fit"><button class="btn small ghost danger-quiet" id="end-draft" title="Clear every pick (keeps targets, weights, news overrides) — asks you to type END">⏹ End draft</button></div>
      </div>
      <span class="sync-status" id="sync-status">Not connected — manual entry works fine.</span>
    </div>
  </div>
    </div>
  </details>
  <a class="wr-exit" href="/" title="Leave the war room">🏛 Office</a>
  </div><%# /wr-toprow %>
  <%# The run banner stays OUT of the fold-away: a positional run is live
      decision input, not status. %>
  <%# MISSED-MARK RECOVERY. Both stay OUT of the fold-away: an unrecorded pick
      makes every recommendation below it wrong, and a reconciled pick is a
      roster change I did not make myself. Neither is status. %>
  <div id="unrecorded-note" style="display:none"></div>
  <div id="reconciled-note" style="display:none"></div>
  <%# KEEPER-LOCK banner — SEVERITY-1 and BLOCKING: the slate is the one input
      that can be wrong while every derived number (adjusted ADP, pick order, my
      pick numbers) still looks normal. It was buried fourth in the collapsed
      "Details & checklist" stack behind advisory warnings; moved OUT of the
      fold-away to sit first and alone above the decision surface, alongside the
      other rec-invalidating banners. app.js fills it by id — placement is the
      shell's. (Cory, war-room review item 2.) %>
  <div id="keeper-lock-note" style="display:none"></div>
  <div id="run-banner" class="roast-banner" style="display:none"></div>
  <%# Retained hosts: the checklist summary is now inline in the details panel,
      but these ids are still written to by renderChecklist(). Keeping them as
      hidden spans is cheaper and safer than threading null-guards through a
      path that runs on every render during a live draft. %>
  <span id="checklist" style="display:none"></span>
  <span id="check-count" style="display:none"></span>
  <%# B7 compare tray — a floating dollar-gap overlay; tap ⚖️ on any two players. %>
  <div id="compare-tray" class="compare-tray" style="display:none"></div>
  <%# Watermarks retained as hidden hosts: their CONTENT now renders in the
      strip, but renderRehearsalWatermark()/renderSlotWatermark() still drive
      the body classes that mark slot-derived numbers as provisional. %>
  <div id="rehearsal-watermark" class="rehearsal-watermark" style="display:none">REHEARSAL — not the real draft</div>
  <div id="slot-watermark" class="slot-watermark" style="display:none">Slot unverified — pick numbers &amp; timing are provisional until Sleeper confirms your seat</div>


  <%# ── One answer ────────────────────────────────────────────────────────
      Draft day is sixty seconds and a room full of noise. Everything below
      this is for the minute before you're on the clock; THIS is for the minute
      you are. One name, one sentence, and an honest line about whether the
      board can actually separate it from the next one. %>
  <div class="card clock-card" id="clock-card" style="display:none">
    <div class="body">
      <div class="clock-eyebrow">On the clock — pick <span id="clock-pick">—</span></div>
      <div class="clock-name" id="clock-name">—</div>
      <div class="clock-meta" id="clock-meta"></div>
      <div class="clock-why" id="clock-why"></div>
      <div class="clock-confidence" id="clock-confidence"></div>
      <%# THE TAKE BUTTON — the single most important control, and it was MISSING
          from this view (only the full-board recs cards had it), so the ONE ANSWER
          screen recommended a player with no way to draft him. app.js sets its
          data-draft-me + label to the shown player each render (SEV1, live mock). %>
      <div class="clock-actions">
        <button class="btn gold" id="clock-take" data-draft-me="">✓ Take him</button>
        <button class="btn small navy" id="clock-next">Show the next one</button>
        <button class="btn small ghost" id="clock-off">Full board</button>
      </div>
    </div>
  </div>

  <%# THE PLAN (doctrine banner), WATCH (legality strip) and the pick-bar status
      moved DOWN into the decide surface as context BELOW the recommendation
      (Cory: the recommendation + Take buttons come first, before scrolling). Their
      hosts now live inside .wr-zone1 and CSS `order` arranges them under the
      recs card. Ids/classes unchanged, so app.js renders into them as before. %>

  <%# In-page typed confirm for END DRAFT. window.prompt was the mock-#1
      swallowing mechanism — Chrome suppresses repeated dialogs and a suppressed
      prompt returns null silently, so the button read as dead. %>
  <div id="end-confirm" class="end-confirm" style="display:none"></div>
  <span id="prefs-sync" style="display:none;font-size:.68rem;color:var(--muted);position:absolute;top:2px;right:8px;z-index:5" title="prefs sync state"></span>
  <%# Position lives in CSS (.wr-arm) so it can lift ABOVE the mobile tab bar —
      at bottom:16px it sat on top of LOCKER and MORE (z-index 150 > the bar's
      90) and ate those taps. id + onclick are A's contract, untouched. %>
  <button id="arm-alerts" class="btn small gold wr-arm" title="iOS will not play audio without a tap — arm once, alert forever" onclick="if(window.DraftAlerts&&DraftAlerts.arm()){this.textContent='🔔 armed';this.disabled=true;setTimeout(()=>this.remove(),1500);}else{this.textContent='🔕 audio unavailable';}">🔔 Arm my-turn alert</button>

  <%# ── Part 2 §2 — THREE-ZONE LAYOUT ──────────────────────────────────────
       Zone 1 DECIDE (left ~60%): the Paths panel + ranked list + branch forecast.
       Zone 2 CONTEXT (right rail ~40%): roster, byes, LRM, survival.
       Zone 3 DEPTH (full width below): adjusters, opponents, queue, lists, board.
       The compare tray is a floating overlay, so it lives outside the zones. %>
  <div class="wr-decide">
  <div class="wr-zone1">
  <%# ── SEARCH, always one tap (Cory) — type a name and act from the results.
      The #search input + #search-tail results host moved up here from the draft
      board header; app.js binds them by id and its handlers are delegated, so the
      board still filters and the results still render — they just live where the
      hand already is on the clock. #pos-filter stays on the board. %>
  <div class="wr-search">
    <span class="wr-search-icon" aria-hidden="true">🔎</span>
    <input type="text" id="search" placeholder="Search any player — take, queue or compare" autocomplete="off">
  </div>
  <div id="search-tail" hidden></div>
  <%# QUEUE SLIP ALERT (Cory: "impossible to miss when my guy is slipping"). An
      IN-FLOW banner — never floating — that app.js fills when a queued player is
      about a turn from gone (the LRM/branch survival math it already runs).
      Hidden when nothing is slipping so it never becomes furniture. %>
  <div id="queue-slip" class="queue-slip" role="status" aria-live="polite" style="display:none"></div>

  <%# CONTEXT STRIPS — THE PLAN, WATCH, pick-bar. In the DOM here, but CSS `order`
      (on .wr-zone1) places them BELOW the recommendation card. Populated by
      app.js renderDoctrine()/renderLegality()/renderStatusBar(). %>
  <div id="doctrine-banner" class="doctrine-banner" style="display:none">
    <div class="db-main">
      <div class="db-name" id="db-name">—</div>
      <div class="db-creed" id="db-creed"></div>
    </div>
    <div class="db-side">
      <div class="db-confidence" id="db-confidence"></div>
      <div class="db-alt" id="db-alt"></div>
    </div>
  </div>
  <div id="doctrine-switch" class="doctrine-switch" style="display:none">
    <span id="db-switch-text"></span>
    <button class="btn small ghost" id="db-decline" title="Keep the prior doctrine — my draft, my call">Decline — keep the plan</button>
  </div>
  <div id="legality-strip" class="legality-strip" style="display:none"></div>
  <div id="wr-statusbar" class="wr-statusbar" style="display:flex"></div>

  <%# ── THE MINIMUM VIABLE SURFACE ────────────────────────────────────────
      Five truthful lines, and TWO MARKED EXPLICITLY ABSENT.

      The absent pair is the point. SOURCE needs the decision tree's stages and
      NEAR-MISS needs its thresholds; neither exists. Rendering them as empty
      containers would mean rehearsing a layout whose two most information-dense
      elements are placeholders — so they say what they are instead, and mock #4
      rehearses something real.

      Every line here composes data that already exists. Nothing below invents a
      number. %>
  <div id="mvs" class="mvs" style="display:none">
    <div class="mvs-line" id="mvs-status"></div>
    <div class="mvs-line" id="mvs-plan"></div>
    <div class="mvs-line mvs-rec" id="mvs-rec"></div>
    <div class="mvs-line" id="mvs-alts"></div>
    <div class="mvs-line" id="mvs-roster"></div>
    <div class="mvs-line mvs-absent" id="mvs-absent"></div>
  </div>
  <%# THE STRATEGY-SPLIT PANEL — what each strategy would take from the board RIGHT
      NOW, projected live (shadows.js project()). One line by default (the split),
      the full per-strategy list one tap away. When the strategies disagree that is
      the contested-decision signal — the pick worth slowing down for — so a split
      lights the panel up instead of sitting quiet. Context zone: below the
      recommendation, above the deadline strip; never competing with Zone 1. %>
  <div id="shadow-projection" class="shadow-proj" style="display:none">
    <div class="shadow-proj-line" id="shadow-proj-line"></div>
    <details id="shadow-proj-details">
      <summary>what each strategy would take →</summary>
      <div id="shadow-proj-body"></div>
    </details>
  </div>
  <%# LAYER 1, FIRST: the LRM strip is a DEADLINE — "elite QB gone by 41"
      changes what you do RIGHT NOW. It sat in the right rail, and then at the
      bottom of Layer 1 at 1676px; a deadline below the fold is a deadline you
      read after it passed. One thin line, above the decision surface. %>
  <div class="card" id="lrm-card" style="margin-bottom:.6rem">
    <div class="body"><div id="lrm-strip" class="lrm-strip" style="display:none"></div></div>
  </div>
  <div class="card" style="margin-bottom:1rem; border-color:rgba(245,196,69,.5)" id="recs-card">
    <h2>🎯 Take This Player
      <span class="sub">2–4 priced directions · the ranked list is underneath</span>
      <button class="btn small ghost" data-cmp-open="1" style="flex:0 0 auto" title="Compare two players — the dollar gap">⚖️ Compare</button>
      <button class="btn small gold" id="clock-on" style="flex:0 0 auto">⏱ One answer</button>
    </h2>
    <div class="body">
      <div id="confidence-note"></div>
      <%# Part 2 §1 — the Paths panel: the primary decision surface. The flat
          ranked list below it stays for the "who exactly" follow-through. %>
      <div id="paths-coinflip" class="paths-coinflip" style="display:none"></div>
      <div id="paths-panel" class="paths-panel"></div>
      <%# THE MOVEMENT LINE — one thin line, replaced never accumulated: is the
          model changing its mind as the board moves, and why. Hidden when steady. %>
      <div id="movement-line" class="movement-line" style="display:none"></div>
      <details id="recs-details" class="recs-details">
        <summary>Full ranked list</summary>
        <div id="recs"></div>
      </details>
      <%# Best available at a position you choose. The main list answers "who
          should I take"; this answers "I want a WR \u2014 which one, and what
          does waiting cost me". %>
      <%# §2(d) — always-visible best-available strip (cross-position glance). %>
      <div id="best-avail-strip" class="best-avail-strip"></div>
      <div id="pos-recs-wrap" style="margin-top:.9rem; border-top:1px solid var(--line,#2a2a2a); padding-top:.7rem">
        <label class="field" style="margin-bottom:.25rem">Best available by position — detail</label>
        <select id="pos-recs" style="width:auto">
          <option value="">— pick a position —</option>
          <option value="QB">QB</option><option value="RB">RB</option>
          <option value="WR">WR</option><option value="TE">TE</option>
          <option value="K">K</option><option value="DEF">DEF</option>
          <option value="FLEX">FLEX (RB/WR/TE)</option>
        </select>
        <div id="pos-recs-out" style="margin-top:.5rem"></div>
      </div>
      <p id="tiebreak" class="muted" style="display:none; margin:.6rem 0 0"></p>
    </div>
  </div>

  <%# ── What each option costs you at your next pick ──────────────────────── %>
  <div class="card" id="branch-card" style="margin-bottom:1rem; display:none">
    <h2>🔀 If You Take… <span class="sub" id="branch-head">what's likely left at your next pick</span></h2>
    <div class="body tight scroll-x"><div id="branches"></div></div>
  </div>

  <%# ── THE QUEUE — promoted from Layer 3 to the decide surface (Cory). The list
      you read when the clock is at 8 seconds; you watch it every pick, so it sits
      here under the recommendation, always visible, not two taps down by the
      audits. Ids unchanged (#queue, #queue-head, the action buttons) so app.js
      renders into it exactly as before. %>
  <div class="card wr-queue-card" id="queue-card">
    <h2>📋 Queue <span class="sub" id="queue-head"></span></h2>
    <div class="body">
      <div id="queue"></div>
      <div class="queue-actions">
        <button class="btn small navy" id="queue-fill" title="Append the board's top 15, then reorder">✨ Fill from board</button>
        <button class="btn small ghost" id="queue-copy" title="Plain text on the clipboard">📋 Copy</button>
        <button class="btn small ghost" id="queue-print" title="One page, designed for paper">🖨 Print sheet</button>
        <button class="btn small ghost" id="queue-tidy" hidden></button>
      </div>
      <%# THE DRAFT-DAY FALLBACK — a server-rendered, no-JS printable board that
          works even if this war room won't load. Print it the night before. %>
      <p style="margin:.55rem 0 0"><a class="btn small navy" href="/admin/draft-sheet" target="_blank" rel="noopener" title="Server-rendered board + the rule + a manual pick log — works with no network, prints on paper">🖨 Full board fallback sheet →</a></p>
      <p class="muted" id="sheet-note" style="margin:.5rem 0 0; font-size:.74rem"></p>
      <p class="muted" style="margin:.35rem 0 0; font-size:.72rem">
        Your order, never re-sorted — the decision already made. Add anyone with the ➕ on any row or the board. Print it the night before; if the wifi dies at the table, paper still works.
      </p>
    </div>
  </div>
  </div><%# /wr-zone1 %>

  <%# ── LAYER 2 (one tap) ─────────────────────────────────────────────────
      Roster, byes, survival, opponents. Everything a decision LEANS on but does
      not need in the same glance. Open by default on desktop where the rail is
      free; collapsed on a phone where it would push Layer 1 off the screen.
      Nothing is deleted — demotion is a change of depth, not of existence. %>
  <details class="wr-layer2" id="layer-2" open>
    <summary class="layer-sum">Layer 2 — opponents, roster, byes, survival</summary>
  <aside class="wr-zone2">
    <%# KNOW YOUR LEAGUE — the most valuable panel on the page: real read on the
        nine people you're drafting against. Was buried at the bottom of the
        collapsed Layer 3, below survival and targets; lifted to the top of the
        always-open Layer 2 so opponent intelligence sits right under the decision.
        app.js fills #managers by id — placement is the shell's. (Cory review 6a.) %>
    <div class="card">
      <h2>🕵️ Know Your League <span class="sub" id="managers-head"></span></h2>
      <div class="body"><div id="managers" class="mgr-grid"></div></div>
    </div>
    <div class="card">
      <h2>My Roster <span class="sub">starting slots first</span></h2>
      <div class="body">
        <div id="plan-note"></div>
        <div id="roster-slots" class="slot-grid"></div>
        <ul id="roster-list" style="margin:.8rem 0 0; padding-left:1.1rem"></ul>
      </div>
    </div>

    <div class="card">
      <h2>🗓 Bye Weeks <span class="sub" id="bye-head">weeks your starters are off</span></h2>
      <div class="body"><div id="byes"></div></div>
    </div>

    <div class="card">
      <h2>Survival Odds <span class="sub" id="survival-head"></span></h2>
      <%# Conservation alarm: only as many players can go as there are picks. Filled
          by app.js renderSurvival; hidden unless the sum genuinely violates it. %>
      <div id="survival-conservation" style="display:none"></div>
      <div class="body"><div id="survival"></div></div>
    </div>

    <%# STACK LINE — a quiet home for a LEAN. `stack` is classed weak / not
        installed; it earns a context-rail line (a human weighing a lean is a
        legitimate path) but NEVER Zone-1 prominence, and it always wears its
        class so decoration never reads as an installed edge. Hidden when there
        are no live routes. %>
    <div class="card" id="stack-card" style="display:none">
      <h2>🔗 Stacks <span class="sub" id="stack-class">LEAN, not installed</span></h2>
      <div class="body"><div id="stack-line" class="stack-line"></div></div>
    </div>

    <%# §2(d) — condensed opponent strip (the full breakdown stays in Zone 3). %>
    <div class="card">
      <h2>🎯 Before your pick <span class="sub">will your guy make it back?</span></h2>
      <div class="body">
        <p class="muted" style="margin:0 0 .55rem; font-size:.78rem">
          Everyone who picks between now and your next turn. Each row is one
          seat: their pick number, who they are, the player(s) they're most
          likely to take, and the starting slot they still need.
          <b>How to use it:</b> if a player you want is listed as someone's
          likely pick, take him now — he probably won't come back to you. If
          nobody ahead needs his position, you can safely wait a round.
          The lines up top summarize it: <i>“3/4 need RB”</i> is a run about to
          happen; <i>“still need a starter — QB 2 (low = wait)”</i> means only
          two teams still need a QB, so that position is safe to hold off on.
        </p>
        <div id="threat-strip" class="threat-strip"></div>
      </div>
    </div>
  </aside><%# /wr-zone2 %>
  </details>
  </div><%# /wr-decide %>

  <%# ── LAYER 3 (one more tap) ────────────────────────────────────────────
      Full board, adjusters, shadow standings, Know Your League, queue/paper,
      every audit and explainer. Reachable always, in the way never. %>
  <details class="wr-layer3" id="layer-3">
    <summary class="layer-sum">Layer 3 — board, adjusters, audits &amp; every explainer</summary>
  <div id="shadow-strip" class="card" style="display:none;margin:0 0 1rem">
    <h2>👥 Shadow standings <span class="sub">every strategy drafts silently at your slots — the 2026 season grades them in dollars</span></h2>
    <div class="body" id="shadow-strip-body"></div>
  </div>
  <div class="wr-zone3 grid cols-2">
    <div class="card">
      <h2>🎛 Adjusters <span class="sub">how the board weighs things — saved on this device</span></h2>
      <div class="body">
        <p class="muted" style="margin:0 0 .6rem; font-size:.78rem">
          Every recommendation is a weighted sum of seven things. These are the
          weights. <b>1.0 is normal, 0 turns it off, 3 makes it dominant.</b>
          Pick a strategy below, or move one slider and watch what it does to
          the top five — if nothing changes, that factor wasn't deciding
          anything anyway.
        </p>
        <div class="preset-row" id="presets"></div>
        <p class="preset-why" id="preset-why"></p>
        <div id="auto-note" hidden></div>
        <%
           /* MEASURED DEFAULTS (3rd tuple field), not a flat 1.0. These mirror
              engine.js MEASURED_WEIGHTS — the core the tool loads on. The static
              value= is a FALLBACK behind syncSliders() (which overwrites it from
              state.weights on load); hardcoding it measured-accurate means the
              panel never lies even if the JS never runs. */
           const sliders = [
             ['value', 'Raw value (VONA)', 1.0,
              'How much the board\u2019s own value gap drives the pick. This is the biggest term in the score.',
              'Leave it at 1. This is roughly HALF the entire measured edge \u2014 the participation test cost the board about \u2212$362 when it was dropped. Raising it takes the best player available and ignores roster shape; there is no measured reason to lower it.'],
             ['tier', 'Tier cliff urgency', 0.0,
              'How hard to chase the last good player at a position before the drop-off.',
              'OFF by default — the Lab measured tier-chasing as a net DRAG on dollars, not a gain. Raise it only if you specifically want the last man in an emptying tier and accept that measured cost.'],
             ['need', 'Starting-lineup need', 0.0,
              'How much an empty starting slot outranks another bench body.',
              'OFF by default — the always-on startable-capacity MASK already refuses any pick that cannot start, so an explicit need term was redundant and measured as null. The mask does this job whether this slider is up or down.'],
             ['risk', 'Risk penalty', 0.0,
              'Age, injury history, a crowded depth chart.',
              'OFF by default — measured as a DRAG, like tier. Raise it only if your keepers already carry the team and you want the draft merely not to blow up, knowing it costs expected points.'],
             ['ceiling', 'Upside bonus', 0.0,
              'Rewards the wide range of outcomes over the safe median.',
              'OFF by default — ceiling COULD NOT BE SIGNED: the measurement was −4.8 with a [−26, +17] interval straddling zero, so it no longer decides late picks. Raise it if you are deliberately chasing rather than protecting a lead, but know it is unmeasured.'],
             ['keeper', 'Keeper option value', 1.0,
              'A late pick who becomes next year\'s cheap keeper is worth more than his projection.',
              'Raise it once you are out of the running for this year, or in the last four rounds when the marginal starter is worthless anyway.'],
             ['bye', 'Bye collision penalty', 0.0,
              'What it costs to stack your starters on the same bye week.',
              'OFF by default — bye-collision came back a null in the Lab. Raise it after round 8 if you want the board to avoid stacking starters on one bye; before that it is noise (check the bye card instead).'],
             ['stack', 'Correlation / stacking', 0.5,
              'Your QB with his own receiver; two receivers competing for the same targets.',
              'The ONE adjuster that earned in testing, so it ships at 0.5 (not off). Raise it if you like correlated boom weeks; drop to 0 if you think stacking is overrated — plenty of people do.'] ]; %>
        <% for (const [key, label, def, hint, when] of sliders) { %>
          <label class="field" style="margin-bottom:.1rem"><%= label %> — <span id="w-<%= key %>"><%= def.toFixed(1) %></span></label>
          <input class="weight-slider" type="range" min="0" max="3" step="0.1" value="<%= def %>" data-weight="<%= key %>" style="width:100%">
          <p class="muted" style="margin:.1rem 0 .1rem; font-size:.72rem"><%= hint %></p>
          <p class="slider-when" style="margin:0 0 .55rem"><b>When to move it:</b> <%= when %></p>
        <% } %>
        <button class="btn small navy" id="reset-weights">Reset to live policy</button>
        <%# RULE 7: the FROZEN baseline is the only thing called "the measured core";
            what the sliders hold is live policy. app.js fills this host. %>
        <div id="baseline-restore" style="margin-top:.4rem"></div>
        <p class="muted" id="weights-effect" style="margin:.5rem 0 0; font-size:.76rem; min-height:1.1em"></p>
      </div>
    </div>

    <div class="card">
      <h2>🔮 Survival odds — will your targets last? <span class="sub" id="threats-head"></span></h2>
      <div class="body">
        <p class="muted" style="margin:0 0 .6rem; font-size:.78rem">
          The full answer to “can I wait on this guy?” for every seat between now
          and your next turn.
          <b>“Most likely to be gone”</b> lists the players at highest risk and,
          where one stands out, the seat that will probably grab them —
          if your target is near the top, take him now.
          Below that, one row per seat before you: their pick number, the
          <b>positions they’ll likely target</b> (with odds), the specific
          <b>names</b> they tend to take, and their <b>draft tendency</b> —
          all built from <b>their own past drafts on Sleeper</b>. No history →
          modelled as league-average, and it says so, so you can overrule it.
        </p>
        <div id="threats"></div>
      </div>
    </div>

    <%# The Queue moved UP to the decide surface (Cory: it's what you touch every
        pick, it was buried next to the audits). It now lives at the bottom of
        Zone 1, always visible under the recommendation — see #queue there. %>

    <div class="card">
      <h2>⭐ Targets &amp; 🚫 Never <span class="sub">your own read — saved on this device</span></h2>
      <div class="body">
        <p class="muted" style="margin:0 0 .6rem; font-size:.78rem">
          A star nudges a player up a close call. It will not drag a worse player
          to the top — that is deliberate. <b>Never</b> removes them from every
          recommendation, full stop.
        </p>
        <div id="lists"></div>
        <p class="muted" style="margin:.5rem 0 0; font-size:.74rem">
          Star or block anyone from the ⭐ / 🚫 buttons on the draft board below.
        </p>
      </div>
    </div>

    <div class="card">
      <h2>Recent Picks <span class="sub">league-wide</span></h2>
      <div class="body"><ul id="picks-feed" style="margin:0; padding-left:1.1rem"></ul></div>
    </div>
  </div>


  <div class="card" style="margin-top:1rem">
    <h2>
      Draft Board <span class="sub" id="board-count"></span>
      <span style="display:flex; gap:.4rem">
        <select id="pos-filter" style="width:auto">
          <option value="ALL">All</option>
          <% for (const p of ['QB','RB','WR','TE','K','DEF']) { %><option value="<%= p %>"><%= p %></option><% } %>
        </select>
        <%# player search moved to the top of the decide surface (#search); the
            board keeps its position filter. %>
      </span>
    </h2>
    <div class="body tight scroll-x">
      <table class="roll" id="board">
        <thead><tr>
          <th>#</th><th>Player</th><th>Pos</th><th>Team</th><th class="num">Bye</th>
          <th class="num">Proj</th><th class="num">VORP</th><th class="num">Tier</th>
          <th class="num">Adj ADP</th><th class="num">Raw</th><th>Flags</th><th title="Manual news override">News</th><th></th>
        </tr></thead>
        <tbody id="board-body"></tbody>
      </table>
    </div>
  </div>
  </details><%# /layer-3 %>
</div>

<script>
