<%- include('partials/header', { title: 'League Finances' }) %>
<%
  // "12 Mar 2026", never "03/12/2026" — David and Marian read the latter as
  // 3 December, and this is the money page.
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const fmtDate = (s, withYear) => {
    if (!s) return '';
    const d = new Date(s);
    if (isNaN(d)) return String(s).slice(0, 10);
    // Within one season the year is the same on every row — repeating it ten
    // times steals width from the description, which is what actually differs.
    return d.getUTCDate() + ' ' + MON[d.getUTCMonth()]
      + (withYear ? ' ' + d.getUTCFullYear() : '');
  };
  const isCommish = owner.is_commissioner;
  const vc = viewCard;
  const isMine = vc && vc.owner.id === owner.id;
%>

<h1 class="page-title" id="top">💰 League Finances</h1>
<p class="page-sub">Every dollar in and out, in <b>USD</b>. Balances roll over season to
season until settled.</p>

<%# ── One team's running ledger. Yours unless you tapped someone else's name. ── %>
<% if (vc) { %>
<div class="card owner-ledger" style="margin-bottom:1.3rem">
  <h2>
    <%= isMine ? 'Your Ledger' : vc.owner.name + '’s Ledger' %>
    <span class="sub"><%= season.year %> season</span>
    <span class="ledger-bal <%= vc.balance > 0 ? 'pos' : vc.balance < 0 ? 'neg' : '' %>">
      <%= vc.balance === 0 ? '✓ Settled up'
          : (vc.balance > 0 ? 'League owes ' : 'Owes league ') + money(Math.abs(vc.balance)) %>
    </span>
  </h2>
  <div class="body tight scroll-x">
    <%
      // Everything this season, settled and open, so the running balance tells
      // the story of the year rather than only what is still outstanding.
      const mine = vc.entries
        .filter(e => Number(e.year) === Number(season.year))
        .sort((a, b) => (a.created_at < b.created_at ? -1 : 1));
    %>
    <% if (!mine.length) { %>
      <p class="muted" style="padding:1rem; margin:0">Nothing on the books for <%= season.year %> yet.</p>
    <% } else { %>
    <table class="roll ledger">
      <thead><tr>
        <th>Date</th><th>Item</th><th class="num">Amount</th>
        <th class="num">Tab</th><% if (isCommish) { %><th></th><% } %>
      </tr></thead>
      <tbody>
        <% let run = 0; %>
        <% for (const e of mine) { if (!e.settled) run += e.amount; %>
          <tr class="<%= e.settled ? 'is-settled' : '' %>">
            <td class="ldate"><%= fmtDate(e.created_at) %></td>
            <td class="litem"><%= e.desc %><% if (e.week) { %> <span class="muted type-tag">wk <%= e.week %></span><% } %></td>
            <td class="num <%= e.amount < 0 ? 'neg' : 'pos' %>"><%= (e.amount > 0 ? '+' : '') + money(e.amount) %></td>
            <%# A settled row shows a tick, not an em-dash: "—" reads as missing
                data, when the truth is that this one is done and off the tab. %>
            <td class="num run <%= e.settled ? 'done' : run > 0 ? 'pos' : run < 0 ? 'neg' : '' %>"><%= e.settled ? '✅' : money(run) %></td>
            <% if (isCommish) { %>
            <td class="num" style="white-space:nowrap">
              <form class="asis" method="post" action="/admin/ledger/<%= e.id %>/settle">
                <input type="hidden" name="back" value="bank">
                <button class="btn small <%= e.settled ? 'ghost' : 'gold' %>"
                        title="<%= e.settled ? 'Undo — put it back on the tab' : 'Money actually changed hands' %>"><%= e.settled ? '↺' : '✓' %></button>
              </form>
            </td>
            <% } %>
          </tr>
        <% } %>
        <tr class="total">
          <td colspan="3"><%= vc.balance === 0 ? 'All settled' : vc.balance < 0 ? 'Still owes' : 'Still owed' %></td>
          <td class="num <%= vc.balance > 0 ? 'pos' : vc.balance < 0 ? 'neg' : '' %>"><%= vc.balance === 0 ? '✓' : money(vc.balance) %></td>
          <% if (isCommish) { %><td></td><% } %>
        </tr>
      </tbody>
    </table>
    <% } %>
    <% if (isCommish && vc.balance !== 0) { %>
      <div style="padding:.55rem .9rem; border-top:1px solid var(--line)">
        <form class="asis" method="post" action="/admin/ledger/settle-all/<%= vc.owner.id %>"
              onsubmit="return confirm('Mark everything settled with <%= vc.owner.name %>? This means the money actually changed hands.')">
          <input type="hidden" name="back" value="bank">
          <button class="btn small navy">🤝 Square up everything with <%= vc.owner.name %></button>
        </form>
      </div>
    <% } %>
  </div>
</div>
<% } %>

<% if (isCommish) { %>
<details class="card entry-card" style="margin-bottom:1.3rem; border-color:rgba(245,196,69,.5)">
  <summary>✍️ Record a payment or credit <span class="sub">cash, side bets — anything the site didn’t generate itself</span></summary>
  <div class="body">
    <form method="post" action="/admin/ledger" class="entry-form">
      <input type="hidden" name="back" value="bank">
      <div class="ef-row">
        <label class="field">Who
          <select name="owner_id" required>
            <% for (const c of cards) { %><option value="<%= c.owner.id %>" <%= vc && c.owner.id === vc.owner.id ? 'selected' : '' %>><%= c.owner.name %></option><% } %>
          </select>
        </label>
        <label class="field">What happened
          <select name="kind">
            <option value="payment_received">They paid me</option>
            <option value="payment_sent">I paid them</option>
            <option value="charge">Charge them (they owe more)</option>
            <option value="credit">Credit them (league owes more)</option>
          </select>
        </label>
        <label class="field">Amount (USD)
          <input type="number" name="amount" step="0.01" min="0" placeholder="0.00" required>
        </label>
      </div>
      <div class="ef-row">
        <label class="field" style="flex:2 1 240px">Description
          <input type="text" name="desc" maxlength="80" placeholder="e.g. Side bet — Week 4" required>
        </label>
        <label class="field" style="flex:1 1 180px">Note <span class="muted">(optional)</span>
          <input type="text" name="note" maxlength="120" placeholder="e.g. Venmo">
        </label>
        <div class="fit"><button class="btn gold" type="submit">Add to Ledger</button></div>
      </div>
    </form>
  </div>
</details>
<% } %>

<%# ── The chart: who owes what, at a glance. Tap a name to open their ledger. ── %>
<div class="card">
  <h2>📊 Where Everyone Stands <span class="sub"><%= season.year %> — tap a name for their ledger</span></h2>
  <div class="body tight scroll-x">
    <table class="roll ledger standings-chart">
      <thead><tr>
        <th>Owner</th><th>Buy-in</th>
        <th class="num">Paid in</th><th class="num">Won</th><th class="num">Balance</th>
      </tr></thead>
      <tbody>
        <% for (const c of cards) {
             const yr = c.entries.filter(e => Number(e.year) === Number(season.year));
             const paid = yr.filter(e => e.amount < 0 && e.settled).reduce((s, e) => s + -e.amount, 0);
             const won = yr.filter(e => e.amount > 0).reduce((s, e) => s + e.amount, 0);
             const buyIn = yr.find(e => e.type === 'buy_in');
        %>
          <tr class="<%= vc && c.owner.id === vc.owner.id ? 'is-viewing' : '' %>">
            <td><a class="owner-link" href="/bank?owner=<%= c.owner.id %>#top"><%= c.owner.name %><%= c.owner.id === owner.id ? ' (you)' : '' %></a></td>
            <td><% if (!buyIn) { %><span class="muted">—</span>
                <% } else if (buyIn.settled) { %><span class="badge paid">Paid</span>
                <% } else { %><span class="badge owes">Owes</span><% } %></td>
            <td class="num"><%= paid ? money(paid) : '·' %></td>
            <td class="num pos"><%= won ? money(won) : '·' %></td>
            <td class="num run <%= c.balance > 0 ? 'pos' : c.balance < 0 ? 'neg' : '' %>">
              <%= c.balance === 0 ? '✓ even' : money(c.balance) %></td>
          </tr>
        <% } %>
        <tr class="total">
          <td colspan="4">Still owed TO the league</td>
          <td class="num neg"><%= money(Math.abs(totalOwedToLeague)) %></td>
        </tr>
        <tr class="total">
          <td colspan="4">Still owed BY the league</td>
          <td class="num pos"><%= money(totalLeagueOwes) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<p class="muted" style="text-align:center; margin-top:1.1rem">
  Buy-ins, weekly wins and awards land here automatically.
  <% if (isCommish) { %><a href="/admin/ledger.csv">⬇️ Download the whole register (CSV)</a><% } %>
</p>

<%- include('partials/footer') %>
