<%- include('partials/header', { title: 'The Matchup' }) %>
<%
  const fmtLock = d => {
    if (!d) return '';
    // Always New York — the NFL kicks off Eastern and half this league is not,
    // so a bare "8:15pm" is a trap.
    return new Date(d).toLocaleString('en-US', { timeZone: 'America/New_York',
      weekday: 'short', hour: 'numeric', minute: '2-digit' }) + ' ET';
  };
  const r = record;                         // head-to-head summary (may be null)
  // Who's ahead, said in plain words from the viewer's side.
  let lead = null;
  if (r && r.played) {
    if (r.a.wins > r.b.wins) lead = { who: 'you', text: `You lead ${r.a.wins}–${r.b.wins}${r.ties ? '–' + r.ties : ''}` };
    else if (r.b.wins > r.a.wins) lead = { who: 'them', text: `${opp.name} leads ${r.b.wins}–${r.a.wins}${r.ties ? '–' + r.ties : ''}` };
    else lead = { who: 'even', text: `All square ${r.a.wins}–${r.b.wins}${r.ties ? '–' + r.ties : ''}` };
  }
%>

<h1 class="page-title">⚔️ The Matchup <span class="sub" style="font-weight:600">Week <%= weekNo %></span></h1>

<% if (sent) { %>
  <div class="alert-banner" style="margin-bottom:1rem; border-color:rgba(74,222,128,.5)">
    <span class="tag">✅</span><span>Bet sent<% if (opp) { %> to <b><%= opp.name %></b><% } %>. It's in the ledger as <b>OPEN</b> —
    it locks in once they accept, and closes at kickoff. You'll both see who won.</span>
  </div>
<% } %>
<% if (late) { %>
  <div class="alert-banner alert-warning" style="margin-bottom:1rem">
    <span class="tag">⏰</span><span>Too late — that game already started, so the bet couldn't be accepted. Nobody's money moved.</span>
  </div>
<% } %>

<%# ── No opponent yet: let them pick one so H2H + the bet still work ────────── %>
<% if (!opp) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>Who are you looking at? <span class="sub"><%= live ? '' : (configured ? "no live matchup yet — the season hasn't started, or Sleeper isn't mapped" : "Sleeper isn't connected yet") %></span></h2>
    <div class="body">
      <p class="muted" style="margin:0 0 .8rem">Pick an opponent to see your all-time record against them and put a bet up.</p>
      <form method="get" action="/matchup" class="inline-form">
        <div class="fit">
          <label class="field">Opponent
            <select name="opp" onchange="this.form.submit()">
              <option value="">Pick someone…</option>
              <% for (const o of owners) { if (o.id === me.id) continue; %>
                <option value="<%= o.id %>"><%= o.name %></option>
              <% } %>
            </select>
          </label>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (opp) { %>
<%# ── The scoreboard tile ──────────────────────────────────────────────────── %>
<div class="card matchup-card" style="margin-bottom:1.2rem">
  <div class="body">
    <div class="mu">
      <div class="mu-side <%= (matchup && matchup.me && matchup.me.points > matchup.opp.points) ? 'up' : '' %>">
        <span class="mu-team"><%= (matchup && matchup.me && matchup.me.team) || me.team_name || 'Your team' %></span>
        <span class="mu-pts"><%= (matchup && matchup.me) ? matchup.me.points.toFixed(2) : '—' %></span>
        <span class="mu-who">you</span>
      </div>
      <div class="mu-vs">vs</div>
      <div class="mu-side <%= (matchup && matchup.opp && matchup.opp.points > matchup.me.points) ? 'up' : '' %>">
        <span class="mu-team"><%= (matchup && matchup.opp && matchup.opp.team) || opp.team_name || opp.name + "'s team" %></span>
        <span class="mu-pts"><%= (matchup && matchup.opp) ? matchup.opp.points.toFixed(2) : '—' %></span>
        <span class="mu-who"><%= opp.name %><%- include('partials/_owner_badges', { name: opp.name }) %></span>
      </div>
    </div>
    <% if (typeof defendingChamps !== 'undefined' && defendingChamps.indexOf(opp.name) !== -1) { %>
      <p class="mu-champ-note">👑 You're playing the champ — <b><%= opp.name %></b> is defending the <%= reigningYear %> title. Knock the crown off.</p>
    <% } %>
    <% if (!live) { %>
      <p class="muted" style="text-align:center; margin:.7rem 0 0; font-size:.76rem">
        No live scoreboard<%= configured ? ' for this week yet' : ' (Sleeper not connected)' %> — showing the head-to-head and letting you bet it.
      </p>
    <% } %>
  </div>
</div>

<%# ── HEAD TO HEAD — the centrepiece ───────────────────────────────────────── %>
<div class="card h2h-card" style="margin-bottom:1.2rem">
  <h2>📈 Head to Head <span class="sub">all-time, since the Sleeper era (2023)</span></h2>
  <div class="body">
    <% if (!r || !r.played) { %>
      <p class="muted" style="margin:0">No games on record against <b><%= opp.name %></b> yet — this is your first meeting since the box scores begin (2023). Everything before that lives in the <a href="/history">league history</a>.</p>
    <% } else { %>
      <div class="h2h-hero">
        <a class="h2h-lead-link" href="/rivalry?b=<%= encodeURIComponent(opp.name) %>" title="Every game you've ever played against <%= opp.name %>">
          <div class="h2h-lead <%= lead.who === 'you' ? 'you' : (lead.who === 'them' ? 'them' : 'even') %>"><%= lead.text %> <span class="h2h-lead-cue">→</span></div>
        </a>
        <% if (r.streak) { %>
          <div class="h2h-streak"><%= r.streak.who === 'a' ? 'You have' : opp.name + ' has' %> won <b><%= r.streak.n %></b> straight<% if (r.streak.n >= 3) { %> 🔥<% } %></div>
        <% } %>
        <div class="h2h-span muted"><%= r.played %> game<%= r.played === 1 ? '' : 's' %> · <%= r.firstSeason %>–<%= r.lastSeason %><% if (r.playoffs) { %> · <b><%= r.playoffs %></b> in the playoffs<% } %><% if (r.close) { %> · <%= r.close %> under 5<% } %></div>
      </div>

      <div class="h2h-stats">
        <div class="h2h-stat">
          <span class="h2h-stat-lbl">Avg points</span>
          <span class="h2h-stat-val"><%= r.a.avg.toFixed(1) %> <span class="muted">– </span><%= r.b.avg.toFixed(1) %></span>
          <span class="h2h-stat-sub">you – <%= opp.name %></span>
        </div>
        <div class="h2h-stat">
          <span class="h2h-stat-lbl">Your best</span>
          <span class="h2h-stat-val"><%= r.a.biggest ? ('+' + r.a.biggest.margin.toFixed(1)) : '—' %></span>
          <span class="h2h-stat-sub"><%= r.a.biggest ? (r.a.biggest.season + ' wk' + r.a.biggest.week) : 'no wins yet' %></span>
        </div>
        <div class="h2h-stat">
          <span class="h2h-stat-lbl">Their best</span>
          <span class="h2h-stat-val"><%= r.b.biggest ? ('+' + r.b.biggest.margin.toFixed(1)) : '—' %></span>
          <span class="h2h-stat-sub"><%= r.b.biggest ? (r.b.biggest.season + ' wk' + r.b.biggest.week) : 'no wins yet' %></span>
        </div>
      </div>

      <a class="h2h-full-link" href="/rivalry?b=<%= encodeURIComponent(opp.name) %>">
        📜 Every meeting, scored — the full rivalry <span class="muted">(<%= r.played %> game<%= r.played === 1 ? '' : 's' %>)</span> →
      </a>
    <% } %>
  </div>
</div>

<%# ── One-tap bet against them ─────────────────────────────────────────────── %>
<div class="card matchup-card" style="margin-bottom:1.2rem">
  <h2>🤝 Bet <%= opp.name %> on it <span class="sub">straight up, this week</span></h2>
  <div class="body">
    <% if (!betWindow.open) { %>
      <p class="mu-closed">🔒 <%= betWindow.reason %> Bets on week <%= weekNo %> are closed.</p>
    <% } else { %>
      <form method="post" action="/sidebets" class="inline-form">
        <input type="hidden" name="format" value="prop">
        <input type="hidden" name="kind" value="matchup">
        <input type="hidden" name="back" value="matchup">
        <input type="hidden" name="party" value="<%= opp.id %>">
        <input type="hidden" name="resolves" value="end of week <%= weekNo %>">
        <%# The condition the bet builder would have produced, prefilled — same
            field names, same parser, a shortcut into the same machinery. %>
        <input type="hidden" name="cond_test" value="outscores">
        <input type="hidden" name="cond_subject" value="<%= me.id %>">
        <input type="hidden" name="cond_target_owner" value="<%= opp.id %>">
        <input type="hidden" name="cond_when" value="week">
        <input type="hidden" name="cond_week" value="<%= weekNo %>">
        <input type="hidden" name="logic" value="all">
        <div class="fit">
          <label class="field">Wager each
            <input type="number" name="stake" step="1" min="1" placeholder="20" required style="width:6.5rem">
          </label>
        </div>
        <div class="fit"><button class="btn gold" type="submit">Send it to <%= opp.name %></button></div>
      </form>
      <p class="muted" style="margin:.55rem 0 0; font-size:.78rem">
        Straight up: <b>your team outscores <%= opp.name %> in week <%= weekNo %></b>, settled when the week ends.
        They have to accept, and <b>acceptance closes <%= fmtLock(betWindow.locks_at) %></b> — once football starts nobody can take it.
        The site grades it and tells you both who won.
      </p>
    <% } %>
  </div>
</div>

<%# ── THE WEEKLY HIGH — the $100 target, live ──────────────────────────────────
    Two data sources, best first. A's richer live band (typical + leader + your
    live score) wins when present; otherwise the harvested band (what it has
    taken to win the $100 across three seasons — a league-visible RESULT) plus
    THIS week's race off the scoreboard. Either way the manager sees the bar and
    how far off it they are, on the page where they're already thinking about the
    week. Only truly absent when there's no band at all. %>
<% if (highBand) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>🎯 The Weekly High <span class="sub">the $100 band this week</span></h2>
    <div class="body">
      <p style="margin:0"><b><%= highBand.leader != null ? highBand.leader.toFixed(1) : '—' %></b> leads ·
        typical winning score <b><%= highBand.typical != null ? highBand.typical.toFixed(1) : '—' %></b><% if (highBand.mine != null) { %> ·
        you're at <b><%= highBand.mine.toFixed(1) %></b> (<%= (highBand.mine - highBand.typical >= 0 ? '+' : '') + (highBand.mine - highBand.typical).toFixed(1) %> vs typical)<% } %></p>
    </div>
  </div>
<% } else if (whBand && whBand.n) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>🎯 The Weekly High <span class="sub">the $100 you can also win this week</span></h2>
    <div class="body">
      <% if (whRace) {
           const pct = whRace.top ? Math.max(4, Math.min(100, Math.round((whRace.mine || 0) / whRace.top * 100))) : 0;
           const toBar = whRace.mine != null ? (whBand.median - whRace.mine) : null; %>
        <div class="wh-race">
          <div class="wh-race-top">
            <span class="wh-race-lead"><%= whRace.iLead ? '🟢 You lead week ' + whRace.week : '🏈 ' + whRace.leaderName + ' leads week ' + whRace.week %> · <b><%= whRace.top.toFixed(1) %></b></span>
            <% if (whRace.mine != null && !whRace.iLead) { %><span class="wh-race-gap muted">you're <%= (whRace.top - whRace.mine).toFixed(1) %> back of the lead</span><% } %>
          </div>
          <div class="wh-race-bar"><div class="wh-race-fill<%= whRace.iLead ? ' lead' : '' %>" style="width:<%= pct %>%"></div></div>
          <div class="wh-race-scale muted"><span>you: <%= whRace.mine != null ? whRace.mine.toFixed(1) : '—' %></span><span>$100 at the top</span></div>
        </div>
        <p class="wh-band-note" style="margin:.7rem 0 0">
          Typically <b><%= Math.round(whBand.median) %></b> wins the week (three-season range <%= Math.round(whBand.min) %>–<%= Math.round(whBand.max) %>).
          <% if (toBar != null && toBar > 0) { %>You're <b><%= toBar.toFixed(1) %></b> short of that bar.<% } else if (toBar != null) { %>You're <b>already past</b> the typical winning score — hold on.<% } %>
        </p>
      <% } else { %>
        <p class="wh-band-note" style="margin:0">🎯 <b>$100</b> to the week's top score, on top of this matchup. The bar, from three seasons: typically <b><%= Math.round(whBand.median) %></b> wins it — range <%= Math.round(whBand.min) %>–<%= Math.round(whBand.max) %>. It comes alive here once games are on.</p>
      <% } %>
    </div>
  </div>
<% } %>
<% if (perPlayer && (perPlayer.me || perPlayer.opp)) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>🏈 Starters <span class="sub">points<%= proj ? ' vs projection' : '' %></span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>You</th><th class="num">Pts</th><% if (proj) { %><th class="num">Proj</th><% } %><th><%= opp.name %></th><th class="num">Pts</th><% if (proj) { %><th class="num">Proj</th><% } %></tr>
        <% const rowsMe = perPlayer.me || []; const rowsOpp = perPlayer.opp || []; const n = Math.max(rowsMe.length, rowsOpp.length); %>
        <% for (let i = 0; i < n; i++) { const a = rowsMe[i] || {}; const b = rowsOpp[i] || {}; %>
          <tr>
            <td><%= a.name || '' %></td><td class="num"><%= a.points != null ? a.points.toFixed(1) : '' %></td>
            <% if (proj) { %><td class="num muted"><%= a.proj != null ? a.proj.toFixed(1) : '' %></td><% } %>
            <td><%= b.name || '' %></td><td class="num"><%= b.points != null ? b.points.toFixed(1) : '' %></td>
            <% if (proj) { %><td class="num muted"><%= b.proj != null ? b.proj.toFixed(1) : '' %></td><% } %>
          </tr>
        <% } %>
      </table>
    </div>
  </div>
<% } %>

<% } %><%# /opp %>

<p style="text-align:center; margin-top:1rem">
  <a class="btn navy" href="/team?section=week">← Full team &amp; roster</a>
</p>
<%- include('partials/footer') %>
