<%- include('partials/header', { title: 'My Account' }) %>
<div class="login-box">
  <div class="card">
    <h2>Change Password</h2>
    <div class="body">
      <% if (forced) { %>
        <div class="flash-note">Welcome, <%= owner.name %>! Set a new password of your own before entering the league office.</div>
      <% } %>
      <% if (error) { %><div class="error-note"><%= error %></div><% } %>
      <form method="post" action="/password">
        <% if (!forced) { %>
        <label class="field" for="current">Current password</label>
        <input type="password" id="current" name="current" autocomplete="current-password" required>
        <% } %>
        <label class="field" for="next">New password (8+ characters)</label>
        <input type="password" id="next" name="next" autocomplete="new-password" minlength="8" required>
        <label class="field" for="confirm">Confirm new password</label>
        <input type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="8" required>
        <div style="margin-top:1rem; text-align:center">
          <button class="btn gold" type="submit">Save Password</button>
        </div>
      </form>
    </div>
  </div>
  <% if (!forced) { %>
  <div class="card" style="margin-top:1.2rem">
    <h2>My Email</h2>
    <div class="body">
      <% if (typeof saved !== 'undefined' && saved) { %><div class="flash-note">Email saved — you can log in with it now.</div><% } %>
      <form method="post" action="/profile">
        <label class="field" for="email">Email (optional — lets you log in with it instead of your username)</label>
        <input type="text" id="email" name="email" value="<%= owner.email || '' %>" placeholder="you@example.com">
        <div style="margin-top:.8rem; text-align:center"><button class="btn navy" type="submit">Save Email</button></div>
      </form>
    </div>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
