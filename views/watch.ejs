<%- include('partials/header', { title: 'What to Watch' }) %>
<%- include('partials/_live_stale') %>
<%
  const meId = me.id;
  const bar = p => Math.max(2, Math.min(100, Math.round(p * 100)));
  // Tap-through, same rule as the scoreboard: YOUR game opens your full matchup
  // (bet, trash, starters); anyone else's opens the read-only spectator view of
  // that exact pairing. Null when we don't have the opponent id (preview edge) —
  // the row then renders as a plain, non-clickable block rather than a dead link.
  const rowLink = r => r.owner_id === meId
    ? (r.opp_id != null ? '/matchup?opp=' + r.opp_id : '/matchup')
    : (r.opp_id != null ? '/matchup?a=' + r.owner_id + '&b=' + r.opp_id : null);
%>

<h1 class="page-title">📺 What to Watch <span class="sub" style="font-weight:600">Week <%= weekNo %></span></h1>

<% if (source === 'preview') { %>
  <div class="alert-banner" style="margin-bottom:1rem; border-color:rgba(245,196,69,.5)">
    <span class="tag">🎭</span><span><b>Rehearsal.</b> Sample data, so the first live Sunday isn't the first time this panel has ever run. The real thing lights up Sunday & Monday nights, off the live scoreboard.</span>
  </div>
<% } %>

<% if (!rows.length) { %>
  <div class="card"><div class="body">
    <p class="muted" style="margin:0">
      <% if (!inWindow) { %>Nothing on right now. This panel is for <b>Sunday and Monday nights</b> — when there are games on and players still on the field, it shows exactly what everyone needs, live. <a href="/watch?preview=1">Preview it →</a>
      <% } else { %>Games are scheduled but nobody's scored yet. The sweat meter comes alive the moment the ball's in the air. <a href="/watch?preview=1">Preview it →</a><% } %>
    </p>
  </div></div>
<% } else { %>

  <% if (band && band.median) { %>
    <p class="wtw-band muted">🎯 The $100 is out there too — it usually takes <b><%= Math.round(band.median) %></b> to win the week.</p>
  <% } %>

  <%# ── THE SWING BOARD header — the league-wide layer: how many games can
      still move a race tonight. Each game's one-line stake rides on its row. %>
  <% if (typeof stakesOn !== 'undefined' && stakesOn > 0) { %>
    <p class="wtw-swing-head">🏁 <b>The swing board:</b> <%= stakesOn %> game<%= stakesOn === 1 ? '' : 's' %> on this slate can still move a race — the stake is on each one.</p>
  <% } %>

  <%# Your own game first — the panel sorts by watchability, which can bury YOUR
      matchup at the bottom on a blowout. Pin it, then the rest most-watchable. %>
  <%# ONE ROW PER GAME. The panel is built from per-OWNER entries, so every game
      arrived twice — "Cory vs Marian 48%" and "Marian vs Cory 52%" are the same
      game, and the page rendered ten rows for five games (found by driving it).
      Your own game is pinned first from your side; each other game appears ONCE,
      keeping the first (most-watchable) occurrence. %>
  <% const mineRow = rows.find(r => r.owner_id === meId);
     const _seenGame = new Set();
     const _gameKey = r => [Number(r.owner_id), Number(r.opp_id)].sort((a, b) => a - b).join('-');
     if (mineRow) _seenGame.add(_gameKey(mineRow));
     const others = rows.filter(r => {
       if (r.owner_id === meId) return false;
       if (r.opp_id == null) return true;            // no pair id — can't dedupe, keep it
       const k = _gameKey(r);
       if (_seenGame.has(k)) return false;
       _seenGame.add(k);
       return true;
     });
     const ordered = mineRow ? [mineRow, ...others] : others; %>
  <div class="wtw-list">
    <% ordered.forEach((r, i) => { const mine = r.owner_id === meId; %>
      <% if (mineRow && i === 0) { %><div class="wtw-sec">Your game</div><% } %>
      <%# The "around the league" header used to be tied to i === 1, so a week
          where you aren't on the slate rendered the whole list with no header
          at all. Show it at the top of the others list either way. %>
      <% if (i === (mineRow ? 1 : 0)) { %><div class="wtw-sec">Around the league — most watchable first</div><% } %>
      <% const _lnk = rowLink(r); const _tag = _lnk ? 'a' : 'div'; %>
      <<%= _tag %> class="wtw-row <%= r.label.level %><%= mine ? ' mine' : '' %><%= _lnk ? ' clickable' : '' %>"<% if (_lnk) { %> href="<%= _lnk %>" title="<%= mine ? 'Open your matchup' : 'See ' + r.name + ' vs ' + r.oppName %>"<% } %>>
        <div class="wtw-top">
          <span class="wtw-icon" aria-hidden="true"><%= r.label.icon %></span>
          <span class="wtw-who"><b><%= r.name %></b><% if (mine) { %> <span class="pk-you">you</span><% } %> <span class="muted">vs <%= r.oppName %></span></span>
          <%# NEVER A FLAT 0% OR 100% WITH THE BALL IN THE AIR. This printed
              Math.round(pWin * 100), so the rehearsal — the only place this
              panel has ever been read — showed "0%" for a team 53 points down
              with a player still on the field and "100%" for its opponent. The
              sweat meter is a Normal model, not a result: 1.3e-14 is its
              opinion about a big hole, and rounding that to a bare zero ends a
              game the page is there to make you watch. Same formatter as the
              /matchup stakes line, never exact, because a live probability
              never is. %>
          <% if (r.pWin != null) { %><span class="wtw-pct"><%= pctText(r.pWin) %></span><% } %>
          <% if (_lnk) { %><span class="wtw-cue" aria-hidden="true">→</span><% } %>
        </div>
        <%# THE SCORE. It was computed on every row and rendered on none — on a
            page called What to Watch, during the game, you could not see the
            score. It leads now, because it is the one number that is real
            whether or not the projection feed exists. %>
        <%# One decimal on every figure. These are r1()'d numbers, so a whole
            score printed as "58 – 118.3" next to "88.4 – 87.9" — the same
            quantity rendered two ways down one column. %>
        <% const sc = n => Number(n).toFixed(1); %>
        <div class="wtw-score"><b><%= sc(r.live) %></b><span class="wtw-dash">–</span><b><%= sc(r.oppLive) %></b><% if (r.remainKnown && (r.playersLeft || r.oppPlayersLeft)) { %> <span class="wtw-proj">projected <%= sc(r.myProj) %>–<%= sc(r.oppProj) %></span><% } %></div>
        <% if (r.pWin != null) { %>
          <div class="wtw-meter"><div class="wtw-fill" style="width:<%= bar(r.pWin) %>%"></div></div>
        <% } %>
        <div class="wtw-need">
          <span class="wtw-word <%= r.label.level %>"><%= r.label.word %></span>
          · <%= r.need %>
          <% if (r.highP != null && r.highP >= 0.05) { %> · <span class="wtw-high">🎯 <%= pctText(r.highP) %> at the $100</span><% } %>
        </div>
        <%# The league-wide stake: what THIS game changes in the races — real
            standings arithmetic (whatwatch.gameStake), never vibes. %>
        <% if (r.stake) { %><div class="wtw-stake">🏁 <%= r.stake %></div><% } %>
      </<%= _tag %>>
    <% }) %>
  </div>

  <p class="muted" style="margin:1rem 0 0; font-size:.76rem">
    <% if (ordered.some(r => r.pWin == null)) { %>
      <b>Scores are live and exact.</b> The sweat meter — your chance of winning from here — needs
      the per-player feed to know who is still on the field, and that isn't wired up yet, so this
      panel is ranking by how close each game is on the board. It turns into the real meter on its
      own the week the feed lands. <a href="/watch?preview=1">See what that looks like →</a>
    <% } else { %>
      Sweat = your live score plus what your players left are projected to add, against the same for your opponent.
    <% } %>
  </p>
<% } %>

<p style="text-align:center; margin-top:1rem">
  <a class="btn navy" href="/matchup">⚔️ Your matchup</a>
  <a class="btn navy" href="/pickem">🗳️ Pick'em</a>
</p>
<%- include('partials/footer') %>
