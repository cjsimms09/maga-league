<%- include('partials/header', { title: 'Lineup Optimizer' }) %>
<%# THE ONE PAGE THAT TURNS STALE DATA INTO A DOLLAR RECOMMENDATION was the one
    page without this banner. dashboard, matchup, watch and scoreboard all had
    it; the optimizer did not — so when Sleeper was down, the four pages showing
    numbers said "not live" and the page telling you what to START said nothing.
    Found by driving a failed-fetch week. %>
<%- include('partials/_live_stale') %>
<%
  const money0 = n => '$' + Math.round(Number(n || 0)).toLocaleString('en-US');
  const signed = n => (n >= 0 ? '+' : '') + money0(n);
  const SRC_LABEL = {
    sleeper: 'live projections',
    'season-avg': "this season's per-game average (live projections drop in when Sleeper supplies them)",
    'last-week': "last week's points (a stopgap until projections land)",
    none: 'no projection data yet',
  };
%>

<h1 class="page-title">🎯 Lineup Optimizer
  <span class="sub" style="font-weight:600">the money you leave on the bench</span></h1>

<nav class="section-tabs">
  <a href="/lineup?tab=live" class="<%= tab === 'live' ? 'active' : '' %>">
    <b>▶ This Week</b><span>your dollar-optimal lineup</span>
  </a>
  <a href="/lineup?tab=proof" class="<%= tab === 'proof' ? 'active' : '' %>">
    <b>📊 The Proof</b><span>validated on 2023–25, to the dollar</span>
  </a>
</nav>

<% if (logged) { %>
  <div class="alert-banner" style="margin-bottom:1rem; border-color:rgba(74,222,128,.5)">
    <span class="tag">✅</span><span>Logged. The recommendation and what you'd have played instead are both in the
    ledger — January grades the difference in dollars.</span>
  </div>
<% } %>
<% if (typeof overrode !== 'undefined' && overrode) { %>
  <div class="alert-banner" style="margin-bottom:1rem; border-color:rgba(185,130,42,.5)">
    <span class="tag">🙋</span><span>Override recorded — the tool's call and the dollar gap are both in the ledger.
    That's the disagreement written down at decision time, which is the only moment it can be.</span>
  </div>
<% } %>
<% if (typeof sent !== 'undefined' && sent) { %>
  <div class="alert-banner" style="margin-bottom:1rem; border-color:rgba(74,222,128,.5)">
    <span class="tag">📣</span><span>Sunday alert sent to your inbox<%= (typeof emailOn !== 'undefined' && !emailOn) ? ' (email isn\'t configured yet, so it was a dry run)' : '' %>.</span>
  </div>
<% } %>

<% if (tab === 'live') { %>
  <% if (!live) { %>
    <div class="card"><div class="body">
      <p class="muted" style="margin:0 0 .6rem">
        <% if (!configured) { %>Sleeper isn't connected yet (Commish → Sleeper), so there's no live roster to optimize.
        <% } else { %>No live roster yet — the season hasn't started, or your team isn't mapped (Commish → Sleeper → Team Mapping).<% } %>
      </p>
      <p style="margin:0">The optimizer is <b>proven and ready</b> — see <a href="/lineup?tab=proof">The Proof</a>,
        validated to the dollar on 2023–25. It goes live the moment there's a roster and a slate.</p>
    </div></div>
  <% } else { %>
    <%# ── THE CALL: chase the $100 or protect the matchup — the week's one real
        decision, stated plainly, first (the war-room lesson). ──────────────── %>
    <% if (posture) { %>
      <div class="card lo-verdict lo-<%= posture.mode %>" style="margin-bottom:1.1rem">
        <div class="body">
          <div class="lo-verdict-head">
            <span class="lo-verdict-tag"><%= posture.mode === 'chase' ? '🎯 CHASE' : posture.mode === 'pending' ? '⏳ PENDING' : '🛡️ PROTECT' %></span>
            <span class="lo-verdict-line"><%= posture.headline %></span>
          </div>
          <p class="lo-verdict-why"><%= posture.why %></p>
          <p class="muted lo-src">Projections: <%= SRC_LABEL[projSource] || 'unknown source' %>.<% if (!live.projPending && projSource && projSource !== 'sleeper') { %> <b>Treat the dollar figures as directional, not precise, until live projections land.</b><% } %><% if (!live.projPending && !live.oppKnown) { %> Opponent modelled as a <b>typical team score (<%= Math.round((live.assumptions && live.assumptions.oppMean) || 0) %>)</b> until theirs lands — not the week's winning score, which would make every week look like a long shot.<% } %></p>
        </div>
      </div>
    <% } %>

    <%# ── Play this — the action ───────────────────────────────────────────── %>
    <div class="card" style="margin-bottom:1.1rem">
      <h2>✅ Play This <span class="sub"><% if (live.projPending) { %>projections pending — probabilities light up at kickoff<% } else { %>projected <%= live.ev.mean.toFixed(1) %> · P($100) <%= Math.round(live.ev.pHigh * 100) %>%<% if (live.ev.pWin != null) { %> · P(win) <%= Math.round(live.ev.pWin * 100) %>%<% } %><% } %></span></h2>
      <div class="body tight">
        <%# The variance play(s): every player the solver started OVER a higher-floor
            stud (the calls) is the ceiling bet. Mark them so "chase" is concrete —
            you see exactly who the boom is, not just that there is one. %>
        <% const chasePids = new Set((live.calls || []).map(c => String(c.startId))); %>
        <table class="roll">
          <tr><th>Slot</th><th>Player</th><th>Pos</th><th class="num">Proj</th></tr>
          <% live.lineup.forEach(s => { const chase = chasePids.has(String(s.pid)); %>
            <tr class="<%= chase ? 'lo-chase-row' : '' %>"><td class="muted"><%= s.slot %></td><td><b><%= s.name %></b><% if (chase) { %> <span class="lo-chase-badge">🎯 the chase</span><% } %></td><td class="muted"><%= s.pos %></td><td class="num"><%= Number(s.proj).toFixed(1) %></td></tr>
          <% }) %>
        </table>
        <%# Explain any absence: a player ruled OUT or on bye is zeroed by the
            guard, so a stud can vanish from the lineup. Say why, so it reads as
            a deliberate sit, not a bug. %>
        <% if (live.inactive && live.inactive.length) { %>
          <p class="lo-inactive muted">🚫 Not eligible this week (can't score, left out):
            <%= live.inactive.map(p => p.name + ' (' + p.reason + ')').join(' · ') %>.</p>
        <% } %>
        <%# ...and the ones it KEPT while they carry a tag. Naming only the
            zeroed players left the genuinely uncertain starter unmentioned on
            the exact day you set the lineup. The projection is used in full
            because that is what the feed says; the doubt is stated so it is
            your call, not a silent one. %>
        <% if (live.questionable && live.questionable.length) { %>
          <p class="lo-questionable">⚠️ Started at full projection but tagged:
            <%= live.questionable.map(p => p.name + ' (' + p.tag + ')').join(' · ') %>.
            <span class="muted">Sleeper hasn't ruled them out, so the projection stands — check the news before kickoff.</span></p>
        <% } %>
      </div>
    </div>

    <%# ── YOUR LINEUP vs THE RECOMMENDATION — the actual to-do list ───────────
        The card below this one compares the two MODEL lineups (recommended vs
        highest-projection), which is a property of the optimizer and was being
        read as a to-do list. It is empty exactly when the two optima agree —
        including on a week when the lineup you have SET is wrong, because the
        solver never received it. Bench your best receiver and the page said
        "Nothing to change this week… the tool agrees with you."
        `live.set` is the comparison against what is actually started. It leads,
        because it is the only thing on this page you can act on. %>
    <% if (live.set && !live.set.matches && live.set.changes.length) { %>
      <div class="card lo-todo" style="margin-bottom:1.1rem; border-color:#d4242f">
        <h2>⚠️ Your lineup isn't the recommended one
          <span class="sub"><%= live.set.changes.length %> change<%= live.set.changes.length === 1 ? '' : 's' %> to make<% if (live.set.dollars > 0.5) { %> · worth <%= money0(live.set.dollars) %><% } %></span></h2>
        <div class="body">
          <% live.set.changes.forEach(c => { %>
            <div class="lo-call">
              <div class="lo-call-main">
                <span class="lo-start">▲ Start <b><%= c.startName %></b> <span class="muted">(<%= c.startPos %>, proj <%= c.startProj != null ? c.startProj.toFixed(1) : '—' %>)</span></span>
                <span class="lo-sit">▼ over <b><%= c.sitName %></b> <span class="muted">(<%= c.sitPos %>, proj <%= c.sitProj != null ? c.sitProj.toFixed(1) : '—' %>)</span></span>
              </div>
              <div class="lo-call-price">
                <span class="lo-dollars <%= c.dollars >= 0 ? 'money-up' : 'money-down' %>"><%= signed(c.dollars) %></span>
                <span class="lo-split muted"><%= (c.startProj - c.sitProj) >= 0 ? '+' : '' %><%= (c.startProj - c.sitProj).toFixed(1) %> projected</span>
              </div>
            </div>
          <% }) %>
          <p class="muted" style="margin:.6rem 0 0; font-size:.78rem">
            Read off the lineup Sleeper currently has set for you. Make the swaps there — the site doesn't write to Sleeper.
          </p>
        </div>
      </div>
    <% } %>

    <%# ── What changed vs your studs — the priced moves, secondary ────────────
        MEASURED CONTEXT (A, 2026-08-10): the dual-objective optimizer deviates
        from "start your highest projections" only ~11% of weeks, worth ~$9/season.
        So the NO-CHANGE week is the normal one — nine in ten. This card used to
        vanish on those weeks, which is the worst of both: the page silently
        changes shape, and the rare week when it DOES speak looks like the
        default. Say the quiet answer out loud instead, and let the loud one earn
        its noise. %>
    <% if (!live.calls || !live.calls.length) { %>
      <div class="card lo-nochange" style="margin-bottom:1.1rem">
        <div class="body">
          <%# ONLY CLAIM WHAT WAS CHECKED. "the tool agrees with you" was said off
              an empty `calls` array, which is a statement about the two model
              lineups and not about yours. Three sentences for three states. %>
          <p style="margin:0"><b>✅ Nothing to change this week.</b>
            <% if (live.set && live.set.matches) { %>
              The lineup you have set <i>is</i> the dollar-optimal one — checked against Sleeper, player for player.
            <% } else if (live.set) { %>
              Your highest-projection lineup is already the dollar-optimal one.
            <% } else { %>
              Your highest-projection lineup is already the dollar-optimal one.
              <span class="muted">(Your live Sleeper lineup wasn't readable, so this compares the two model lineups — not yours.)</span>
            <% } %></p>
          <p class="muted" style="margin:.45rem 0 0; font-size:.78rem">
            That's the normal week. Starting your best projections is the right call about
            <b>9 weeks in 10</b>; the optimizer only finds a better lineup ~11% of the time
            (worth ~$9 across a season). When it does, this card fills with the specific
            swap and what it's worth — so a week with moves in it is worth a second look.
          </p>
        </div>
      </div>
    <% } else { %>
      <div class="card" style="margin-bottom:1.1rem">
        <h2>🔀 What changed vs your studs <span class="sub">each move priced in dollars — a rare week</span></h2>
        <div class="body">
          <% live.calls.forEach(c => { %>
            <div class="lo-call">
              <div class="lo-call-main">
                <%# proj can be null when the feed hasn't landed for a player — a bare
                    .toFixed() here 500s the whole page (caught by the C3 null case). %>
                <span class="lo-start">▲ Start <b><%= c.startName %></b> <span class="muted">(<%= c.startPos %>, proj <%= c.startProj != null ? c.startProj.toFixed(1) : '—' %>)</span></span>
                <span class="lo-sit">▼ over <b><%= c.sitName %></b> <span class="muted">(<%= c.sitPos %>, proj <%= c.sitProj != null ? c.sitProj.toFixed(1) : '—' %>)</span></span>
              </div>
              <div class="lo-call-price">
                <span class="lo-dollars <%= c.dollars >= 0 ? 'money-up' : 'money-down' %>"><%= signed(c.dollars) %></span>
                <span class="lo-split muted">
                  <%= c.dollarsHigh >= 0 ? '+' : '' %><%= money0(c.dollarsHigh) %> high-chase ·
                  <%= c.dollarsWin >= 0 ? '+' : '' %><%= money0(c.dollarsWin) %> win-prob
                </span>
              </div>
              <%# C3 — THE DISAGREEMENT MOMENT. When the tool starts the LOWER-
                  projection player, both numbers must be on screen: that is exactly
                  when the machinery is either finding something real (variance the
                  mean can't see) or is broken, and one number can't tell you which.
                  Silent when the recommendation also has the higher projection. %>
              <% if (c.startProj != null && c.sitProj != null && c.startProj < c.sitProj) { %>
                <div class="lo-call-disagree">
                  ⚖️ <b>Lower projection, higher dollars.</b>
                  <%= c.startName %> projects <b><%= c.startProj.toFixed(1) %></b> vs
                  <%= c.sitName %>'s <b><%= c.sitProj.toFixed(1) %></b>
                  (<%= (c.sitProj - c.startProj).toFixed(1) %> fewer pts) — the dollars come from
                  variance, not points. <span class="muted">Raw projection, <%= SRC_LABEL[projSource] || 'source unknown' %> — not our valuation.</span>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <%# ── Log the decision (writes to the ledger with its counterfactual) ───── %>
    <form method="post" action="/lineup/log" class="card" style="margin-bottom:1rem">
      <div class="body" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap">
        <div>
          <b>Playing this?</b> <span class="muted" style="font-size:.82rem">Logs the call + what you'd have played instead, so January can grade the difference.</span>
        </div>
        <input type="hidden" name="week" value="<%= (matchup && matchup.week) || '' %>">
        <input type="hidden" name="dollars" value="<%= live.edge %>">
        <input type="hidden" name="opp_mean" value="<%= (live && live.ev && band) ? Math.round(band.median) : '' %>">
        <input type="hidden" name="confidence" value="<%= live.confidence.replace(/"/g, '&quot;') %>">
        <input type="hidden" name="recommended" value="<%= JSON.stringify(live.lineup.map(s => ({ id: s.pid, name: s.name, pos: s.pos, proj: s.proj }))).replace(/"/g, '&quot;') %>">
        <input type="hidden" name="counterfactual" value="<%= JSON.stringify(live.naive.map(s => ({ id: s.pid, name: s.name, pos: s.pos, proj: s.proj }))).replace(/"/g, '&quot;') %>">
        <button class="btn gold" type="submit">Log this lineup</button>
      </div>
    </form>

    <%# ── ...AND THE OVERRIDE. The page could only record AGREEMENT: press "Log
        this lineup" and the call is preserved, go against it and there was no
        button at all, so every disagreement left no trace. `inseason_override`
        has been a registered ledger kind the whole time with nothing writing one.
        Each chip is itself the submit button, so picking a reason IS the tap
        rather than a step after it — an override you have to reconstruct later
        is worth almost nothing, so the capture never costs more than one press. %>
    <form method="post" action="/lineup/override" class="card lo-override" style="margin-bottom:1rem">
      <div class="body">
        <div style="margin-bottom:.55rem">
          <b>Not playing it?</b>
          <span class="muted" style="font-size:.82rem">One tap says why. The gap is <b><%= live.edge >= 0 ? '$' : '−$' %><%= Math.abs(Math.round(live.edge)) %></b>
            <% if (Math.abs(live.edge) < 2) { %>— close enough that going the other way costs about nothing<% } %>.</span>
        </div>
        <input type="hidden" name="week" value="<%= (matchup && matchup.week) || '' %>">
        <input type="hidden" name="dollars" value="<%= live.edge %>">
        <input type="hidden" name="confidence" value="<%= live.confidence.replace(/"/g, '&quot;') %>">
        <input type="hidden" name="recommended" value="<%= JSON.stringify(live.lineup.map(s => ({ id: s.pid, name: s.name, pos: s.pos, proj: s.proj }))).replace(/"/g, '&quot;') %>">
        <div class="lo-ov-chips">
          <button class="btn small ghost" type="submit" name="reason" value="injury news">🏥 Injury news</button>
          <button class="btn small ghost" type="submit" name="reason" value="matchup read">🎯 Matchup read</button>
          <button class="btn small ghost" type="submit" name="reason" value="don't buy the projection">📉 Don't buy the projection</button>
          <button class="btn small ghost" type="submit" name="reason" value="gut">🤙 Gut</button>
          <button class="btn small ghost" type="submit" name="reason" value="unstated">Just record it</button>
        </div>
        <p class="muted" style="margin:.55rem 0 0; font-size:.74rem">
          What you actually start is readable from Sleeper afterwards. What the tool told you <i>right now</i> isn't
          recoverable from anything, so that's what gets written down.
        </p>
      </div>
    </form>

    <%# ── The email that fires before kickoff — a rehearsal/preview, demoted:
        on a Sunday you want the call above, not a copy of the email. ────────── %>
    <% if (typeof alert !== 'undefined' && alert) { %>
      <details class="card sa-preview" style="margin-bottom:1rem">
        <summary>📣 Preview the Sunday alert email &amp; send yourself a test</summary>
        <div class="body">
          <% if (alert.posture) { %><div class="sa-head"><%= alert.posture.mode === 'chase' ? '🎯 CHASE' : alert.posture.mode === 'pending' ? '⏳ PENDING' : '🛡️ PROTECT' %> — <%= alert.posture.headline %></div>
          <p class="muted" style="margin:0 0 .6rem; font-size:.82rem"><%= alert.posture.why %></p><% } %>
          <%# A DEAD SLOT LEADS IN THE EMAIL, so it leads here. A preview that
              shows a different thing than the email sends is worse than no
              preview — it was already caught once, showing a ⏳ PENDING week
              branded 🛡️ PROTECT. %>
          <% if (alert.dead && alert.dead.length) { %>
            <div class="sa-head" style="color:#d4242f">⛔ <%= alert.dead.length %> starter<%= alert.dead.length === 1 ? '' : 's' %> cannot score this week</div>
            <p class="muted" style="margin:.2rem 0 .6rem; font-size:.82rem"><%= alert.dead.map(d => d.name + ' (' + d.pos + ') — ' + d.reason).join(' · ') %></p>
          <% } %>
          <div class="sa-head"><%= alert.headline %></div>
          <%# SAME SOURCE THE EMAIL USES: `changes` (vs your lineup) when the live
              lineup was readable, `calls` (vs the naive lineup) when it was not. %>
          <% const saTodo = alert.lineupKnown ? (alert.changes || []) : (alert.calls || []); %>
          <% if (saTodo.length) { %>
            <ul class="sa-calls">
              <% saTodo.forEach(c => { %>
                <li><span class="sa-move">▲ Start <b><%= c.start %></b> over <%= c.sit %></span>
                  <span class="sa-dollars money-up">+$<%= Math.round(c.dollars) %></span>
                  <span class="sa-why muted"><%= c.why %></span></li>
              <% }) %>
            </ul>
          <% } %>
          <%# THE EMAIL DOES NOT ARRIVE EVERY SUNDAY ANY MORE. Say so where the
              rehearsal button is, or a quiet Sunday reads as a broken cron. %>
          <p class="muted" style="font-size:.78rem; margin:.5rem 0 0">
            <% if (alert.actionable) { %>This week the cron <b>would</b> send this.
            <% } else { %>This week the cron would send <b>nothing</b> — there's nothing to act on, which is most weeks.
              The scheduled run still logs itself either way.<% } %>
          </p>
          <% if (alert.band && alert.band.median) { %>
            <p class="muted" style="font-size:.78rem; margin:.4rem 0 0">The bar: ~<%= alert.band.median %> usually takes the week's $100<% if (alert.projected) { %> · you project <%= Math.round(alert.projected) %><% } %>.</p>
          <% } %>
          <form method="post" action="/lineup/sunday/send" style="margin-top:.7rem">
            <button class="btn small navy" type="submit">📤 Send it to me now (rehearsal)</button>
            <span class="muted" style="font-size:.74rem; margin-left:.5rem">The weekly cron fires this before kickoff once the season's on.</span>
          </form>
        </div>
      </details>
    <% } %>
  <% } %>

<% } else { %>
  <%# ══════════════════ THE PROOF ══════════════════ %>
  <div class="card lo-hero" style="margin-bottom:1.1rem">
    <div class="body">
      <p style="margin:0 0 .5rem"><b>This optimizer reproduces the certified leak measurement to the dollar</b> —
        the same numbers the Lab's cert-gated grader produces, computed here in the site's own engine.</p>
      <div class="lo-proof-grid">
        <% proof.forEach(s => { %>
          <div class="lo-proof-cell">
            <div class="lo-proof-season"><%= s.season %></div>
            <div class="lo-proof-total money-gold"><%= money0(s.meanTotalLeak) %></div>
            <div class="lo-proof-sub muted">/team left on the bench</div>
            <div class="lo-proof-split muted"><%= money0(s.meanHighPoolLeak) %> weekly-high · <%= money0(s.meanMatchupLeak) %> record</div>
          </div>
        <% }) %>
      </div>
      <p class="muted" style="margin:.7rem 0 0; font-size:.8rem">
        Weekly-high is ~70–75% of it: $100 a week rides on the top score and one benched boom decides it.
        Playoff dollars aren't in these figures yet, so they're a lower bound.
      </p>
    </div>
  </div>

  <%# The benched-points tragedy — the business case as one number. %>
  <div class="card" style="margin-bottom:1.1rem; border-color:rgba(245,196,69,.35)">
    <div class="body" style="text-align:center">
      <div class="muted" style="font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; font-weight:800">Cory's three-year bench tab</div>
      <div class="money-gold" style="font-size:2.2rem; font-weight:800; margin:.2rem 0"><%= money0(myLeak) %></div>
      <div class="muted" style="font-size:.82rem">left on the bench across 2023–25 — the league's funniest ongoing tragedy, and the reason this tool exists.</div>
    </div>
  </div>

  <%# Per-team efficiency (who leaves the most on the bench). %>
  <div class="card" style="margin-bottom:1.1rem">
    <h2>🪑 Lineup Efficiency <span class="sub">realized ÷ optimal, regular season</span></h2>
    <div class="body tight scroll-x">
      <% eff.forEach(seasonRow => { %>
        <div class="lo-eff-season"><b><%= seasonRow.season %></b> <span class="muted">— league average <%= (seasonRow.meanEfficiency * 100).toFixed(1) %>%, <%= money0(seasonRow.meanPointLeak) %> pts/team left on the bench</span></div>
        <table class="roll" style="margin-bottom:.9rem">
          <tr><th>Owner</th><th class="num">Efficiency</th><th class="num">Pts left</th></tr>
          <% seasonRow.teams.slice(0, 10).forEach(t => { %>
            <tr class="<%= t.owner === 'coryjsimms' ? 'champ' : '' %>">
              <td><%= t.name || t.owner || ('roster ' + t.roster_id) %></td>
              <td class="num"><%= (t.efficiency * 100).toFixed(1) %>%</td>
              <td class="num muted"><%= t.leak.toFixed(1) %></td>
            </tr>
          <% }) %>
        </table>
      <% }) %>
    </div>
  </div>

  <%# Per-week drill-down. %>
  <div class="card" style="margin-bottom:1rem">
    <h2>🔎 A Week Up Close <span class="sub">what was started vs what was optimal</span></h2>
    <div class="body">
      <form method="get" action="/lineup" class="inline-form" style="margin-bottom:.8rem">
        <input type="hidden" name="tab" value="proof">
        <div class="fit"><label class="field">Season
          <select name="replay">
            <%# Seasons come from the analyzed set (proof), not a frozen literal
                array — so a newly completed season appears here automatically at
                rollover instead of being stuck at 2023–2025. %>
            <% (proof || []).map(p => String(p.season)).forEach(y => { %><option value="<%= y %>" <%= (drill && String(drill.season) === y) ? 'selected' : '' %>><%= y %></option><% }) %>
          </select></label></div>
        <div class="fit"><label class="field">Week
          <input type="number" name="week" min="1" max="15" value="<%= drill ? drill.week : 6 %>" style="width:5rem"></label></div>
        <div class="fit"><button class="btn navy" type="submit">Show me</button></div>
      </form>
      <% if (drill) { %>
        <div class="lo-drill">
          <div class="lo-drill-head">
            <span>Week <%= drill.week %>, <%= drill.season %> — <%= drill.owner %></span>
            <span class="lo-drill-leak <%= drill.leak > 0 ? 'money-down' : 'money-flat' %>"><%= drill.leak > 0 ? money0(drill.leak) + ' left on the bench' : 'optimal lineup — nothing left' %></span>
          </div>
          <div class="lo-drill-cols">
            <div>
              <div class="lo-drill-lbl">Started · <b><%= drill.actual.points.toFixed(1) %></b></div>
              <% drill.actual.starters.forEach(p => { %><div class="lo-drill-row"><span class="muted"><%= p.pos %></span><span><%= p.points != null ? p.points.toFixed(1) : '—' %></span></div><% }) %>
            </div>
            <div>
              <div class="lo-drill-lbl">Optimal · <b class="money-up"><%= drill.optimal.points.toFixed(1) %></b></div>
              <% drill.optimal.starters.forEach(p => { %><div class="lo-drill-row"><span class="muted"><%= p.pos %></span><span><%= p.points.toFixed(1) %></span></div><% }) %>
            </div>
          </div>
          <p class="muted" style="font-size:.76rem; margin:.5rem 0 0">Player names fill in when the historical player map lands (A's board); the points and the bench tab are exact today.</p>
        </div>
      <% } else { %>
        <p class="muted" style="margin:0">Pick a season and week to see the exact lineup that was started against the one that should have been.</p>
      <% } %>
    </div>
  </div>
<% } %>

<p style="text-align:center; margin-top:1rem">
  <a class="btn navy" href="/team?section=week">← Team &amp; matchup</a>
</p>
<%- include('partials/footer') %>
