<%- include('partials/header', { title: 'League Office' }) %>
<%- include('partials/_live_stale') %>

<%# ── DRAFT DAY — the headline until the board is set. Derived from config
    (date/time/place), so this banner and the pinned alert cannot disagree.
    Clickable through to the board, like everything else on the page. %>
<% const _di = (typeof draftInfo !== 'undefined' && draftInfo) ? draftInfo : null; %>
<% if (_di && _di.configured && !_di.passed) { %>
  <a class="draft-banner<%= _di.today ? ' today' : '' %>" href="/draft" title="The draft board — spots, order, and the room">
    <span class="draft-banner-ico">🏈</span>
    <span class="draft-banner-txt">
      <b>Draft Day — <%= _di.when %></b>
      <span class="draft-banner-sub"><%= _di.place %><% if (_di.today) { %> · it's today — be there<% } %> <span class="draft-banner-cue">→</span></span>
    </span>
    <% if (_di.days != null && !_di.today) { %>
      <span class="draft-banner-count"><b><%= _di.days %></b><small>day<%= _di.days === 1 ? '' : 's' %></small></span>
    <% } else if (_di.today) { %>
      <span class="draft-banner-count today"><b>TODAY</b></span>
    <% } %>
  </a>
<% } %>

<%# ── KEEPER-SET DEADLINE — expires on its own the instant the deadline
    passes (server-derived, same source as the pinned alert), so there is
    nothing to remember to take down. `configured` gates this the same way
    it gates the pinned alert (dashboard.js) — a fallback date never renders
    with the authority of a ruling nobody made. %>
<% const _kd = (typeof keeperInfo !== 'undefined' && keeperInfo) ? keeperInfo : null; %>
<% if (_kd && _kd.configured && !_kd.passed) { %>
  <%# Dedicated "kd-banner*" classes, not a reuse of "draft-banner*" — several
      surfaces assert the DRAFT banner specifically is gone by testing for the
      literal string `class="draft-banner`, which a shared prefix would also
      match on this banner's inner spans regardless of the outer element's
      class order. This banner's lifecycle is independent of the draft's (the
      keeper deadline, not the draft date) so it needs its own identity anyway. %>
  <a class="kd-banner<%= _kd.hoursLeft != null && _kd.hoursLeft <= 24 ? ' today' : '' %>" href="/draft#keepers" title="Set your keeper before it locks">
    <span class="kd-banner-ico">🔒</span>
    <span class="kd-banner-txt">
      <b>Keeper Deadline — <%= _kd.when %></b>
      <span class="kd-banner-sub">Set your keeper before it locks <span class="kd-banner-cue">→</span></span>
    </span>
    <% if (_kd.countdownText) { %>
      <span class="kd-banner-count<%= _kd.hoursLeft != null && _kd.hoursLeft <= 24 ? ' today' : '' %>"><b><%= _kd.countdownText %></b></span>
    <% } %>
  </a>
<% } %>

<%# ── THE IN-SEASON HERO — your game, first thing, during a season week. Score,
    opponent, who's leading, and a lineup problem if there's a real one. Taps
    through to your full matchup. Absent off-season (the draft banner leads then). %>
<% const _wh = (typeof weekHero !== 'undefined' && weekHero) ? weekHero : null; %>
<% if (_wh) { %>
  <a class="week-hero<%= _wh.leading === 'you' ? ' up' : _wh.leading === 'them' ? ' down' : '' %>" href="/matchup" title="Your full matchup — bet, trash talk, starters">
    <div class="week-hero-top">
      <span class="week-hero-kicker">⚔️ Week <%= _wh.weekNo %> — your game</span>
      <% if (_wh.live) { %><span class="week-hero-state <%= _wh.leading %>"><%= _wh.leading === 'you' ? 'you lead by ' + _wh.margin : _wh.leading === 'them' ? 'down ' + _wh.margin : 'dead even' %></span>
      <% } else { %><span class="week-hero-state pre">not kicked off</span><% } %>
    </div>
    <div class="week-hero-score">
      <span class="whs-side">
        <span class="whs-team"><%= _wh.meTeam %></span>
        <span class="whs-pts"><%= _wh.live ? _wh.mePts.toFixed(1) : '—' %></span>
        <span class="whs-who">you</span>
      </span>
      <span class="whs-vs">vs</span>
      <span class="whs-side">
        <span class="whs-team"><%= _wh.oppTeam %></span>
        <span class="whs-pts"><%= _wh.live ? _wh.oppPts.toFixed(1) : '—' %></span>
        <span class="whs-who"><%= _wh.oppName %></span>
      </span>
    </div>
    <%# The Tuesday preview line — what history says about this pairing, on the
        page you land on (member-site pass, 2026-08-16). %>
    <% if (_wh.prev && _wh.prev.leadLine) { %>
      <div class="week-hero-prev">📜 <%= _wh.prev.leadLine %><%= _wh.prev.streakLine ? ' · ' + _wh.prev.streakLine : '' %></div>
    <% } %>
    <% if (_wh.lineupWarn) { %>
      <div class="week-hero-warn">⚠️ Lineup problem: <%= _wh.lineupWarn.items.map(i => i.text).join(', ') %><% if (_wh.lineupWarn.count > _wh.lineupWarn.items.length) { %> +<%= _wh.lineupWarn.count - _wh.lineupWarn.items.length %> more<% } %> — fix it before kickoff →</div>
    <% } else { %>
      <div class="week-hero-foot">Open your matchup — bet it, talk trash, watch the starters <span class="week-hero-cue">→</span></div>
    <% } %>
  </a>
<% } %>

<%# ── RECORDS WATCH — last week's finals that entered the franchise book.
    Dormant when nothing landed (the normal week). League-visible history. %>
<% const _rb = (typeof recordBanners !== 'undefined' && recordBanners) ? recordBanners : []; %>
<% if (_rb.length) { %>
  <div class="rec-watch" role="region" aria-label="Records watch">
    <% for (const ch of _rb) { %>
      <div class="rec-watch-chip in"><span class="tag">📚</span><span><b>Into the book:</b> <%= ch.text %> — <a href="/history?section=records" style="color:inherit">the record book →</a></span></div>
    <% } %>
  </div>
<% } %>

<%# RIVALRY GAME OF THE WEEK — billed on the home page when one of the league's real
    rivalries is on this week's slate; the highest-billed one wins the top spot. %>
<% if (typeof rivalryOfWeek !== 'undefined' && rivalryOfWeek) { %>
  <%- include('partials/_rivalry_banner', { rivalry: rivalryOfWeek, aName: rivalryOfWeek.pair.a, bName: rivalryOfWeek.pair.b, rivalryRank: rivalryOfWeek.rank }) %>
  <% if (rivalryMore > 0) { %><p class="muted" style="text-align:center; margin:-.7rem 0 1.1rem; font-size:.76rem">+ <%= rivalryMore %> more rivalry game<%= rivalryMore === 1 ? '' : 's' %> on the slate this week</p><% } %>
<% } %>
<%# ── THE DISPATCH — transient popups. They appear, get read, get dismissed,
    and are gone (server-side per owner). With JS this is an overlay that clears
    instantly; without JS it's a dismissible stack at the top of the page. Never
    persists once dismissed. Archived elsewhere for the chronicle. %>
<% const _dsp = (typeof dispatches !== 'undefined' && dispatches) ? dispatches : []; %>
<% if (_dsp.length) { %>
<div class="dispatch-region" id="dispatch-region" data-count="<%= _dsp.length %>">
  <div class="dispatch-backdrop" aria-hidden="true"></div>
  <div class="dispatch-stack" role="region" aria-label="League dispatch">
    <div class="dispatch-head">
      <span class="dispatch-kicker">📣 The Dispatch</span>
      <% if (_dsp.length > 1) { %><span class="dispatch-count muted"><%= _dsp.length %> new</span><% } %>
    </div>
    <% for (const d of _dsp) { %>
      <article class="dispatch-card" data-key="<%= d.key %>">
        <div class="dispatch-card-top">
          <span class="dispatch-icon" aria-hidden="true"><%= d.icon %></span>
          <span class="dispatch-title"><%= d.title %></span>
          <form method="post" action="/dispatch/dismiss" class="dispatch-dismiss-form" data-no-busy>
            <input type="hidden" name="key" value="<%= d.key %>">
            <button type="submit" class="dispatch-x" aria-label="Dismiss">✕</button>
          </form>
        </div>
        <p class="dispatch-body"><%= d.body %></p>
      </article>
    <% } %>
  </div>
</div>
<% } %>

<%# The Sunday landing — one tap to every game. Prominent, not buried. %>
<a class="weekhub-cta" href="/scoreboard">
  <span class="whc-ico">🏈</span>
  <span class="whc-txt"><b>This Week — every game on one screen</b><span class="whc-sub">scores, the pick'em split, the $100 race, what's at stake →</span></span>
</a>
<a class="weekhub-cta races" href="/races">
  <span class="whc-ico">🏁</span>
  <span class="whc-txt"><b>The Races — playoff race, points crown, the toilet</b><span class="whc-sub">week-over-week movement · everyone's in one of them →</span></span>
</a>

<% if (roast) { %>
<div class="roast-banner">🚨 <%= roast %></div>
<% } %>

<%# Contact directory nag (contact-directory.md): one banner for incomplete
    contact info — Venmo, email or phone. Recurring but dismissible per session.
    Only the MISSING fields get an input, so a complete owner never sees it. %>
<% const _nag = (typeof contactNag !== 'undefined' && contactNag) ? contactNag : []; %>
<% if (_nag.length) { %>
<div class="contact-nag" id="contact-nag">
  <span>📇 Your contact info is incomplete — add your <%= _nag.join(', ') %> so the league can reach and pay you.</span>
  <form method="post" action="/profile/contact">
    <input type="hidden" name="back" value="home">
    <% if (_nag.includes('phone')) { %><input type="tel" name="phone" maxlength="30" placeholder="phone"><% } %>
    <% if (_nag.includes('email')) { %><input type="email" name="email" maxlength="120" placeholder="email"><% } %>
    <% if (_nag.includes('Venmo')) { %><input type="text" name="venmo" maxlength="60" placeholder="venmo handle"><% } %>
    <button type="submit" class="btn small">Save</button>
  </form>
  <button type="button" class="dismiss" onclick="this.parentNode.style.display='none';sessionStorage.setItem('contactNagDismissed','1')">dismiss</button>
</div>
<script>
  (function(){ if(!sessionStorage.getItem('contactNagDismissed')){ var n=document.getElementById('contact-nag'); if(n) n.style.display='flex'; } })();
</script>
<% } %>

<%# The commissioner's incomplete-info view lives in the Commissioner Console
    now, not here — the home page only nags YOU for YOUR own data. %>

<div class="hero">
  <a class="hero-item clickable <%= myBalance > 0 ? 'good' : myBalance < 0 ? 'bad' : '' %>" href="/bank#top">
    <span class="hero-label">Your Balance</span>
    <span class="hero-value"><%= myBalance === 0 ? '✓ Even' : money(Math.abs(myBalance)) %></span>
    <span class="hero-sub"><%= myBalance > 0 ? 'the league owes you →' : myBalance < 0 ? 'you owe the league →' : 'see your ledger →' %></span>
  </a>
  <a class="hero-item clickable" href="/votes">
    <span class="hero-label"><%= season.year %> Buy-In</span>
    <span class="hero-value"><%= money(season.buy_in) %></span>
    <span class="hero-sub">set by league vote →</span>
  </a>
  <a class="hero-item clickable" href="#pot-split" data-opens="#pot-split">
    <span class="hero-label">Total Pot</span>
    <span class="hero-value"><%= money(season.total_pot) %></span>
    <span class="hero-sub">tap to see the split →</span>
  </a>
  <% if (season.weekly_payout) { %>
  <a class="hero-item clickable" href="#weekly-winners" data-flash="#weekly-winners">
    <span class="hero-label">Weekly High Point</span>
    <span class="hero-value"><%= money(season.weekly_payout) %></span>
    <span class="hero-sub">who's won it →</span>
  </a>
  <% } %>
</div>

<%
  const myTurn = draft.current && draft.current.owner_id === owner.id;
  const unvoted = openVotes.filter(v => !v.myChoice).length;
  const iOwe = myBalance < 0;
  const pkNudge = (typeof pickemNudge !== 'undefined' && pickemNudge) ? pickemNudge : null;
%>
<% if (myTurn || unvoted || iOwe || pkNudge) { %>
<div class="todo-strip">
  <span class="todo-label">Needs you</span>
  <% if (myTurn) { %><a class="todo-item urgent" href="/draft">🎯 Pick your draft spot</a><% } %>
  <%# The one item with a hard weekly deadline — unpicked games vanish at kickoff. %>
  <% if (pkNudge) { %><a class="todo-item" href="/pickem">🗳️ Pick this week's games (<%= pkNudge.made %> of <%= pkNudge.total %> in)</a><% } %>
  <% if (unvoted) { %><a class="todo-item" href="/votes">🗳 <%= unvoted %> vote<%= unvoted === 1 ? '' : 's' %> you haven't cast</a><% } %>
  <% if (iOwe) { %><a class="todo-item" href="/bank">💵 You owe <%= money(-myBalance) %></a><% } %>
</div>
<% } %>

<div class="grid cols-2">

  <% if (sleeperStandings.length) { %>
  <%
    // STATE AWARENESS: a ranked table with a crown, a playoff line and a toilet
    // is decoration on noise until real results exist. Pre-season renders the
    // table UNRANKED (alphabetical, explicitly labeled, no merit furniture);
    // the full ranked rendering returns the moment week-1 scores land.
    const seasonStarted = sleeperStandings.some(r =>
      (r.wins || 0) + (r.losses || 0) + (r.ties || 0) > 0 || (r.pf || 0) > 0);
    const standingsRows = seasonStarted ? sleeperStandings
      : sleeperStandings.slice().sort((a, b) =>
          String(a.owner_name || a.team).localeCompare(String(b.owner_name || b.team)));
    // The folded playoff column — only once there's a real picture to fold in.
    const _po = (typeof playoffPicture !== 'undefined' && playoffPicture) ? playoffPicture : null;
    const showPO = seasonStarted && _po;
    const _poCols = showPO ? 5 : 4;
    const _poCell = id => {
      const p = _po && id != null ? _po[id] : null;
      if (!p) return '<span class="muted">—</span>';
      if (p.status === 'clinched') return '<span class="po-badge in" title="clinched a playoff spot">🔒 IN</span>';
      if (p.status === 'eliminated') return '<span class="po-badge out" title="mathematically eliminated">❌ OUT</span>';
      // THE THIRD SURFACE WITH THIS DEFECT, and the one where it argues with
      // itself. simOdds is a 4,000-iteration Monte Carlo, so a long shot scores
      // a true 0 and Math.round printed "0%" — on a row the two branches above
      // just declined to eliminate. A 2–10 team with eight games left came out
      // ALIVE and 0% on the same line. Only teams that are neither clinched nor
      // eliminated ever reach here, so a bare 0% or 100% is never right in this
      // cell: the badge is where certainty is allowed to be stated, because it
      // is proved from bounds rather than sampled. Same formatter as /matchup
      // and /watch (src/routes/oddstext.js).
      let arrow = '';
      if (p.delta != null && Math.abs(p.delta) >= 0.005) {
        const d = Math.round(Math.abs(p.delta) * 100);
        arrow = p.delta > 0 ? ` <span class="po-arrow up" title="up ${d} since last week">▲${d}</span>`
          : ` <span class="po-arrow down" title="down ${d} since last week">▼${d}</span>`;
      }
      // This cell is built as an HTML string and inserted UNESCAPED, so the
      // figure has to be escaped here: pctText returns "<1%", and a raw "<1%"
      // is read as the start of a TAG. Five rows went BLANK the first time —
      // worse than the "0%" being fixed here, and invisible unless you look at
      // the page rather than at the diff.
      const _e = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return `<span class="po-odds" title="playoff odds (estimate)">${_e(pctText(p.odds))}</span>${arrow}`;
    };
  %>
  <div class="card">
    <h2>Live Standings <span class="sub"><%= seasonStarted ? 'straight from Sleeper' : 'pre-season — standings begin week 1' %></span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><% if (seasonStarted) { %><th>#</th><% } %><th>Team</th><th class="num" style="white-space:nowrap; min-width:3.4em">W-L</th><th class="num" style="white-space:nowrap; min-width:4.5em">PF</th><% if (showPO) { %><th class="num po-th" title="playoff odds — a running estimate off record + points">PO%</th><% } %></tr>
        <% for (const r of standingsRows) { %>
          <% if (seasonStarted && r.rank === playoffTeams + 1) { %><tr><td colspan="<%= _poCols %>" style="padding:.15rem .8rem; font-size:.62rem; letter-spacing:.14em; text-transform:uppercase; color:var(--red-bright); border-bottom:1px dashed rgba(255,70,85,.5)">— playoff line (top <%= playoffTeams %>) —</td></tr><% } %>
          <%# Money marker. If somebody has a live side bet riding on this team,
              say so right here — half the fun of a season-long pool is reading
              the table with the bet in mind, and a standings row that doesn't
              know about it makes you hold the whole thing in your head. Gold
              means it's YOUR money. %>
          <% const bm = r.owner_id != null ? betMoney[r.owner_id] : null; %>
          <tr class="<%= seasonStarted && r.rank === sleeperStandings.length ? 'last-place' : '' %>">
            <% if (seasonStarted) { %><td style="white-space:nowrap"><%= r.rank %><%= r.rank === 1 ? ' 👑' : r.rank === sleeperStandings.length ? ' 🚽' : '' %><%
              // Rank-movement arrow — lights up on its own once week 2 lands.
              const mv = (typeof rankMoves !== 'undefined' && r.owner_id != null) ? rankMoves[r.owner_id] : null;
              if (mv && mv.delta > 0) { %> <span class="rank-arrow up" title="up <%= mv.delta %> from last week (was <%= mv.prevRank %>)">▲<%= mv.delta %></span><%
              } else if (mv && mv.delta < 0) { %> <span class="rank-arrow down" title="down <%= -mv.delta %> from last week (was <%= mv.prevRank %>)">▼<%= -mv.delta %></span><%
              } else if (mv) { %> <span class="rank-arrow same" title="held at <%= mv.curRank %>">–</span><% } %></td><% } %>
            <% const _fl = (typeof flags !== 'undefined' && r.owner_id != null) ? (flags[r.owner_id] || '') : ''; %>
            <td><% if (r.owner_id != null) { %><button type="button" class="contact-link" data-contact="<%= r.owner_id %>"><b><%= r.owner_name || r.team %></b></button><%- include('partials/_owner_badges', { name: r.owner_name }) %><% if (_fl) { %> <span class="flag"><%= _fl %></span><% } %><% } else { %><b><%= r.owner_name || r.team %></b><%- include('partials/_owner_badges', { name: r.owner_name }) %><% } %><% if (bm) { %><span
                class="bet-money<%= bm.mine ? ' mine' : '' %>"
                title="<%= bm.notes.join(' · ') %>">💰<% if (bm.mine) { %><%= money(bm.mine) %><% } %></span><% } %><% if (r.owner_name && r.owner_name !== r.team) { %> <span class="muted"><%= r.team %></span><% } %></td>
            <td class="num" style="white-space:nowrap"><%= r.wins %>-<%= r.losses %><%= r.ties ? '-' + r.ties : '' %></td>
            <td class="num" style="white-space:nowrap"><%= r.pf.toFixed(1) %></td>
            <% if (showPO) { %><td class="num po-cell" style="white-space:nowrap"><%- _poCell(r.owner_id) %></td><% } %>
          </tr>
        <% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% const boardHasScores = sleeperBoard.some(m => m.some(t => t.points > 0)); %>
  <% if (sleeperBoard.length && boardHasScores) { %>
  <div class="card">
    <h2>Week <%= sleeperData.week %> Scoreboard <span class="sub">live from Sleeper</span></h2>
    <div class="body">
      <%# Each game taps through to its matchup — your own game opens your full
          matchup (?opp=), any other opens the read-only spectator view (?a=&b=),
          the same rule as the /scoreboard page. Falls back to a plain block only
          when the owner ids aren't mapped yet. %>
      <% for (const m of sleeperBoard) { const hi = Math.max(...m.map(t => t.points));
         const ids = m.map(t => t.owner_id).filter(x => x != null);
         let _mlnk = null;
         if (ids.length === 2) {
           _mlnk = ids.indexOf(meId) !== -1
             ? '/matchup?opp=' + ids[ids.indexOf(meId) === 0 ? 1 : 0]
             : '/matchup?a=' + ids[0] + '&b=' + ids[1];
         }
         const _mtag = _mlnk ? 'a' : 'div'; %>
        <<%= _mtag %> class="matchup<%= _mlnk ? ' clickable' : '' %>"<% if (_mlnk) { %> href="<%= _mlnk %>" title="See this matchup"<% } %>>
          <% for (const t of m) { %>
            <div class="mrow <%= t.points === hi && m.length > 1 && hi > 0 ? 'winning' : '' %>">
              <span><%= t.team %></span><b><%= t.points.toFixed(2) %></b>
            </div>
          <% } %>
          <% if (_mlnk) { %><span class="mrow-cue" aria-hidden="true">→</span><% } %>
        </<%= _mtag %>>
      <% } %>
    </div>
  </div>
  <% } %>

  <%# THE MONEY — the real scoreboard, in dollars. Cory, 2026-08-18: keep it,
      just move it below the actual matchups rather than beside the wins
      standings — the games are what you look at first. %>
  <%- include('partials/money-line') %>

  <% if (review) { %>
  <div class="card">
    <h2>Week <%= reviewWeek %> in Review <span class="sub">auto-generated from Sleeper</span></h2>
    <div class="body tight">
      <table class="roll">
        <tr><td>👑 Top score</td><td><b><%= review.top.team %></b></td><td class="num"><%= review.top.points.toFixed(2) %></td></tr>
        <tr><td>🚽 Toilet of the week</td><td><b><%= review.low.team %></b></td><td class="num"><%= review.low.points.toFixed(2) %></td></tr>
        <% if (review.blowout) { %><tr><td>🔨 Beatdown</td><td><b><%= review.blowout.w.team %></b> over <%= review.blowout.l.team %></td><td class="num">by <%= review.blowout.margin.toFixed(2) %></td></tr><% } %>
        <% if (review.closest) { %><tr><td>😅 Nail-biter</td><td><b><%= review.closest.w.team %></b> edged <%= review.closest.l.team %></td><td class="num">by <%= review.closest.margin.toFixed(2) %></td></tr><% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (wireRows.length) { %>
  <%
    // A realistic mid-season wire is 40-60 transactions, which at ~60px a row is
    // more than this entire page. Capped structurally, with the count shown —
    // being told there are 47 more is the difference between "that's all of it"
    // and "there's more, tap to see".
    const WIRE_CAP = 6;
    const wireShown = wireRows.slice(0, WIRE_CAP);
    const wireRest = wireRows.slice(WIRE_CAP);
  %>
  <div class="card">
    <h2>The League Wire <span class="sub">latest moves on Sleeper</span></h2>
    <div class="body tight">
      <table class="roll">
        <% for (const w of wireShown) { %>
          <tr><td style="width:5.5rem"><span class="badge <%= w.trade ? 'gold' : 'navy' %>"><%= w.kind %></span></td><td><%= w.text %></td></tr>
        <% } %>
      </table>
      <% if (wireRest.length) { %>
        <details class="more-rows">
          <summary>See all <%= wireRows.length %> moves (<%= wireRest.length %> more)</summary>
          <table class="roll">
            <% for (const w of wireRest) { %>
              <tr><td style="width:5.5rem"><span class="badge <%= w.trade ? 'gold' : 'navy' %>"><%= w.kind %></span></td><td><%= w.text %></td></tr>
            <% } %>
          </table>
        </details>
      <% } %>
    </div>
  </div>
  <% } %>

  <div class="card" id="weekly-winners">
    <h2>Weekly High Point <span class="sub"><%= season.year %> — <%= money(season.weekly_payout) %> to the top score, regular season only</span></h2>
    <%# The biggest recurring prize, made visible: the bar you have to clear, and
        — once games are on — this week's live race for the $100. %>
    <% if (typeof whBand !== 'undefined' && whBand && whBand.n) { %>
      <div class="body" style="padding-bottom:0">
        <% if (typeof whRace !== 'undefined' && whRace) {
             const pct = whRace.top ? Math.max(4, Math.min(100, Math.round((whRace.mine || 0) / whRace.top * 100))) : 0; %>
          <div class="wh-race">
            <div class="wh-race-top">
              <span class="wh-race-lead"><%= whRace.iLead ? '🟢 You lead week ' + whRace.week : '🏈 ' + whRace.leaderName + ' leads week ' + whRace.week %> · <b><%= whRace.top.toFixed(1) %></b></span>
              <% if (whRace.mine != null && !whRace.iLead) { %><span class="wh-race-gap muted">you're <%= (whRace.top - whRace.mine).toFixed(1) %> back</span><% } %>
            </div>
            <div class="wh-race-bar"><div class="wh-race-fill<%= whRace.iLead ? ' lead' : '' %>" style="width:<%= pct %>%"></div></div>
            <div class="wh-race-scale muted"><span>you: <%= whRace.mine != null ? whRace.mine.toFixed(1) : '—' %></span><span>$100 at the top</span></div>
          </div>
        <% } else { %>
          <p class="wh-band-note">🎯 <b><%= money(season.weekly_payout) %></b> to the week's top score. The bar, from three seasons: typically <b><%= Math.round(whBand.median) %></b> wins it — range <%= Math.round(whBand.min) %>–<%= Math.round(whBand.max) %>. It comes alive here once games are on.</p>
        <% } %>
      </div>
    <% } %>
    <div class="body tight scroll-x">
      <% if (!weekly.length) { %>
        <p class="muted" style="padding:1rem">No weekly winners recorded yet.</p>
      <% } else { %>
      <table class="roll">
        <tr><th>Week</th><th>Winner</th><th class="num">Amount</th><th>Paid Out</th></tr>
        <% for (const w of weekly) { %>
          <tr>
            <td>Week <%= w.week %></td>
            <td><b><%= w.name %></b></td>
            <td class="num"><%= money(w.amount) %></td>
            <td><%= w.settled ? '✅' : '⏳ on the tab' %></td>
          </tr>
        <% } %>
      </table>
      <% } %>
    </div>
  </div>

  <% if (awards.length) { %>
  <div class="card">
    <h2><%= season.year %> Season Awards</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Award</th><th>Owner</th><th class="num">Amount</th><th>Paid</th></tr>
        <% for (const a of awards) { %>
          <tr><td><%= CATEGORY_LABELS[a.category] || a.category %></td><td><b><%= a.name %></b></td><td class="num"><%= money(a.amount) %></td><td><%= a.settled ? '✅' : '⏳ on the tab' %></td></tr>
        <% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (standings.length) { %>
  <div class="card">
    <h2><%= season.year %> Final Standings</h2>
    <div class="body tight">
      <table class="roll">
        <tr><th>Place</th><th>Owner</th></tr>
        <% for (const s of standings) { %>
          <tr><td><%= s.rank %><%= ['st','nd','rd'][s.rank - 1] || 'th' %><%= s.rank === standings.length ? ' 🚽' : s.rank === 1 ? ' 👑' : '' %></td><td><b><%= s.name %></b></td></tr>
        <% } %>
      </table>
    </div>
  </div>
  <% } %>

  <div class="col-span-2" style="margin-top:.4rem">
    <details class="reference-block" id="pot-split">
      <summary>💵 How the <%= money(season.total_pot) %> pot splits — and everyone’s buy-in status</summary>
      <div class="grid cols-2" style="margin-top:.8rem">
  <div class="card">
    <h2>Buy-In Status <span class="sub"><a href="/bank" style="color:inherit">full ledger → League Finances</a></span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Owner</th><th>Buy-in</th><th class="num">Net Tab</th></tr>
        <% for (const b of buyins) { %>
          <tr>
            <td><button type="button" class="contact-link" data-contact="<%= b.owner.id %>"><b><%= b.owner.name %></b></button><% if (typeof flags !== 'undefined' && flags[b.owner.id]) { %> <span class="flag"><%= flags[b.owner.id] %></span><% } %></td>
            <td><% if (b.paid) { %><span class="badge paid">Paid</span><% } else { %><span class="badge owes">Owes <%= money(season.buy_in) %></span><% } %></td>
            <td class="num <%= b.balance > 0 ? 'pos' : b.balance < 0 ? 'neg' : '' %>"><%= b.balance === 0 ? '—' : money(b.balance) %></td>
          </tr>
        <% } %>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Payout Structure <span class="sub">where the <%= money(season.total_pot) %> goes</span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Prize</th><th class="num">Share</th><th class="num">Amount</th></tr>
        <% if (season.weekly_payout) { %>
          <tr><td>🏈 Weekly High Point × <%= season.weeks %> weeks</td><td class="num"></td><td class="num"><%= money(season.weekly_payout) %> / wk</td></tr>
        <% } %>
        <% for (const r of payouts.reg) { %>
          <tr><td>📈 Regular Season <%= r.place === 1 ? 'Champ' : 'Runner-up' %></td><td class="num"><%= Math.round(r.pct * 1000) / 10 %>%</td><td class="num"><b><%= money(r.amount) %></b></td></tr>
        <% } %>
        <% for (const r of payouts.playoff) { %>
          <tr><td><%= ['🏆','🥈','🥉','4️⃣'][r.place - 1] %> Playoffs — <%= ['1st','2nd','3rd','4th'][r.place - 1] %></td><td class="num"><%= Math.round(r.pct * 1000) / 10 %>%</td><td class="num"><b><%= money(r.amount) %></b></td></tr>
        <% } %>
        <tr class="total"><td>Total pot</td><td></td><td class="num"><%= money(season.total_pot) %></td></tr>
      </table>
    </div>
  </div>

      </div>
    </details>
  </div>
</div>

<%# ── The locker room, on the front page ────────────────────────────────────
    It was a tab, and a tab nobody opens is a tab nobody posts in. The last few
    messages plus a box to reply, at the bottom of the page everybody lands on,
    is the difference between a group chat and a ghost town. %>
<div class="card locker-home" id="locker" style="margin-top:1.4rem">
  <h2>💬 Locker Room
    <span class="sub"><a href="/chat">see all / older →</a></span>
  </h2>
  <div class="body">
    <% if (!chatLatest.length) { %>
      <p class="muted" style="margin:0 0 .7rem">Nobody's said anything yet. Somebody has to go first.</p>
    <% } else { %>
      <ul class="lh-feed">
        <% for (const m of chatLatest) { %>
          <li class="<%= m.owner_id === owner.id ? 'me' : '' %>">
            <b><%= m.name %></b>
            <span><%= m.text %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
    <form method="post" action="/chat" class="lh-form">
      <input type="hidden" name="back" value="home">
      <input type="text" name="text" maxlength="500" required
             placeholder="Say something about <%= (sleeperStandings.length && sleeperStandings[sleeperStandings.length - 1].owner_name) || 'somebody' %>…"
             autocomplete="off">
      <button class="btn gold" type="submit">Post</button>
    </form>
  </div>
</div>

<%# ── Put it on your phone ──────────────────────────────────────────────────
    No app store, no download — this is a website that behaves like an app once
    it is on the home screen. The instructions differ per platform and both are
    two taps, so both are shown rather than sniffing the user agent and getting
    it wrong for whoever is on the one you didn't think of.

    Dismissed state lives in localStorage: it is a nudge, not a setting, and it
    is not worth a database column or a round trip. %>
<div class="card install-card" id="install-card" hidden style="margin-top:1.2rem">
  <div class="body">
    <button type="button" class="install-x" id="install-dismiss" aria-label="Dismiss">✕</button>
    <div class="ic-head">📲 Put this on your phone</div>
    <p class="ic-lede">It opens full-screen like an app — no address bar, no app store.
      One tap from your home screen to the standings, the money and your bets.</p>
    <div class="ic-steps">
      <div>
        <b> iPhone / iPad</b>
        <span>Tap <b>Share</b> <span class="ic-glyph">⬆️</span> at the bottom of Safari, scroll down, tap <b>Add to Home Screen</b>.</span>
      </div>
      <div>
        <b>🤖 Android</b>
        <span>Tap <b>⋮</b> in Chrome, then <b>Add to Home screen</b> (or <b>Install app</b>).</span>
      </div>
    </div>
    <button type="button" class="btn gold" id="install-now" hidden>Install it</button>
  </div>
</div>

<script>
/* Show the install nudge only when it can actually be acted on: not already
   installed, not previously dismissed. On Chrome we can skip the instructions
   entirely and offer the real install prompt. */
(function () {
  var card = document.getElementById('install-card');
  if (!card) return;
  var standalone = window.matchMedia('(display-mode: standalone)').matches
    || window.navigator.standalone === true;
  var dismissed = false;
  try { dismissed = localStorage.getItem('mfga-install-hidden') === '1'; } catch (e) {}
  if (standalone || dismissed) return;
  card.hidden = false;

  document.getElementById('install-dismiss').addEventListener('click', function () {
    card.hidden = true;
    try { localStorage.setItem('mfga-install-hidden', '1'); } catch (e) {}
  });

  // Chrome hands us the prompt; when it does, the button beats the instructions.
  var deferred = null;
  var btn = document.getElementById('install-now');
  window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault();
    deferred = e;
    btn.hidden = false;
    card.classList.add('can-install');
  });
  btn.addEventListener('click', function () {
    if (!deferred) return;
    deferred.prompt();
    deferred.userChoice.then(function () { deferred = null; btn.hidden = true; });
  });
  window.addEventListener('appinstalled', function () {
    card.hidden = true;
    try { localStorage.setItem('mfga-install-hidden', '1'); } catch (e) {}
  });
})();
</script>
