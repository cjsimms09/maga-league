<%- include('partials/header', { title: 'League Office' }) %>

<% if (roast) { %>
<div class="roast-banner">🚨 <%= roast %></div>
<% } %>

<div class="hero">
  <a class="hero-item clickable <%= myBalance > 0 ? 'good' : myBalance < 0 ? 'bad' : '' %>" href="/bank#top">
    <span class="hero-label">Your Balance</span>
    <span class="hero-value"><%= myBalance === 0 ? '✓ Even' : money(Math.abs(myBalance)) %></span>
    <span class="hero-sub"><%= myBalance > 0 ? 'the league owes you →' : myBalance < 0 ? 'you owe the league →' : 'see your ledger →' %></span>
  </a>
  <div class="hero-item">
    <span class="hero-label"><%= season.year %> Buy-In</span>
    <span class="hero-value"><%= money(season.buy_in) %></span>
    <span class="hero-sub">set by league vote</span>
  </div>
  <a class="hero-item clickable" href="#pot-split" data-opens="#pot-split">
    <span class="hero-label">Total Pot</span>
    <span class="hero-value"><%= money(season.total_pot) %></span>
    <span class="hero-sub">tap to see the split →</span>
  </a>
  <% if (season.weekly_payout) { %>
  <a class="hero-item clickable" href="#weekly-winners" data-flash="#weekly-winners">
    <span class="hero-label">Weekly High Point</span>
    <span class="hero-value"><%= money(season.weekly_payout) %></span>
    <span class="hero-sub">who's won it →</span>
  </a>
  <% } %>
</div>

<%
  const myTurn = draft.current && draft.current.owner_id === owner.id;
  const unvoted = openVotes.filter(v => !v.myChoice).length;
  const iOwe = myBalance < 0;
%>
<% if (myTurn || unvoted || iOwe) { %>
<div class="todo-strip">
  <span class="todo-label">Needs you</span>
  <% if (myTurn) { %><a class="todo-item urgent" href="/draft">🎯 Pick your draft spot</a><% } %>
  <% if (unvoted) { %><a class="todo-item" href="/votes">🗳 <%= unvoted %> vote<%= unvoted === 1 ? '' : 's' %> you haven't cast</a><% } %>
  <% if (iOwe) { %><a class="todo-item" href="/bank">💵 You owe <%= money(-myBalance) %></a><% } %>
</div>
<% } %>

<div class="grid cols-2">

  <% if (sleeperStandings.length) { %>
  <div class="card">
    <h2>Live Standings <span class="sub">straight from Sleeper</span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>#</th><th>Team</th><th class="num">W-L</th><th class="num">PF</th></tr>
        <% for (const r of sleeperStandings) { %>
          <% if (r.rank === playoffTeams + 1) { %><tr><td colspan="4" style="padding:.15rem .8rem; font-size:.62rem; letter-spacing:.14em; text-transform:uppercase; color:var(--red-bright); border-bottom:1px dashed rgba(255,70,85,.5)">— playoff line (top <%= playoffTeams %>) —</td></tr><% } %>
          <tr class="<%= r.rank === sleeperStandings.length ? 'last-place' : '' %>">
            <td><%= r.rank %><%= r.rank === 1 ? ' 👑' : r.rank === sleeperStandings.length ? ' 🚽' : '' %></td>
            <td><b><%= r.owner_name || r.team %></b><% if (r.owner_name && r.owner_name !== r.team) { %> <span class="muted"><%= r.team %></span><% } %></td>
            <td class="num"><%= r.wins %>-<%= r.losses %><%= r.ties ? '-' + r.ties : '' %></td>
            <td class="num"><%= r.pf.toFixed(1) %></td>
          </tr>
        <% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% const boardHasScores = sleeperBoard.some(m => m.some(t => t.points > 0)); %>
  <% if (sleeperBoard.length && boardHasScores) { %>
  <div class="card">
    <h2>Week <%= sleeperData.week %> Scoreboard <span class="sub">live from Sleeper</span></h2>
    <div class="body">
      <% for (const m of sleeperBoard) { const hi = Math.max(...m.map(t => t.points)); %>
        <div class="matchup">
          <% for (const t of m) { %>
            <div class="mrow <%= t.points === hi && m.length > 1 && hi > 0 ? 'winning' : '' %>">
              <span><%= t.team %></span><b><%= t.points.toFixed(2) %></b>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <% if (review) { %>
  <div class="card">
    <h2>Week <%= reviewWeek %> in Review <span class="sub">auto-generated from Sleeper</span></h2>
    <div class="body tight">
      <table class="roll">
        <tr><td>👑 Top score</td><td><b><%= review.top.team %></b></td><td class="num"><%= review.top.points.toFixed(2) %></td></tr>
        <tr><td>🚽 Toilet of the week</td><td><b><%= review.low.team %></b></td><td class="num"><%= review.low.points.toFixed(2) %></td></tr>
        <% if (review.blowout) { %><tr><td>🔨 Beatdown</td><td><b><%= review.blowout.w.team %></b> over <%= review.blowout.l.team %></td><td class="num">by <%= review.blowout.margin.toFixed(2) %></td></tr><% } %>
        <% if (review.closest) { %><tr><td>😅 Nail-biter</td><td><b><%= review.closest.w.team %></b> edged <%= review.closest.l.team %></td><td class="num">by <%= review.closest.margin.toFixed(2) %></td></tr><% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (wireRows.length) { %>
  <%
    // A realistic mid-season wire is 40-60 transactions, which at ~60px a row is
    // more than this entire page. Capped structurally, with the count shown —
    // being told there are 47 more is the difference between "that's all of it"
    // and "there's more, tap to see".
    const WIRE_CAP = 6;
    const wireShown = wireRows.slice(0, WIRE_CAP);
    const wireRest = wireRows.slice(WIRE_CAP);
  %>
  <div class="card">
    <h2>The League Wire <span class="sub">latest moves on Sleeper</span></h2>
    <div class="body tight">
      <table class="roll">
        <% for (const w of wireShown) { %>
          <tr><td style="width:5.5rem"><span class="badge <%= w.trade ? 'gold' : 'navy' %>"><%= w.kind %></span></td><td><%= w.text %></td></tr>
        <% } %>
      </table>
      <% if (wireRest.length) { %>
        <details class="more-rows">
          <summary>See all <%= wireRows.length %> moves (<%= wireRest.length %> more)</summary>
          <table class="roll">
            <% for (const w of wireRest) { %>
              <tr><td style="width:5.5rem"><span class="badge <%= w.trade ? 'gold' : 'navy' %>"><%= w.kind %></span></td><td><%= w.text %></td></tr>
            <% } %>
          </table>
        </details>
      <% } %>
    </div>
  </div>
  <% } %>

  <div class="card" id="weekly-winners">
    <h2>Weekly High Point <span class="sub"><%= season.year %> — <%= money(season.weekly_payout) %> to the top score, regular season only</span></h2>
    <div class="body tight scroll-x">
      <% if (!weekly.length) { %>
        <p class="muted" style="padding:1rem">No weekly winners recorded yet.</p>
      <% } else { %>
      <table class="roll">
        <tr><th>Week</th><th>Winner</th><th class="num">Amount</th><th>Paid Out</th></tr>
        <% for (const w of weekly) { %>
          <tr>
            <td>Week <%= w.week %></td>
            <td><b><%= w.name %></b></td>
            <td class="num"><%= money(w.amount) %></td>
            <td><%= w.settled ? '✅' : '⏳ on the tab' %></td>
          </tr>
        <% } %>
      </table>
      <% } %>
    </div>
  </div>

  <% if (awards.length) { %>
  <div class="card">
    <h2><%= season.year %> Season Awards</h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Award</th><th>Owner</th><th class="num">Amount</th><th>Paid</th></tr>
        <% for (const a of awards) { %>
          <tr><td><%= CATEGORY_LABELS[a.category] || a.category %></td><td><b><%= a.name %></b></td><td class="num"><%= money(a.amount) %></td><td><%= a.settled ? '✅' : '⏳ on the tab' %></td></tr>
        <% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (standings.length) { %>
  <div class="card">
    <h2><%= season.year %> Final Standings</h2>
    <div class="body tight">
      <table class="roll">
        <tr><th>Place</th><th>Owner</th></tr>
        <% for (const s of standings) { %>
          <tr><td><%= s.rank %><%= ['st','nd','rd'][s.rank - 1] || 'th' %><%= s.rank === standings.length ? ' 🚽' : s.rank === 1 ? ' 👑' : '' %></td><td><b><%= s.name %></b></td></tr>
        <% } %>
      </table>
    </div>
  </div>
  <% } %>

  <div class="col-span-2" style="margin-top:.4rem">
    <details class="reference-block" id="pot-split">
      <summary>💵 How the <%= money(season.total_pot) %> pot splits — and everyone’s buy-in status</summary>
      <div class="grid cols-2" style="margin-top:.8rem">
  <div class="card">
    <h2>Buy-In Status <span class="sub"><a href="/bank" style="color:inherit">full ledger → League Finances</a></span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Owner</th><th>Buy-in</th><th class="num">Net Tab</th></tr>
        <% for (const b of buyins) { %>
          <tr>
            <td><b><%= b.owner.name %></b></td>
            <td><% if (b.paid) { %><span class="badge paid">Paid</span><% } else { %><span class="badge owes">Owes <%= money(season.buy_in) %></span><% } %></td>
            <td class="num <%= b.balance > 0 ? 'pos' : b.balance < 0 ? 'neg' : '' %>"><%= b.balance === 0 ? '—' : money(b.balance) %></td>
          </tr>
        <% } %>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Payout Structure <span class="sub">where the <%= money(season.total_pot) %> goes</span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr><th>Prize</th><th class="num">Share</th><th class="num">Amount</th></tr>
        <% if (season.weekly_payout) { %>
          <tr><td>🏈 Weekly High Point × <%= season.weeks %> weeks</td><td class="num"></td><td class="num"><%= money(season.weekly_payout) %> / wk</td></tr>
        <% } %>
        <% for (const r of payouts.reg) { %>
          <tr><td>📈 Regular Season <%= r.place === 1 ? 'Champ' : 'Runner-up' %></td><td class="num"><%= Math.round(r.pct * 1000) / 10 %>%</td><td class="num"><b><%= money(r.amount) %></b></td></tr>
        <% } %>
        <% for (const r of payouts.playoff) { %>
          <tr><td><%= ['🏆','🥈','🥉','4️⃣'][r.place - 1] %> Playoffs — <%= ['1st','2nd','3rd','4th'][r.place - 1] %></td><td class="num"><%= Math.round(r.pct * 1000) / 10 %>%</td><td class="num"><b><%= money(r.amount) %></b></td></tr>
        <% } %>
        <tr class="total"><td>Total pot</td><td></td><td class="num"><%= money(season.total_pot) %></td></tr>
      </table>
    </div>
  </div>

      </div>
    </details>
  </div>
</div>
<%- include('partials/footer') %>
