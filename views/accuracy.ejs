<%- include('partials/header', { title: 'Model Accuracy' }) %>
<%
  const v = view;
  const s = v.summary;
  const pct = n => n == null ? '—' : Math.round(n * 100) + '%';
  const f2 = n => n == null ? '—' : (Math.round(n * 1000) / 1000).toFixed(3);
  const money = n => n == null ? '—' : (n < 0 ? '−$' + Math.abs(Math.round(n)) : '$' + Math.round(n));
  const G = (typeof guide !== 'undefined' && guide) || {};
%>

<h1 class="page-title">📈 Model Accuracy
  <span class="sub" style="font-weight:600"><%= season %> · commissioner only — model internals, not league results</span>
</h1>

<div class="is-cols">
<div class="is-col">

<%# ── SUMMARY / PIPELINE STATE — honest before there's data ──────────────────── %>
<div class="card" style="margin-bottom:1.2rem; border-color:<%= v.graded ? 'rgba(15,138,77,.4)' : 'var(--line)' %>">
  <div class="body">
    <%- include('partials/_wr_explain', { ex: G.summary }) %>
    <div class="acc-stats">
      <div class="acc-stat"><span class="acc-num wr-num"><%= s.forecasts %></span><span class="acc-lbl">predictions logged</span></div>
      <div class="acc-stat"><span class="acc-num wr-num"><%= s.resolved %></span><span class="acc-lbl">resolved</span></div>
      <div class="acc-stat"><span class="acc-num wr-num"><%= s.graded %></span><span class="acc-lbl">graded</span></div>
      <div class="acc-stat"><span class="acc-num wr-num"><%= s.pending %></span><span class="acc-lbl">pending reality</span></div>
      <% if (s.disqualified) { %><div class="acc-stat"><span class="acc-num wr-num"><%= s.disqualified %></span><span class="acc-lbl">disqualified</span></div><% } %>
    </div>
    <% if (!s.everRun) { %>
      <p class="acc-empty" style="margin:.9rem 0 0">
        <b>Grading hasn't run yet.</b>
        <%= s.rawCount %> prediction record<%= s.rawCount === 1 ? '' : 's' %> <%= s.rawCount === 1 ? 'is' : 'are' %> logged and waiting.
        Calibration, the weekly grade, the attribution table and the misses all light up here once the weekly grading runs and writes the calibration ledger — nothing is faked in the meantime.
      </p>
    <% } else { %>
      <% if (s.newlyGraded != null) { %>
        <p style="margin:.9rem 0 0"><b><%= s.newlyGraded %> newly graded</b> in the latest run<% if (s.newlyGraded === 0) { %> — nothing new resolved since the run before it<% } %>.</p>
      <% } else if (s.runs === 1) { %>
        <p style="margin:.9rem 0 0"><b>First grading run.</b> From the next one on, this line says how many landed since the last.</p>
      <% } %>
      <p class="muted" style="margin:.4rem 0 0; font-size:.8rem">
        Graded through <%= s.throughWeek != null ? 'week ' + s.throughWeek : '—' %><% if (s.generatedAt) { %> · last graded <%= new Date(s.generatedAt).toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %> ET<% } %>.
        Every forecast is graded only if it was committed strictly before it resolved — no backdating counts.
      </p>
    <% } %>
  </div>
</div>

<%# ── CALIBRATION — when it says 70%, does it happen 70%? ─────────────────────── %>
<div class="card" style="margin-bottom:1.2rem">
  <h2>🎯 Calibration <span class="sub">when it says 70%, does it happen 70%?</span></h2>
  <div class="body">
    <%- include('partials/_wr_explain', { ex: G.calibration }) %>
    <% if (!v.graded || !v.calibration) { %>
      <p class="acc-empty" style="margin:0">Not yet graded — 0 predictions resolved. The calibration curve draws itself once probability forecasts start resolving.</p>
    <% } else { const c = v.calibration; %>
      <div class="acc-metric-row">
        <div class="acc-metric">
          <span class="acc-metric-lbl">Probability (Brier)</span>
          <span class="acc-metric-val wr-num"><%= f2(c.probability.brier) %></span>
          <span class="acc-metric-sub"><%= c.probability.n %> call<%= c.probability.n === 1 ? '' : 's' %> · lower is better, .250 = a coin</span>
        </div>
        <div class="acc-metric">
          <span class="acc-metric-lbl">Point (bias / MAE)</span>
          <span class="acc-metric-val wr-num"><%= c.point.bias == null ? '—' : (c.point.bias >= 0 ? '+' : '') + c.point.bias %></span>
          <span class="acc-metric-sub"><%= c.point.n %> call<%= c.point.n === 1 ? '' : 's' %> · <%= c.point.mae == null ? '—' : 'off by ' + c.point.mae %> avg<%= c.point.bias > 0 ? ' · runs high' : c.point.bias < 0 ? ' · runs low' : '' %></span>
        </div>
        <div class="acc-metric">
          <span class="acc-metric-lbl">Categorical (accuracy)</span>
          <span class="acc-metric-val wr-num"><%= pct(c.categorical.accuracy) %></span>
          <span class="acc-metric-sub"><%= c.categorical.n %> call<%= c.categorical.n === 1 ? '' : 's' %></span>
        </div>
      </div>

      <% if (c.probability.reliability && c.probability.reliability.length) { %>
        <h3 class="acc-subhead">The reliability curve — said vs happened</h3>
        <div class="acc-rel">
          <% for (const b of c.probability.reliability) { if (!b.n) continue; %>
            <div class="acc-rel-row">
              <span class="acc-rel-said">said ~<%= pct(b.mid) %></span>
              <div class="acc-rel-track">
                <div class="acc-rel-ideal" style="left:<%= Math.round((b.mid||0)*100) %>%" title="perfectly calibrated"></div>
                <div class="acc-rel-fill" style="width:<%= Math.round((b.observed||0)*100) %>%"></div>
              </div>
              <span class="acc-rel-obs">happened <%= pct(b.observed) %> <span class="muted">(<%= b.n %>)</span></span>
            </div>
          <% } %>
          <p class="muted" style="margin:.5rem 0 0; font-size:.74rem">The tick is perfect calibration; the bar is what actually happened. Bar short of the tick = overconfident, past it = underconfident.</p>
        </div>
      <% } %>

      <% if (v.byKind && v.byKind.length) { %>
        <h3 class="acc-subhead">By prediction type — the report card</h3>
        <%- include('partials/_wr_explain', { ex: G.bykind }) %>
        <div class="scroll-x"><table class="roll">
          <tr><th>Type</th><th class="num">n</th><th>Hit rate <span class="muted" style="font-weight:400">vs the 50% coin</span></th><th class="num">Brier</th><th class="num">MAE</th><th class="num">Scored · edge</th></tr>
          <% for (const k of v.byKind) { %>
            <tr class="<%= k.n < 5 ? 'acc-thin' : '' %>">
              <td><%= k.label %><% if (k.n < 5) { %> <span class="muted" style="font-size:.68rem">(thin sample)</span><% } %></td>
              <td class="num"><%= k.n %></td>
              <td>
                <% if (k.accuracy != null) { %>
                  <span class="acc-kind-bar">
                    <span class="track"><i style="width:<%= Math.round(k.accuracy * 100) %>%"></i><span class="bench" title="a coin flip: 50%"></span></span>
                    <span class="wr-num"><%= pct(k.accuracy) %></span>
                  </span>
                <% } else { %>—<% } %>
              </td>
              <td class="num"><%= k.brier == null ? '—' : f2(k.brier) %></td>
              <td class="num"><%= k.mae == null ? '—' : k.mae %></td>
              <%# The DECISION rows carry two more measured facts nothing rendered
                  before this pass (rule 14's shape, caught on the display side):
                  how many of the logged decisions have actually resolved, and the
                  measured edge in real points — the decision as recorded vs its
                  recorded alternative. Null on forecast rows, where they have no
                  meaning, and shown as such. %>
              <td class="num">
                <% if (k.scored != null) { %><%= k.scored %> of <%= k.n %><% if (k.meanEdge != null) { %> · <%= k.meanEdge >= 0 ? '+' : '' %><%= k.meanEdge %> pts<% } %><% } else { %>—<% } %>
              </td>
            </tr>
          <% } %>
        </table></div>
      <% } %>

      <% if (v.byWeek && v.byWeek.length) { %>
        <h3 class="acc-subhead">Over time</h3>
        <div class="scroll-x"><table class="roll">
          <tr><th>Week</th><th class="num">graded</th><th class="num">Brier</th><th class="num">Accuracy</th></tr>
          <% for (const w of v.byWeek) { %>
            <tr><td>wk <%= w.week %></td><td class="num"><%= w.n_graded || 0 %></td>
              <td class="num"><%= w.brier == null ? '—' : f2(w.brier) %></td>
              <td class="num"><%= w.accuracy == null ? '—' : pct(w.accuracy) %></td></tr>
          <% } %>
        </table></div>
      <% } %>
    <% } %>
  </div>
</div>

</div><%# /is-col %>
<div class="is-col">

<%# ── THE OVERRIDE RECORD — am I adding value on top of the tool, or subtracting?
    The grader has been computing this since the loop closed; nothing rendered it. %>
<% const C = v.captured; %>
<% if (C) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>🙋 Your overrides <span class="sub">how often you went against the tool, and by how much</span></h2>
    <div class="body">
      <%- include('partials/_wr_explain', { ex: G.overrides }) %>
      <div class="acc-ov">
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= C.decisions %></span><span class="acc-ov-lbl">lineup decisions</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= C.overrides %></span><span class="acc-ov-lbl">you overrode</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= C.rate %>%</span><span class="acc-ov-lbl">of the time</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= C.gapMax != null ? '$' + C.gapMax : '—' %></span><span class="acc-ov-lbl">biggest gap</span></div>
      </div>
      <% if (C.overrides) { %>
        <p class="muted" style="margin:.6rem 0 .2rem; font-size:.8rem">
          <b><%= C.contested %></b> of <%= C.overrides %> <%= C.contested === 1 ? 'was' : 'were' %> <b>contested</b> —
          the tool was within $2 of indifferent, so going the other way cost about nothing.
          <% if (C.gapTotal != null) { %>Across all of them the tool said <b>$<%= Math.abs(C.gapTotal) %></b> was at stake;
          that is the size of the disagreement, not a claim about who was right.<% } %>
        </p>
        <div class="scroll-x"><table class="roll">
          <tr><th>Week</th><th>Why</th><th class="num">Gap</th><th class="num">Contested</th></tr>
          <% for (const w of C.weeks) { %>
            <tr><td><%= w.week != null ? 'wk ' + w.week : '—' %></td>
              <td><%= w.reason %></td>
              <td class="num"><%= w.gap == null ? '—' : (w.gap < 0 ? '−$' : '$') + Math.abs(Math.round(w.gap)) %></td>
              <td class="num"><%= w.contested ? 'yes' : 'no' %></td></tr>
          <% } %>
        </table></div>
      <% } else { %>
        <p class="muted" style="margin:.6rem 0 0; font-size:.8rem">
          You've followed the tool every logged week so far. The override button on the optimizer records the other case in one tap.
        </p>
      <% } %>
      <p class="acc-empty" style="margin:.7rem 0 0">
        <b>How they turned out isn't measured yet.</b> That needs each override's outcome joined against what
        the tool recommended, which is the grading half — it covers the draft decisions today and not these.
        The gaps above are real; the verdict column is deliberately absent rather than guessed.
      </p>
    </div>
  </div>
<% } %>

<% const D = v.decisions; %>
<% if (D && D.n > 0) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>⚖️ Graded decisions <span class="sub">draft picks — where an outcome is joined to the recommendation</span></h2>
    <div class="body">
      <div class="acc-ov">
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= D.n %></span><span class="acc-ov-lbl">decisions logged</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= D.overridden %></span><span class="acc-ov-lbl">you overrode</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= D.scored %></span><span class="acc-ov-lbl">scored so far</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num <%= D.rate != null && D.rate >= 50 ? 'pos' : '' %>"><%= D.rate != null ? D.rate + '%' : '—' %></span><span class="acc-ov-lbl">of those you won</span></div>
      </div>
      <p class="muted" style="margin:.6rem 0 0; font-size:.78rem">
        <% if (D.scored === 0) { %>
          Nothing scored yet — an override is only graded once its week resolves. The count above is what's waiting.
        <% } else if (D.scored < 8) { %>
          <b>Too few to read as a verdict</b> (<%= D.scored %> scored). This is the honest sample, not a judgement — it takes a season to mean anything.
        <% } else { %>
          Across <%= D.scored %> scored overrides you were right <b><%= D.rate %>%</b> of the time. This is the DRAFT half of that question — the in-season half is below.
        <% } %>
      </p>
    </div>
  </div>
<% } %>

<%# ── IN-SEASON DECISION ACCURACY — start/sit, waiver and streaming calls
    against their modelled counterfactual, plus overrides against the tool's
    rejected recommendation. Computed every grade-cron run since 2026-08-15;
    this is the first render of it. A tie counts toward "scored" but not
    toward either side's rate — the rate is read over the DECIDED subset,
    same discipline as the draft card above. %>
<% const ID = v.inseasonDecisions; %>
<% if (ID) { %>
  <div class="card" style="margin-bottom:1.2rem">
    <h2>📅 In-season decisions <span class="sub">start/sit, waivers and streaming — tool vs. what you'd have done without it</span></h2>
    <div class="body">
      <div class="acc-ov">
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= ID.n %></span><span class="acc-ov-lbl">decisions logged</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num"><%= ID.scored %></span><span class="acc-ov-lbl">scored so far</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num <%= ID.tool.rate != null && ID.tool.rate >= 50 ? 'pos' : '' %>"><%= ID.tool.rate != null ? ID.tool.rate + '%' : '—' %></span><span class="acc-ov-lbl">tool beat the alternative</span></div>
        <div class="acc-ov-cell"><span class="acc-ov-num wr-num <%= ID.human.rate != null && ID.human.rate >= 50 ? 'pos' : '' %>"><%= ID.human.rate != null ? ID.human.rate + '%' : '—' %></span><span class="acc-ov-lbl">you beat the tool</span></div>
      </div>
      <p class="muted" style="margin:.6rem 0 0; font-size:.78rem">
        <% if (!ID.scored) { %>
          Nothing scored yet — a week's calls grade once that week resolves. The count above is what's captured and waiting.
        <% } else { %>
          <% if (!ID.tool.readable && !ID.human.readable) { %>
            <b>Too few decided (non-tied) results to read as a verdict</b> — <%= ID.tool.decided %> tool-side, <%= ID.human.decided %> override-side. The honest sample, not a judgement yet.
          <% } else { %>
            <% if (ID.tool.readable) { %>Over <%= ID.tool.decided %> decided start/sit, waiver and streaming calls, the tool's pick beat what you'd have done without it <b><%= ID.tool.rate %>%</b> of the time.<% } %>
            <% if (ID.human.readable) { %> Over <%= ID.human.decided %> decided overrides, you beat the tool's rejected recommendation <b><%= ID.human.rate %>%</b> of the time.<% } %>
          <% } %>
          <% if (ID.n - ID.scored > 0) { %> <%= ID.n - ID.scored %> more await their week's resolution.<% } %>
        <% } %>
      </p>
      <% if (ID.byKind && ID.byKind.length) { %>
        <div class="scroll-x" style="margin-top:.6rem"><table class="roll">
          <tr><th>Kind</th><th class="num">Logged</th><th class="num">Scored</th><th class="num">Decided</th><th class="num">Won</th></tr>
          <% for (const k of ID.byKind) { %>
            <tr><td><%= k.label %></td><td class="num"><%= k.n %></td><td class="num"><%= k.scored %></td>
              <td class="num"><%= k.decided %></td><td class="num"><%= k.won %></td></tr>
          <% } %>
        </table></div>
      <% } %>
    </div>
  </div>
<% } %>

<%# ── CALIBRATION OVER TIME — one point per grading run. A single snapshot says
    how calibrated it is now; the series says whether it's getting better. %>
<% const S = v.series || []; %>
<% if (S.length > 1) { %>
  <% const pts = S.filter(p => p.brier != null); %>
  <% if (pts.length > 1) { const worst = Math.max(...pts.map(p => p.brier), 0.25); %>
    <div class="card" style="margin-bottom:1.2rem">
      <h2>📉 Calibration over time <span class="sub">Brier score per grading run — lower is better</span></h2>
      <div class="body">
        <div class="acc-series">
          <% for (const p of pts) { const h = Math.max(4, Math.round((p.brier / worst) * 100)); %>
            <div class="acc-bar" title="<%= new Date(p.at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> — Brier <%= p.brier.toFixed(3) %> (<%= p.graded %> graded)">
              <i style="height:<%= h %>%"></i>
              <span class="wr-num"><%= p.brier.toFixed(2) %></span>
            </div>
          <% } %>
        </div>
        <p class="muted" style="margin:.5rem 0 0; font-size:.78rem">
          <%= pts.length %> grading run<%= pts.length === 1 ? '' : 's' %>. Brier is mean squared error on the
          probability calls (0 = perfect, 0.25 = a coin flip).
          <% if (pts.length < 5) { %>
            <b>Too few runs to read as a trend</b> — this is the record so far, not a direction. Ask it again in a month.
          <% } else { %>
            Falling bars mean the model is learning; flat or rising means it isn't.
          <% } %>
        </p>
      </div>
    </div>
  <% } %>
<% } %>

</div><%# /is-col %>
</div><%# /is-cols %>

<div class="is-cols even is-zone3">
<div class="is-col">

<%# ── WHAT GOT GRADED — readable, not a data dump ────────────────────────────── %>
<div class="card" style="margin-bottom:1.2rem">
  <h2>🧾 Recently graded <span class="sub"><% if (v.recentlyTotal > (v.recently||[]).length) { %>the latest <%= (v.recently||[]).length %> of <%= v.recentlyTotal %><% } else { %>what it claimed · what happened · right?<% } %></span></h2>
  <div class="body">
    <% if (!v.recently || !v.recently.length) { %>
      <p class="acc-empty" style="margin:0">Nothing graded yet. As predictions resolve, the latest ones land here in plain language.</p>
    <% } else { %>
      <ul class="acc-graded">
        <% for (const g of v.recently) { %>
          <li class="acc-graded-row <%= g.hit === true ? 'hit' : g.hit === false ? 'miss' : '' %>">
            <span class="acc-graded-mark"><%= g.hit === true ? '✓' : g.hit === false ? '✗' : '·' %></span>
            <span class="acc-graded-claim"><%= g.claim %><% if (g.week != null) { %> <span class="muted">wk <%= g.week %></span><% } %></span>
            <span class="acc-graded-out">said <b><%= g.said %></b> → <%= g.happened %><% if (g.metric) { %> <span class="muted">(<%= g.metric %>)</span><% } %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </div>
</div>

</div><%# /is-col %>
<div class="is-col">

<%# ── BIGGEST MISSES — the failure modes, not just the aggregate ──────────────── %>
<div class="card" style="margin-bottom:1.2rem">
  <h2>💥 Where it was most wrong <span class="sub"><% if (v.missesTotal > (v.biggestMisses||[]).length) { %>the <%= (v.biggestMisses||[]).length %> worst of <%= v.missesTotal %> misses<% } else { %>the failure modes, ranked<% } %></span></h2>
  <div class="body">
    <%- include('partials/_wr_explain', { ex: G.misses }) %>
    <% if (!v.biggestMisses || !v.biggestMisses.length) { %>
      <p class="acc-empty" style="margin:0">No graded misses yet — this ranks the most confident wrong calls once there are any.</p>
    <% } else { %>
      <ol class="acc-misses">
        <% for (const m of v.biggestMisses) { const g = m.line; %>
          <li>
            <span class="acc-miss-claim"><%= g.claim %></span>
            <span class="acc-miss-detail muted">said <b><%= g.said %></b> → <%= g.happened %><% if (g.metric) { %> · <%= g.metric %><% } %></span>
          </li>
        <% } %>
      </ol>
    <% } %>
  </div>
</div>

</div><%# /is-col %>
</div><%# /is-cols %>

<%# ── ATTRIBUTION — the table filling in, unmeasured cells honest ─────────────── %>
<div class="card is-zone3" style="margin-bottom:1.2rem">
  <h2>🧮 Attribution <span class="sub">what each component has actually been worth</span></h2>
  <div class="body">
    <%- include('partials/_wr_explain', { ex: G.attribution }) %>
    <% if (!v.attribution || !v.attribution.components.length) { %>
      <p class="acc-empty" style="margin:0">The attribution table fills in as the season grades decisions. Nothing measured yet — no cells are guessed to look full.</p>
    <% } else { const a = v.attribution; %>
      <p class="muted" style="margin:0 0 .7rem; font-size:.8rem">
        <%= a.measuredN %> of <%= a.components.length %> component<%= a.components.length === 1 ? '' : 's' %> measured;
        <%= a.unmeasuredN %> still <b>unmeasured</b> and shown as such rather than filled with a number that doesn't exist.
        Read as “$X realised on decisions where the tool recommended Y”, never “the tool earned $X”.
      </p>
      <div class="scroll-x"><table class="roll">
        <tr><th>Component</th><th class="num">Realised</th><th class="num">Interval</th><th class="num">n</th></tr>
        <% for (const c of a.components) { %>
          <tr class="<%= c.measured ? '' : 'acc-unmeasured' %>">
            <td><%= c.label %><% if (c.note) { %><br><span class="muted" style="font-size:.72rem"><%= c.note %></span><% } %></td>
            <% if (c.measured) { %>
              <td class="num"><%= money(c.realized) %></td>
              <td class="num"><%= (c.ciLow == null || c.ciHigh == null) ? '—' : money(c.ciLow) + ' … ' + money(c.ciHigh) %></td>
              <td class="num"><%= c.n %></td>
            <% } else { %>
              <td class="num muted" colspan="3">unmeasured — <%= c.note || 'no graded evidence yet' %></td>
            <% } %>
          </tr>
        <% } %>
      </table></div>
    <% } %>
  </div>
</div>

<p style="text-align:center; margin-top:1rem">
  <a class="btn navy" href="/lineup">← Lineup Optimizer</a>
  <a class="btn navy" href="/admin/warroom">War Room</a>
</p>
<%- include('partials/footer') %>
