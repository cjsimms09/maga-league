<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' && title ? title + ' — ' : '' %>MFGA League</title>
<%# System fonts only (see --font-* tokens in style.css). No web-font <link>:
    it was dead weight — the CSS never names Archivo/Inter — and a render-
    blocking external fetch is exactly what a chromeless standalone launch on a
    flaky connection cannot afford. Dropping it removes a point of failure. %>
<link rel="stylesheet" href="/css/style.css">
<%# Contact directory card + tap targets — site-wide, behind login. %>
<link rel="stylesheet" href="/css/contact.css">
<%# The Chronicle carries its own stylesheet, loaded only where it renders. %>
<% if (typeof currentPath !== 'undefined' && /^\/history(\/|$|\?)/.test(currentPath) && !(typeof section !== 'undefined' && section)) { %>
<link rel="stylesheet" href="/css/chronicle.css">
<% } %>
<link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16.png">
<%# Home-screen install. The manifest covers Android/Chrome; the apple-* tags
    are what iOS reads, because Safari still ignores the manifest for this. The
    eagle-on-a-football mark is the single mark used for the icon, splash and
    the header logo (public/icons/icon.svg → rasterized PNGs). %>
<link rel="manifest" href="/manifest.webmanifest">
<%# ?v=2 cache-bust: iOS + the CDN hold /icons/* for 7 days, and a 404 cached at
    the bare URL before the file existed on main could pin a blank navy square even
    now that the correct PNG is deployed. A fresh URL cannot be serving that stale
    404. Bump the version if the icon is ever replaced again. %>
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=2">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="MFGA">
<meta name="theme-color" content="#f7f6f2">
<%# iOS launch (splash) images — a branded navy screen with the mark instead of
    a white flash, for the common iPhone sizes. Others fall back gracefully. %>
<link rel="apple-touch-startup-image" media="(device-width:393px) and (device-height:852px) and (-webkit-device-pixel-ratio:3)" href="/icons/splash-1179x2556.png">
<link rel="apple-touch-startup-image" media="(device-width:430px) and (device-height:932px) and (-webkit-device-pixel-ratio:3)" href="/icons/splash-1290x2796.png">
<link rel="apple-touch-startup-image" media="(device-width:428px) and (device-height:926px) and (-webkit-device-pixel-ratio:3)" href="/icons/splash-1284x2778.png">
<link rel="apple-touch-startup-image" media="(device-width:390px) and (device-height:844px) and (-webkit-device-pixel-ratio:3)" href="/icons/splash-1170x2532.png">
<link rel="apple-touch-startup-image" media="(device-width:375px) and (device-height:812px) and (-webkit-device-pixel-ratio:3)" href="/icons/splash-1125x2436.png">
<link rel="apple-touch-startup-image" media="(device-width:375px) and (device-height:667px) and (-webkit-device-pixel-ratio:2)" href="/icons/splash-750x1334.png">
</head>
<%# Body classes UNION two independent needs: `is-champ` (main — champion styling) and
    `warroom-page` (B — collapses masthead/announcements server-side so the draft tool's
    recommendation is above the fold with no flash before app.js runs; app.js re-adds it +
    sim-state classes, idempotent). Neither may drop the other. %>
<body class="<%= [
      (typeof viewerIsChamp !== 'undefined' && viewerIsChamp) ? 'is-champ' : '',
      (typeof currentPath !== 'undefined' && /^\/admin\/warroom/.test(currentPath)) ? 'warroom-page' : ''
    ].filter(Boolean).join(' ') %>">
<%
  // Guard everything: the error page renders this header even when the
  // request died before locals were populated.
  const _owner = typeof owner !== 'undefined' ? owner : null;
  const _alerts = typeof alerts !== 'undefined' && alerts ? alerts : [];
  const _path = typeof currentPath !== 'undefined' ? currentPath : '';
  const _isChamp = typeof viewerIsChamp !== 'undefined' && viewerIsChamp;
  const _reign = typeof reigningYear !== 'undefined' ? reigningYear : '';
  // The full-size masthead is branding, and branding earns its 138px exactly
  // once — on the page you land on. Everywhere else it is a toll you pay to
  // reach the content you navigated to, so it collapses to a single line.
  const _home = _path === '/' || !_owner;
  // TOOL mode (war room): a focused decision surface, not a page you land on for
  // branding. Suppress the masthead entirely so the tool starts at the top of the
  // phone — every pixel above the recommendation is a pixel it can't afford.
  const _tool = typeof tool !== 'undefined' && tool;
%>
<%# The defending champ's own screen wears a thin, earned ribbon on the home page —
    subtle, not a shout. Nobody else sees it; it is his year. %>
<% if (_isChamp && _home) { %><div class="champ-ribbon">👑 Your title to defend<%= _reign ? ' · ' + _reign + ' champion' : '' %></div><% } %>
<a class="skip-link" href="#main">Skip to content</a>
<% if (!_tool) { %>
<header class="masthead <%= _home ? '' : 'compact' %>">
  <div class="eagle" title="Back-to-back World War champs. Undefeated since 1776."><img src="/icons/icon.svg" alt="MFGA" width="512" height="512" loading="eager"></div>
  <h1><a href="/"><span class="flag">🇺🇸</span> Make Football <span class="gold">Great Again</span> <span class="flag">🇺🇸</span></a></h1>
  <p class="tagline">Fantasy Football League &nbsp;•&nbsp; Est. 2016 &nbsp;•&nbsp; The Greatest League in the History of Leagues, Maybe Ever</p>
  <div class="stars">★ ★ ★ ★ ★</div>
</header>
<% } %>
<% if (_owner) { %>
<%
  // One source of truth for navigation. The desktop bar renders all of it; the
  // phone gets the four destinations people actually visit weekly, and the rest
  // lives behind "More". Splitting the list in two places is how they drift.
  const _unread = typeof chatUnread !== 'undefined' ? chatUnread : 0;
  const _bets = typeof betsWaiting !== 'undefined' ? betsWaiting : 0;
  const _nav = [
    { href: '/',        label: 'League Office', short: 'Office',  icon: '🏛',  primary: true },
    { href: '/team',    label: 'My Team',       short: 'Team',    icon: '🏈',  primary: true },
    { href: '/scoreboard', label: 'This Week',   short: 'Scores',  icon: '🏈', match: '/scoreboard' },
    { href: '/matchup', label: 'The Matchup',   short: 'Matchup', icon: '⚔️', match: '/matchup' },
    { href: '/pickem',  label: "Pick'em",       short: "Pick'em", icon: '🗳️', match: '/pickem' },
    { href: '/watch',   label: 'What to Watch', short: 'Watch',   icon: '📺', match: '/watch' },
    { href: '/bank',    label: 'League Finances', short: 'Finances', icon: '💰',  primary: true, badge: _bets },
    { href: '/chat',    label: 'Locker Room',   short: 'Locker',  icon: '💬',  primary: true, badge: _unread },
    { href: '/draft',   label: 'Draft Spot',     short: 'Draft',   icon: '🎯',  match: '/draft' },
    { href: '/votes',   label: 'Voting Booth',  short: 'Votes',   icon: '🗳',  match: '/votes' },
    // Owners and Record Book are sections of /history now, not nav items.
    // Three entries answering one question ("who has won what") cost three
    // slots in a bar that was already 70% off-screen on a phone.
    { href: '/history', label: 'History',       short: 'History', icon: '🏛', match: '/history' },
    { href: '/rules',   label: 'Rules',         short: 'Rules',   icon: '⚖️' },
  ];
  if (_owner.is_commissioner) {
    // Commissioner-only: the Lineup Optimizer renders per-owner efficiency/bench
    // analysis. Results are league property, analysis is the commissioner's — so
    // the link only exists for the commissioner, and the route 403s regardless.
    _nav.push({ href: '/lineup',         label: '🎯 Lineup Optimizer', short: 'Lineup', icon: '🎯', commish: true, match: '/lineup' });
    // The waiver tool. Commissioner-only for the same reason the optimizer is —
    // it generates a recommendation (ACCESS-RULE.md).
    _nav.push({ href: '/waivers',        label: '📋 Waiver Wire', short: 'Waivers', icon: '📋', commish: true, match: '/waivers' });
    _nav.push({ href: '/lineup/accuracy', label: '📈 Model Accuracy', short: 'Accuracy', icon: '📈', commish: true, match: '/lineup/accuracy' });
    // The Analyzer: league-wide playoff odds + the postures the other tools read.
    // "Who is desperate" is analysis, not a league-visible result — commish-only.
    _nav.push({ href: '/analyzer',       label: '📊 Analyzer',      short: 'Analyzer', icon: '📊', commish: true, match: '/analyzer' });
    _nav.push({ href: '/admin',          label: '⭐ Commish',   short: 'Commish',  icon: '⭐', commish: true });
    _nav.push({ href: '/admin/warroom',  label: '🧠 War Room',  short: 'War Room', icon: '🧠', commish: true });
    // The recap is the only thing that reaches the whole league, and the preview
    // is how it gets read before it does. A page nobody can find is a check
    // nobody performs.
    _nav.push({ href: '/admin/recap',     label: '📰 Weekly Recap', short: 'Recap', icon: '📰', commish: true, match: '/admin/recap' });
  }
  const _isActive = n => n.match ? _path.startsWith(n.match) : _path === n.href;
  const _primary = _nav.filter(n => n.primary);
  const _more = _nav.filter(n => !n.primary);
  const _moreActive = _more.some(_isActive);
%>
<nav class="navbar" aria-label="Main">
  <% for (const n of _nav) { %>
    <a href="<%= n.href %>" class="<%= n.commish ? 'commish ' : '' %><%= _isActive(n) ? 'active' : '' %>"<%= n.commish ? ' title="Commissioner only"' : '' %>><%= n.label %><% if (n.badge) { %><span class="nav-badge"><%= n.badge %></span><% } %></a>
  <% } %>
  <span class="who"><%= _owner.name %></span>
  <a href="/password" title="Change password" style="padding:.5rem .4rem">🔑</a>
  <form method="post" action="/logout" data-no-busy><button type="submit">Log out</button></form>
</nav>

<nav class="tabbar" aria-label="Primary">
  <% for (const n of _primary) { %>
    <a href="<%= n.href %>" class="<%= _isActive(n) ? 'active' : '' %>"<%= _isActive(n) ? ' aria-current="page"' : '' %>>
      <span class="tb-icon" aria-hidden="true"><%= n.icon %></span>
      <span class="tb-label"><%= n.short %></span>
      <% if (n.badge) { %><span class="tb-badge"><%= n.badge %></span><% } %>
    </a>
  <% } %>
  <details class="more-sheet<%= _moreActive ? ' active' : '' %>">
    <summary aria-label="More pages">
      <span class="tb-icon" aria-hidden="true">☰</span>
      <span class="tb-label">More</span>
    </summary>
    <div class="more-panel">
      <div class="more-head"><%= _owner.name %></div>
      <div class="more-links">
        <% for (const n of _more) { %>
          <a href="<%= n.href %>" class="<%= n.commish ? 'commish ' : '' %><%= _isActive(n) ? 'active' : '' %>"><span aria-hidden="true"><%= n.icon %></span> <%= n.short %></a>
        <% } %>
        <a href="/password"><span aria-hidden="true">🔑</span> Password</a>
      </div>
      <form method="post" action="/logout" data-no-busy><button class="more-logout" type="submit">Log out</button></form>
    </div>
  </details>
</nav>
<%
  // Urgent first, then the rest. A stack of banners buries the page it is
  // supposed to be introducing, so we cap what renders expanded — and the cap
  // is tighter away from the dashboard, where you arrived wanting a specific
  // page, not the announcements you already read on the way in.
  const _sorted = [..._alerts].sort((a, b) =>
    (b.level === 'urgent') - (a.level === 'urgent'));
  const _cap = _home ? 2 : _sorted.filter(a => a.level === 'urgent').length ? 1 : 0;
  const _shown = _sorted.slice(0, _cap);
  const _rest = _sorted.slice(_cap);
  const _e = s => String(s == null ? '' : s).replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const _banner = a => `<div class="alert-banner alert-${_e(a.level)}"><span class="tag">`
    + (a.level === 'urgent' ? '🚨' : a.level === 'warning' ? '⚠️' : '📣') + '</span><span>'
    + _e(a.message)
    + (a.href ? ` <a href="${_e(a.href)}" style="color:inherit; font-weight:800">${_e(a.linkText || 'Open →')}</a>` : '')
    + '</span></div>';
%>
<%# League announcements are for the pages you browse — not the war room, a focused
    tool where the fold belongs to the pick. Suppressed in tool mode. %>
<% if (!_tool) { %>
<div class="alert-region" role="region" aria-label="League announcements" aria-live="polite">
  <% for (const a of _shown) { %><%- _banner(a) %><% } %>
  <% if (_rest.length) { %>
    <details class="alert-more">
      <summary><%= _shown.length ? _rest.length + ' more announcement' : _rest.length + ' announcement' %><%= _rest.length === 1 ? '' : 's' %></summary>
      <% for (const a of _rest) { %><%- _banner(a) %><% } %>
    </details>
  <% } %>
</div>
<% } %>
<% } %>
<main class="wrap" id="main">
