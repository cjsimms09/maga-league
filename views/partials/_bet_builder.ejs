<%
  /* ── The betting slip ────────────────────────────────────────────────────
   *
   * The old version put every field for every kind of bet on screen at once and
   * asked you to work out which ones applied to you. That is a builder, and a
   * builder is the wrong shape for something you fill in on a phone while the
   * group chat is going.
   *
   * A slip is the right shape: pick what kind of bet it is, and only that bet's
   * fields exist. Four tickets cover everything this league has ever actually
   * wagered on; "Something else" is free text and settles by hand, which is how
   * every side bet worked before this page existed.
   *
   * Everything a ticket cannot express is still reachable — the pool's rule
   * chain, extra tiebreakers, posting to the board — it just isn't in your way
   * until you've said what you're doing.
   */
  const others = owners.filter(o => o.id !== owner.id);
  const thisWeek = (typeof currentWeek !== 'undefined' && currentWeek) ? currentWeek : 1;
%>
<details class="card entry-card bet-builder" id="propose" style="margin-bottom:1.2rem">
  <summary>➕ Start a bet <span class="sub">pick the kind, fill in two things, send it</span></summary>
  <div class="body">
    <form method="post" action="/sidebets" class="entry-form" id="bet-form">

      <%# ── 1. What kind of bet ──────────────────────────────────────────── %>
      <div class="tickets" role="radiogroup" aria-label="Kind of bet">
        <label class="ticket">
          <input type="radio" name="ticket" value="pool" checked>
          <span>
            <b>🏆 Season pool</b>
            <small>We each pick teams. Whoever has the champion wins.</small>
          </span>
        </label>
        <label class="ticket">
          <input type="radio" name="ticket" value="matchup">
          <span>
            <b>⚔️ Beat me this week</b>
            <small>My team outscores yours in week <%= thisWeek %>.</small>
          </span>
        </label>
        <label class="ticket">
          <input type="radio" name="ticket" value="finish">
          <span>
            <b>🏁 Finish above me</b>
            <small>Where we end up when the season's done.</small>
          </span>
        </label>
        <label class="ticket">
          <input type="radio" name="ticket" value="custom">
          <span>
            <b>✍️ Something else</b>
            <small>Write it in your own words. You settle it yourselves.</small>
          </span>
        </label>
      </div>

      <%# Hidden fields the tickets drive. The server parses exactly the same
          shape whichever ticket you picked — one code path, four front doors. %>
      <input type="hidden" name="format" id="f-format" value="pool">
      <input type="hidden" name="kind" id="f-kind" value="">
      <input type="hidden" name="logic" value="all">
      <input type="hidden" name="cond_test" id="f-test" value="" disabled>
      <input type="hidden" name="cond_subject" id="f-subject" value="<%= owner.id %>" disabled>
      <input type="hidden" name="cond_target_owner" id="f-target" value="" disabled>
      <input type="hidden" name="cond_when" id="f-when" value="" disabled>
      <input type="hidden" name="cond_week" id="f-week" value="<%= thisWeek %>" disabled>
      <input type="hidden" name="cond_target_place" id="f-place" value="" disabled>

      <%# ── 2. The ticket's own fields ───────────────────────────────────── %>

      <%# POOL %>
      <div class="tk tk-pool">
        <div class="ef-row">
          <label class="field" style="flex:0 1 200px">Teams each of us picks
            <input type="number" name="picks_required" min="1" max="10" value="5">
          </label>
        </div>
        <div class="rule-box">
          <div class="rule-head">Who wins it</div>
          <div id="rule-rows"></div>
          <button type="button" class="btn small navy" id="rule-add">+ Add a tiebreaker</button>
          <p class="muted" style="font-size:.76rem; margin:.5rem 0 0">
            Checked in order. Most years nobody picks the champion — a tiebreaker
            is what stops that being an argument.
          </p>
        </div>
        <div class="ef-row">
          <div class="field" style="flex:1 1 100%">Your teams
            <span class="muted" id="pick-count"></span>
            <div class="sb-people" id="pool-picks">
              <% for (const o of owners) { %>
                <label class="sb-person">
                  <input type="checkbox" name="picks" value="<%= o.id %>"> <%= o.name %><%= o.id === owner.id ? ' (you)' : '' %>
                </label>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%# MATCHUP %>
      <div class="tk tk-matchup" hidden>
        <p class="bb-lede">Your team against theirs in <b>week <%= thisWeek %></b>, straight up on
        points. Settles when the week ends — and it has to be accepted <b>before
        kickoff</b>, so nobody can take it once they've seen a score.</p>
      </div>

      <%# FINISH %>
      <div class="tk tk-finish" hidden>
        <p class="bb-lede">Whoever finishes higher in the final standings takes it.
        Has to be accepted before the season starts.</p>
      </div>

      <%# CUSTOM %>
      <div class="tk tk-custom" hidden>
        <div class="ef-row">
          <label class="field" style="flex:1 1 100%">What's the bet?
            <textarea name="terms" maxlength="1200" rows="3"
              placeholder="e.g. Loser buys dinner at the draft. Winner picks the restaurant."></textarea>
          </label>
        </div>
        <p class="bb-lede">The site tracks it and remembers who owes who — but it
        can't grade this one, so you two agree the result and press the button.</p>
      </div>

      <%# ── 3. Money, and who you're betting ─────────────────────────────── %>
      <div class="ef-row">
        <label class="field" style="flex:1 1 130px">Wager each
          <input type="number" name="stake" step="1" min="1" placeholder="50" required>
        </label>
        <label class="field tk tk-custom" style="flex:2 1 220px" hidden>Settles when
          <input type="text" name="resolves" maxlength="120" placeholder="e.g. draft night">
        </label>
      </div>

      <div class="ef-row">
        <div class="field" style="flex:1 1 100%">Send this bet to
          <span class="muted">(they get an alert and have to accept)</span>
          <div class="sb-people">
            <% for (const o of others) { %>
              <label class="sb-person">
                <input type="checkbox" name="party" value="<%= o.id %>"> <%= o.name %>
              </label>
            <% } %>
          </div>
        </div>
      </div>

      <label class="market-toggle">
        <input type="checkbox" id="market-on">
        <span><b>Or put it on the board</b> — don't name anyone, and whoever wants
        it takes the other side.</span>
      </label>
      <div class="ef-row market-slots" hidden>
        <label class="field" style="flex:1 1 170px">How many takers
          <select name="open_slots">
            <% for (let i = 1; i <= 5; i++) { %>
              <option value="<%= i %>"><%= i %> <%= i === 1 ? 'person' : 'people' %></option>
            <% } %>
          </select>
        </label>
      </div>

      <%# The slip, read back. If this doesn't say what you meant, don't send it. %>
      <p class="cond-preview" id="slip"></p>

      <div class="ef-row" style="justify-content:flex-end">
        <div class="fit"><button class="btn gold" type="submit">Send it</button></div>
      </div>
      <p class="muted" style="margin:.2rem 0 0; font-size:.76rem">
        Sending counts as your yes. It isn't a bet until they agree.
      </p>
    </form>
  </div>
</details>

<template id="rule-tpl">
  <div class="rule-row">
    <span class="rule-then">then</span>
    <select name="pool_rules" aria-label="Rule">
      <% for (const [k, v] of Object.entries(BL.POOL_RULES)) { %>
        <option value="<%= k %>"><%= v.label %></option>
      <% } %>
    </select>
    <button type="button" class="btn small ghost rule-del" title="Remove">✕</button>
  </div>
</template>

<script>
/* The slip. Progressive enhancement: with this blocked you get the pool ticket
   as a plain form, which still makes a perfectly good bet. */
(function () {
  var form = document.getElementById('bet-form');
  if (!form) return;
  var ruleRows = document.getElementById('rule-rows');
  var ruleTpl = document.getElementById('rule-tpl');
  var slip = document.getElementById('slip');
  var pickCount = document.getElementById('pick-count');
  var WEEK = <%= thisWeek %>;
  var ME = '<%= owner.name.replace(/'/g, "\\'") %>';

  /* Each ticket says which hidden fields it needs. The server has one parser;
     these presets are just four ways of filling in the same form. */
  var TICKETS = {
    pool:    { format: 'pool', kind: '', fields: {} },
    matchup: { format: 'prop', kind: 'matchup',
               fields: { test: 'outscores', when: 'week', week: WEEK } },
    finish:  { format: 'prop', kind: '',
               fields: { test: 'outscores', when: 'season' } },
    custom:  { format: 'prop', kind: '', fields: {} },
  };

  function ticket() { return form.querySelector('[name=ticket]:checked').value; }
  function set(id, value, on) {
    var el = document.getElementById(id);
    el.value = value == null ? '' : value;
    el.disabled = !on;               // disabled fields are not submitted
  }

  function firstNamed() {
    var c = form.querySelector('[name=party]:checked');
    return c ? c.closest('.sb-person').textContent.trim() : null;
  }

  function syncTicket() {
    var t = ticket(), cfg = TICKETS[t];
    document.getElementById('f-format').value = cfg.format;
    document.getElementById('f-kind').value = cfg.kind;
    var f = cfg.fields;
    set('f-test', f.test, !!f.test);
    set('f-subject', <%= owner.id %>, !!f.test);
    set('f-when', f.when, !!f.when);
    set('f-week', f.week, f.when === 'week');
    // Head-to-head tickets need an opponent; it is whoever you send it to.
    var opp = form.querySelector('[name=party]:checked');
    set('f-target', opp ? opp.value : '', !!f.test && !!opp);

    form.querySelectorAll('.tk').forEach(function (el) {
      el.hidden = !el.classList.contains('tk-' + t);
    });
    refresh();
  }

  /* ── The pool's rule chain ─────────────────────────────────────────────── */
  function addRule(value) {
    ruleRows.appendChild(ruleTpl.content.cloneNode(true));
    var row = ruleRows.lastElementChild;
    if (value) row.querySelector('select').value = value;
    refresh();
  }
  function ruleLabels() {
    return [].map.call(ruleRows.querySelectorAll('.rule-row select'), function (s) {
      return s.options[s.selectedIndex].text;
    });
  }

  /* ── The slip, in English ──────────────────────────────────────────────── */
  function refresh() {
    var rows = ruleRows.querySelectorAll('.rule-row');
    rows.forEach(function (row, i) {
      row.querySelector('.rule-then').textContent = i === 0 ? '' : 'then';
      row.querySelector('.rule-del').style.visibility = rows.length > 1 ? '' : 'hidden';
    });

    var n = parseInt(form.querySelector('[name=picks_required]').value, 10) || 0;
    var picked = form.querySelectorAll('#pool-picks input:checked').length;
    pickCount.textContent = n ? '(' + picked + ' of ' + n + ' picked)' : '';
    pickCount.className = picked === n && n ? 'ok-count' : 'muted';

    var t = ticket();
    var who = firstNamed();
    var vs = who || 'whoever takes it';
    var text = '';
    if (t === 'pool') {
      var l = ruleLabels();
      text = 'We each pick ' + (n || '?') + ' teams. Decided by ' + l[0]
           + l.slice(1).map(function (x) { return '; if that ties, ' + x; }).join('') + '.';
    } else if (t === 'matchup') {
      text = ME + "'s team outscores " + vs + ' in week ' + WEEK + '.';
    } else if (t === 'finish') {
      text = ME + ' finishes above ' + vs + ' on points over the whole season.';
    } else {
      var typed = (form.querySelector('[name=terms]') || {}).value || '';
      text = typed.trim() || 'Write the bet above and it will show here.';
    }
    var stake = form.querySelector('[name=stake]').value;
    slip.textContent = text + (stake ? '  ·  $' + stake + ' each.' : '');
  }

  document.getElementById('rule-add').addEventListener('click', function () { addRule(); });
  ruleRows.addEventListener('change', refresh);
  ruleRows.addEventListener('click', function (e) {
    if (!e.target.closest('.rule-del')) return;
    if (ruleRows.querySelectorAll('.rule-row').length < 2) return;
    e.target.closest('.rule-row').remove();
    refresh();
  });
  form.querySelectorAll('[name=ticket]').forEach(function (r) {
    r.addEventListener('change', syncTicket);
  });
  form.addEventListener('input', refresh);
  form.addEventListener('change', function (e) {
    // Picking who you're betting also picks the opponent on a head-to-head.
    if (e.target.name === 'party') syncTicket();
  });

  /* Naming people and posting openly are alternatives, not both. */
  var market = document.getElementById('market-on');
  var slots = form.querySelector('.market-slots');
  var people = form.querySelectorAll('[name=party]');
  market.addEventListener('change', function () {
    slots.hidden = !market.checked;
    slots.querySelector('select').disabled = !market.checked;
    people.forEach(function (c) {
      c.disabled = market.checked;
      if (market.checked) c.checked = false;
      c.closest('.sb-person').classList.toggle('is-off', market.checked);
    });
    syncTicket();
  });
  slots.querySelector('select').disabled = true;

  addRule('champion');
  addRule('best_finish');
  syncTicket();
})();
</script>
