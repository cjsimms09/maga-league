<div class="grid cols-3" style="margin-bottom:1.5rem">
  <% list.forEach((o, idx) => { const c = champs[o.id] || []; const tb = bowls[o.id] || []; const rec = (typeof records !== 'undefined' && records[o.id]) || { wins: o.wins, losses: o.losses, ties: o.ties }; const gp = rec.wins + rec.losses + rec.ties; %>
  <div class="card owner-card">
    <div class="seal"><%= o.name[0] %></div>
    <h3><%= o.name %></h3>
    <% if (typeof teams !== 'undefined' && teams[o.id]) { %><div class="muted" style="font-style:italic">🏈 <%= teams[o.id] %></div><% } %>
    <div class="muted" style="min-height:1.1rem"><%= idx === 0 ? '👑 Top Earner' : '' %><%= o.is_commissioner ? (idx === 0 ? ' • ' : '') + '⭐ Commissioner' : '' %></div>
    <div class="trophies" title="League championships<%= (champs[o.id] || []).some(ch => ch.co) ? ' — 2022 was a split title after Bills–Bengals was cancelled' : '' %>">
      <% c.forEach(ch => { %>🏆<% }) %>
      <% if (c.length) { %><span class="muted" style="font-size:.75rem"> <%= c.map(ch => ch.year + (ch.co ? '*' : '')).join(', ') %></span><% } %>
      <% if (tb.length) { %><span title="Toilet Bowls (last place)"> <% tb.forEach(() => { %>🚽<% }) %><span class="muted" style="font-size:.75rem"> <%= tb.join(', ') %></span></span><% } %>
    </div>
    <div class="stat-row">
      <div class="stat"><b><%= rec.wins %>-<%= rec.losses %><%= rec.ties ? '-' + rec.ties : '' %></b><span>Record<%= rec.auto ? ' ⚡' : '' %></span></div>
      <div class="stat"><b><%= gp ? Math.round(((rec.wins + rec.ties * 0.5) / gp) * 1000) / 10 : 0 %>%</b><span>Win %</span></div>
      <div class="stat"><b><%= c.length %></b><span>Titles</span></div>
    </div>
    <div class="money-line">💰 <%= money(totals[o.id]) %> career</div>
  </div>
  <% }) %>
</div>
<p class="muted" style="text-align:center; line-height:1.7">
  ⚡ = record updates itself from Sleeper
</p>
<div class="asterisk-note">
  <b>* The 2022 asterisk.</b> Bills–Bengals was cancelled, so rather than play it out
  they <b>split the trophy and the pot</b>. Marian and Sam are both listed as champions
  for 2022 and neither of them actually won it. The asterisk stays. Forever.
</div>
