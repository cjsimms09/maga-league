<%- include('partials/header', { title: 'Draft Spot Selection' }) %>
<% const myTurn = draft.current && draft.current.owner_id === owner.id && season.draft_open; %>
<% if (season.draft_open && !draft.complete && !myTurn) { %>
  <script>setTimeout(() => location.reload(), 30000);</script>
<% } %>

<h1 class="page-title"><%= season.year %> Draft Order</h1>
<p class="page-sub">Everyone claims their <b>draft position</b> here, one at a time, in reverse order of last season's standings — then the actual draft happens on Sleeper. No timer. Just don't hold up the league.</p>

<% if (error) { %><div class="error-note" style="max-width:640px;margin:0 auto 1rem"><%= error %></div><% } %>

<% if (!draft.picks.length) { %>
  <div class="turn-banner">🚧 The commissioner hasn't opened the <%= season.year %> draft order selection yet.</div>
<% } else if (draft.complete) { %>
  <div class="turn-banner">✅ <b>The <%= season.year %> draft order is set.</b> See the board below.</div>
<% } else if (!season.draft_open) { %>
  <div class="turn-banner">⏸ Draft spot selection is currently <b>closed</b>. The commissioner will open it when it's time to pick.</div>
<% } else if (myTurn) { %>
  <div class="turn-banner you">
    <div class="big">🎯 Your turn, <%= owner.name %>!</div>
    Pick any open spot below — check the cheat sheet first if you're keeping players.
  </div>
<% } else { %>
  <div class="turn-banner">
    Waiting on <b><%= draft.current.name %></b> to choose (turn <%= draft.current.pos %> of <%= draft.picks.length %>).
    This page refreshes on its own.
  </div>
<% } %>

<%
  const N = draft.picks.length || (season.teams || 10);
  // Snake order. Keeper #k costs round k, so with k keepers your first live
  // selection is round k+1. In an odd round the slot picks in order; in an even
  // round it reverses — which is the whole reason a late spot can pick EARLIER
  // than spot #1 once you are keeping players.
  const posInRound = (slot, r) => (r % 2 === 1 ? slot : (N + 1 - slot));
  const overall = (slot, r) => (r - 1) * N + posInRound(slot, r);
  const firstPick = (slot, k) => overall(slot, k + 1);
  const pickList = (slot, k, howMany) => {
    const out = [];
    for (let i = 0; i < howMany; i++) out.push(overall(slot, k + 1 + i));
    return out;
  };
  const ordinal = n => n + (['st','nd','rd'][((n % 100 - 20) % 10) - 1] || ['st','nd','rd'][n - 1] || 'th');
  const takenSlots = new Set(draft.picks.filter(p => p.slot != null).map(p => p.slot));
  const openSlots = [];
  for (let i = 1; i <= N; i++) if (!takenSlots.has(i)) openSlots.push(i);
  // The spot that gets you on the board soonest for each keeper count.
  const bestFor = k => openSlots.slice().sort((a, b) => firstPick(a, k) - firstPick(b, k))[0];
  const myKeepCount = myKeepers.length;
%>

<div class="grid cols-2">
  <%# ONCE THE ORDER IS SET THERE IS NOTHING TO CHOOSE. This card was gated on
      draft.picks.length alone, so after the last owner claimed a spot it kept
      asking "Which Spot Should You Take?", kept explaining the trade-off, and
      kept closing with "Tap one to jump to that spot on the board" — with every
      button gone, because bestFor() correctly returns nothing when no slot is
      open. A question with no answers, sitting under a banner that already says
      the order is set, permanently. It answers the question a reader has at
      that point instead: where they are picking, and from which round. Same
      firstPick() the board uses, so it cannot disagree with it. %>
  <% const mySlot = ((draft.picks.find(p => p.owner_id === owner.id)) || {}).slot; %>
  <% if (draft.picks.length && !openSlots.length && mySlot) { %>
  <div class="card col-span-2">
    <h2>🧭 Where You're Picking <span class="sub">the order is set — <%= myKeepCount %> keeper<%= myKeepCount === 1 ? '' : 's' %> on your card</span></h2>
    <div class="body">
      <p style="margin:.1rem 0 0">You have <b>Spot #<%= mySlot %></b>. Keeping <b><%= myKeepCount %></b>
        costs you <%= myKeepCount === 0 ? 'no rounds' : (myKeepCount === 1 ? 'round 1' : 'rounds 1–' + myKeepCount) %>,
        so your first live selection is <b>#<%= firstPick(mySlot, myKeepCount) %></b> overall —
        <%= ordinal(posInRound(mySlot, myKeepCount + 1)) %> of Round <%= myKeepCount + 1 %>.</p>
      <p class="muted" style="margin:.6rem 0 0; font-size:.78rem">
        Keeping one more would move it to <b>#<%= firstPick(mySlot, myKeepCount + 1) %></b><% if (myKeepCount > 0) { %>;
        one fewer, to <b>#<%= firstPick(mySlot, myKeepCount - 1) %></b><% } %>. The board below is the full order.
      </p>
    </div>
  </div>
  <% } else if (draft.picks.length && openSlots.length) { %>
  <div class="card col-span-2">
    <h2>🧭 Which Spot Should You Take? <span class="sub">it depends entirely on how many you keep</span></h2>
    <div class="body">
      <p style="margin:.1rem 0 .8rem">
        Every keeper costs you that round's pick. Keep 2 and your first real selection is
        <b>Round 3</b> — and because the draft snakes, <b>a late spot can pick earlier than
        spot #1</b>. That is the whole decision.
      </p>
      <div class="keeper-shortcuts">
        <% for (let k = 0; k <= 3; k++) { const b = bestFor(k); %>
          <% if (b) { %>
          <button class="shortcut <%= k === myKeepCount ? 'mine' : '' %>" type="button"
                  data-spot="<%= b %>" data-keep="<%= k %>">
            <span class="sc-k">Keep <%= k %><%= k === myKeepCount ? ' (you)' : '' %></span>
            <span class="sc-spot">Spot #<%= b %></span>
            <span class="sc-pick">first pick #<%= firstPick(b, k) %> · <%= ordinal(posInRound(b, k + 1)) %> of Rd <%= k + 1 %></span>
          </button>
          <% } %>
        <% } %>
      </div>
      <p class="muted" style="margin:.7rem 0 0; font-size:.78rem">
        These are the <b>earliest</b> first pick available right now for each keeper count.
        Tap one to jump to that spot on the board.
      </p>
    </div>
  </div>

  <div class="card">
    <h2>Draft Board <span class="sub">spots 1–<%= draft.picks.length %></span></h2>
    <div class="body">
      <div class="draft-board">
        <% for (let s = 1; s <= draft.picks.length; s++) { const taken = draft.picks.find(p => p.slot === s); %>
          <div class="slot <%= taken ? 'taken' : 'open-slot' %>">
            <div class="n">Spot #<%= s %></div>
            <div class="who"><%= taken ? taken.name : '—' %></div>
            <% if (!taken) { %>
              <div class="slot-hint">
                <% for (let k = 0; k <= 3; k++) { %>
                  <span class="<%= k === myKeepCount ? 'mine' : '' %>">K<%= k %>: #<%= firstPick(s, k) %></span>
                <% } %>
              </div>
            <% } %>
            <% if (!taken && myTurn) { %>
              <form method="post" action="/draft/pick" class="claim-form" data-slot="<%= s %>">
                <input type="hidden" name="slot" value="<%= s %>">
                <button class="btn small gold" type="submit">Claim it</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Pick Order <span class="sub">worst record chooses first</span></h2>
    <div class="body tight">
      <ol class="order-list">
        <% for (const p of draft.picks) { %>
          <li class="<%= draft.current && p.pos === draft.current.pos ? 'current' : (p.slot != null ? 'done' : '') %>">
            <span class="pos"><%= p.pos %></span>
            <span style="flex:1"><b><%= p.name %></b><%= p.owner_id === owner.id ? ' (you)' : '' %></span>
            <% if (p.slot != null) { %><span class="badge navy">Took spot #<%= p.slot %></span>
            <% } else if (draft.current && p.pos === draft.current.pos) { %><span class="badge gold">Choosing now</span>
            <% } else { %><span class="muted">waiting…</span><% } %>
          </li>
        <% } %>
      </ol>
    </div>
  </div>
  <% } %>

  <% if (draft.picks.length && !draft.complete) {
       const N = draft.picks.length;
       // First live pick (overall #) if you take `slot` and keep k players, in a snake draft:
       // keepers cost rounds 1..k, so your first selection is round k+1.
       const firstPick = (slot, k) => { const r = k + 1; return (r - 1) * N + (r % 2 === 1 ? slot : (N + 1 - slot)); };
       const myKeepCount = myKeepers.length;
  %>
  <div class="card col-span-2">
    <h2>Spot Cheat Sheet <span class="sub">your first real pick (overall #), by spot and keepers kept — snake draft</span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr>
          <th>Draft Spot</th>
          <% for (let k = 0; k <= 3; k++) { %><th class="num" <%= k === myKeepCount ? 'style="color:var(--gold-bright)"' : '' %>>Keep <%= k %><%= k === myKeepCount ? ' (you)' : '' %></th><% } %>
        </tr>
        <% for (let sN = 1; sN <= N; sN++) { const taken = draft.picks.find(p => p.slot === sN); %>
          <tr class="<%= taken ? 'muted-row' : '' %>">
            <td><b>Spot #<%= sN %></b> <%= taken ? '— ' + taken.name : '' %></td>
            <% for (let k = 0; k <= 3; k++) { %>
              <td class="num" <%= k === myKeepCount && !taken ? 'style="color:var(--gold-bright);font-weight:800"' : '' %>>Pick <%= firstPick(sN, k) %></td>
            <% } %>
          </tr>
        <% } %>
      </table>
      <p class="muted" style="padding:.6rem 1rem">
        Each keeper costs that round's pick (keep 2 = your first live pick is Round 3). Snake order assumed —
        notice that with 2–3 keepers a <b>late</b> spot can pick <b>earlier</b> than spot #1. Choose wisely.
      </p>
    </div>
  </div>
  <% } %>

  <div class="card">
    <h2>My Keepers <span class="sub">up to 3 — each costs that draft round</span></h2>
    <div class="body">
      <% if (season.keepers_locked) { %>
        <p class="muted">🔒 Keepers are locked for <%= season.year %>.</p>
        <% if (myKeepers.length) { %>
          <table class="roll">
            <% for (const k of myKeepers) { %><tr><td><b><%= k.player_name %></b></td><td class="num">costs Round <%= k.round %></td></tr><% } %>
          </table>
        <% } else { %><p class="muted">You declared no keepers.</p><% } %>
      <% } else { %>
        <form method="post" action="/draft/keepers">
          <% for (let i = 1; i <= 3; i++) { const k = myKeepers[i - 1]; %>
            <label class="field">Keeper <%= i %> <span style="color:var(--red)">(forfeits your Round <%= i %> pick)</span></label>
            <input type="text" name="k<%= i %>" value="<%= k ? k.player_name : '' %>" placeholder="Leave blank to keep your Round <%= i %> pick">
          <% } %>
          <div style="margin-top:.9rem">
            <button class="btn navy" type="submit">Save My Keepers</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Declared Keepers <span class="sub">league-wide</span></h2>
    <div class="body tight scroll-x">
      <% if (!allKeepers.length) { %>
        <p class="muted" style="padding:1rem">No keepers declared yet.</p>
      <% } else { %>
        <table class="roll">
          <tr><th>Owner</th><th>Player</th><th class="num">Costs Round</th></tr>
          <% for (const k of allKeepers) { %>
            <tr><td><b><%= k.name %></b></td><td><%= k.player_name %></td><td class="num"><%= k.round %></td></tr>
          <% } %>
        </table>
      <% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.2rem">
  <h2>How It Works</h2>
  <div class="body">
    <ol style="margin:.2rem 0; padding-left:1.3rem">
      <li>Draft-spot selection goes in <b>reverse order of last season's standings</b> — last place chooses first, then 9th, and so on. The champ chooses last. That's the price of greatness.</li>
      <li>When it's your turn, claim any open spot on the board. No timer — take a breath, check the cheat sheet. Picks are final (only the commissioner can undo one). The commissioner then sets that order in Sleeper, where the actual player draft happens.</li>
      <li>We're a <b>3-keeper league</b>: keep up to 3 players from last year. Keeper #1 costs your Round 1 pick, keeper #2 your Round 2 pick, keeper #3 your Round 3 pick. Keep nobody and you draft from Round 1 like a free man.</li>
    </ol>
  </div>
</div>

<%# ── Confirmation. Claiming a spot is final, and the consequence is not
     obvious from a number on a tile — so it gets stated in full first. ── %>
<dialog id="claim-dialog" class="claim-dialog">
  <h3>Take Spot #<span id="cd-slot"></span>?</h3>
  <p class="cd-lede">Here is exactly what that means, depending on how many players you keep.</p>
  <table class="roll" id="cd-table">
    <thead><tr><th>If you keep</th><th>First pick</th><th>Where that lands</th><th>Then</th></tr></thead>
    <tbody></tbody>
  </table>
  <p class="cd-warn">This is <b>final</b> — only the commissioner can undo it.</p>
  <div class="cd-actions">
    <button class="btn navy" id="cd-cancel" type="button">Back</button>
    <button class="btn gold" id="cd-confirm" type="button">Yes, take Spot #<span id="cd-slot2"></span></button>
  </div>
</dialog>

<script>
(function () {
  var N = <%= N %>, myKeep = <%= myKeepCount %>;
  var posInRound = function (slot, r) { return r % 2 === 1 ? slot : (N + 1 - slot); };
  var overall = function (slot, r) { return (r - 1) * N + posInRound(slot, r); };
  var ord = function (n) {
    var s = ['th', 'st', 'nd', 'rd'], v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  };

  var dlg = document.getElementById('claim-dialog');
  if (!dlg) return;
  var pending = null;

  document.querySelectorAll('.claim-form').forEach(function (form) {
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      pending = form;
      var slot = Number(form.getAttribute('data-slot'));
      document.getElementById('cd-slot').textContent = slot;
      document.getElementById('cd-slot2').textContent = slot;

      var rows = '';
      for (var k = 0; k <= 3; k++) {
        var r = k + 1;
        var first = overall(slot, r);
        var p = posInRound(slot, r);
        var nexts = [overall(slot, r + 1), overall(slot, r + 2)].join(', ');
        var flag = (k === myKeep) ? ' class="cd-mine"' : '';
        var where = ord(p) + ' pick of Round ' + r;
        if (p === 1) where += ' \u2014 you are on the clock first';
        if (p === N) where += ' \u2014 last, but you pick again immediately';
        rows += '<tr' + flag + '><td><b>' + k + ' keeper' + (k === 1 ? '' : 's') + '</b>'
             + (k === myKeep ? ' <span class="muted">(what you declared)</span>' : '') + '</td>'
             + '<td><b>#' + first + '</b></td><td>' + where + '</td>'
             + '<td class="muted">then #' + nexts + '</td></tr>';
      }
      dlg.querySelector('tbody').innerHTML = rows;
      if (typeof dlg.showModal === 'function') dlg.showModal();
      else if (confirm('Take spot #' + slot + '?')) form.submit();
    });
  });

  document.getElementById('cd-cancel').addEventListener('click', function () { dlg.close(); pending = null; });
  document.getElementById('cd-confirm').addEventListener('click', function () {
    if (pending) { dlg.close(); pending.removeAttribute('data-slot'); pending.submit(); }
  });

  // Shortcut chips scroll to the spot and flash it, so "best if I keep 2" and
  // the tile you are about to tap are visibly the same thing.
  document.querySelectorAll('.shortcut').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var spot = Number(btn.getAttribute('data-spot'));
      var tiles = document.querySelectorAll('.draft-board .slot');
      var tile = tiles[spot - 1];
      if (!tile) return;
      tile.scrollIntoView({ block: 'center', behavior: 'smooth' });
      tile.classList.add('flash');
      setTimeout(function () { tile.classList.remove('flash'); }, 1800);
    });
  });
})();
</script>

<%- include('partials/footer') %>
