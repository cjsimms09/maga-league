<%- include('partials/header', { title: 'Draft Spot Selection' }) %>
<% const myTurn = draft.current && draft.current.owner_id === owner.id && season.draft_open; %>
<% if (season.draft_open && !draft.complete && !myTurn) { %>
  <script>setTimeout(() => location.reload(), 30000);</script>
<% } %>

<h1 class="page-title"><%= season.year %> Draft Order</h1>
<p class="page-sub">Everyone claims their <b>draft position</b> here, one at a time, in reverse order of last season's standings — then the actual draft happens on Sleeper. No timer. Just don't hold up the league.</p>

<% if (error) { %><div class="error-note" style="max-width:640px;margin:0 auto 1rem"><%= error %></div><% } %>

<% if (!draft.picks.length) { %>
  <div class="turn-banner">🚧 The commissioner hasn't opened the <%= season.year %> draft order selection yet.</div>
<% } else if (draft.complete) { %>
  <div class="turn-banner">✅ <b>The <%= season.year %> draft order is set.</b> See the board below.</div>
<% } else if (!season.draft_open) { %>
  <div class="turn-banner">⏸ Draft spot selection is currently <b>closed</b>. The commissioner will open it when it's time to pick.</div>
<% } else if (myTurn) { %>
  <div class="turn-banner you">
    <div class="big">🎯 Your turn, <%= owner.name %>!</div>
    Pick any open spot below — check the cheat sheet first if you're keeping players.
  </div>
<% } else { %>
  <div class="turn-banner">
    Waiting on <b><%= draft.current.name %></b> to choose (turn <%= draft.current.pos %> of <%= draft.picks.length %>).
    This page refreshes on its own.
  </div>
<% } %>

<div class="grid cols-2">
  <% if (draft.picks.length) { %>
  <div class="card">
    <h2>Draft Board <span class="sub">spots 1–<%= draft.picks.length %></span></h2>
    <div class="body">
      <div class="draft-board">
        <% for (let s = 1; s <= draft.picks.length; s++) { const taken = draft.picks.find(p => p.slot === s); %>
          <div class="slot <%= taken ? 'taken' : 'open-slot' %>">
            <div class="n">Spot #<%= s %></div>
            <div class="who"><%= taken ? taken.name : '—' %></div>
            <% if (!taken && myTurn) { %>
              <form method="post" action="/draft/pick">
                <input type="hidden" name="slot" value="<%= s %>">
                <button class="btn small gold" type="submit">Claim it</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Pick Order <span class="sub">worst record chooses first</span></h2>
    <div class="body tight">
      <ol class="order-list">
        <% for (const p of draft.picks) { %>
          <li class="<%= draft.current && p.pos === draft.current.pos ? 'current' : (p.slot != null ? 'done' : '') %>">
            <span class="pos"><%= p.pos %></span>
            <span style="flex:1"><b><%= p.name %></b><%= p.owner_id === owner.id ? ' (you)' : '' %></span>
            <% if (p.slot != null) { %><span class="badge navy">Took spot #<%= p.slot %></span>
            <% } else if (draft.current && p.pos === draft.current.pos) { %><span class="badge gold">Choosing now</span>
            <% } else { %><span class="muted">waiting…</span><% } %>
          </li>
        <% } %>
      </ol>
    </div>
  </div>
  <% } %>

  <% if (draft.picks.length && !draft.complete) {
       const N = draft.picks.length;
       // First live pick (overall #) if you take `slot` and keep k players, in a snake draft:
       // keepers cost rounds 1..k, so your first selection is round k+1.
       const firstPick = (slot, k) => { const r = k + 1; return (r - 1) * N + (r % 2 === 1 ? slot : (N + 1 - slot)); };
       const myKeepCount = myKeepers.length;
  %>
  <div class="card col-span-2">
    <h2>Spot Cheat Sheet <span class="sub">your first real pick (overall #), by spot and keepers kept — snake draft</span></h2>
    <div class="body tight scroll-x">
      <table class="roll">
        <tr>
          <th>Draft Spot</th>
          <% for (let k = 0; k <= 3; k++) { %><th class="num" <%= k === myKeepCount ? 'style="color:var(--gold-bright)"' : '' %>>Keep <%= k %><%= k === myKeepCount ? ' (you)' : '' %></th><% } %>
        </tr>
        <% for (let sN = 1; sN <= N; sN++) { const taken = draft.picks.find(p => p.slot === sN); %>
          <tr class="<%= taken ? 'muted-row' : '' %>">
            <td><b>Spot #<%= sN %></b> <%= taken ? '— ' + taken.name : '' %></td>
            <% for (let k = 0; k <= 3; k++) { %>
              <td class="num" <%= k === myKeepCount && !taken ? 'style="color:var(--gold-bright);font-weight:800"' : '' %>>Pick <%= firstPick(sN, k) %></td>
            <% } %>
          </tr>
        <% } %>
      </table>
      <p class="muted" style="padding:.6rem 1rem">
        Each keeper costs that round's pick (keep 2 = your first live pick is Round 3). Snake order assumed —
        notice that with 2–3 keepers a <b>late</b> spot can pick <b>earlier</b> than spot #1. Choose wisely.
      </p>
    </div>
  </div>
  <% } %>

  <div class="card">
    <h2>My Keepers <span class="sub">up to 3 — each costs that draft round</span></h2>
    <div class="body">
      <% if (season.keepers_locked) { %>
        <p class="muted">🔒 Keepers are locked for <%= season.year %>.</p>
        <% if (myKeepers.length) { %>
          <table class="roll">
            <% for (const k of myKeepers) { %><tr><td><b><%= k.player_name %></b></td><td class="num">costs Round <%= k.round %></td></tr><% } %>
          </table>
        <% } else { %><p class="muted">You declared no keepers.</p><% } %>
      <% } else { %>
        <form method="post" action="/draft/keepers">
          <% for (let i = 1; i <= 3; i++) { const k = myKeepers[i - 1]; %>
            <label class="field">Keeper <%= i %> <span style="color:var(--red)">(forfeits your Round <%= i %> pick)</span></label>
            <input type="text" name="k<%= i %>" value="<%= k ? k.player_name : '' %>" placeholder="Leave blank to keep your Round <%= i %> pick">
          <% } %>
          <div style="margin-top:.9rem">
            <button class="btn navy" type="submit">Save My Keepers</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Declared Keepers <span class="sub">league-wide</span></h2>
    <div class="body tight scroll-x">
      <% if (!allKeepers.length) { %>
        <p class="muted" style="padding:1rem">No keepers declared yet.</p>
      <% } else { %>
        <table class="roll">
          <tr><th>Owner</th><th>Player</th><th class="num">Costs Round</th></tr>
          <% for (const k of allKeepers) { %>
            <tr><td><b><%= k.name %></b></td><td><%= k.player_name %></td><td class="num"><%= k.round %></td></tr>
          <% } %>
        </table>
      <% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.2rem">
  <h2>How It Works</h2>
  <div class="body">
    <ol style="margin:.2rem 0; padding-left:1.3rem">
      <li>Draft-spot selection goes in <b>reverse order of last season's standings</b> — last place chooses first, then 9th, and so on. The champ chooses last. That's the price of greatness.</li>
      <li>When it's your turn, claim any open spot on the board. No timer — take a breath, check the cheat sheet. Picks are final (only the commissioner can undo one). The commissioner then sets that order in Sleeper, where the actual player draft happens.</li>
      <li>We're a <b>3-keeper league</b>: keep up to 3 players from last year. Keeper #1 costs your Round 1 pick, keeper #2 your Round 2 pick, keeper #3 your Round 3 pick. Keep nobody and you draft from Round 1 like a free man.</li>
    </ol>
  </div>
</div>

<%- include('partials/footer') %>
