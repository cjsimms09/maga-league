<%- include('partials/header', { title: 'League History' }) %>
<%
  // Owners, Record Book and History were three separate tabs reading from the
  // same three helpers — winningsGrid, careerTotals, accolades — and rendering
  // three views of one question: who has won what, all time. Together they were
  // ~9,900px across three places in the nav. Tabbed, one section is on screen
  // at a time and the nav is one item shorter.
  const tab = (typeof section !== 'undefined' && section) || 'money';
  const TABS = [
    ['money',   '💵 The Money',    'every dollar, every year'],
    ['owners',  '👥 The Owners',   'career totals and trophies'],
    ['records', '📖 Record Book',  'all-time highs and lows'],
  ];
%>

<h1 class="page-title">🏛 League History</h1>
<p class="page-sub">Every dollar, every champion, every humiliation since 2016.</p>

<nav class="section-tabs">
  <% for (const [key, label, hint] of TABS) { %>
    <a href="/history?section=<%= key %>" class="<%= tab === key ? 'active' : '' %>">
      <b><%= label %></b><span><%= hint %></span>
    </a>
  <% } %>
</nav>

<% if (tab === 'owners') { %>
  <%- include('partials/_hist_owners') %>
<% } else if (tab === 'records') { %>
  <%- include('partials/_hist_records') %>
<% } else { %>
  <%- include('partials/_hist_money') %>
<% } %>

<%- include('partials/footer') %>
