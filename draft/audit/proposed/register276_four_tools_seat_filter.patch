 const q=(a,f)=>{const t=a.slice().sort((x,y)=>x-y);const i=(t.length-1)*f;const lo=Math.floor(i),hi=Math.ceil(i);return lo===hi?t[lo]:t[lo]+(t[hi]-t[lo])*(i-lo);};
